#!/usr/bin/env bash
# Description: Audit pol-server hardware and start model-pinned SMART long tests.
set -euo pipefail

mode=--report
disk_alias=
battery_root="${POL_SERVER_BATTERY_ROOT:-/sys/class/power_supply}"

error() { printf '\033[31m[ERROR]\033[0m %s\n' "$*" >&2; }

usage() {
    cat <<'EOF'
Usage: hardware-qualification [--report | --report-disk DISK | --start-smart-long DISK | --thermal-load]

    --report                   Print the internal hardware qualification report.
    --report-disk DISK         Print a redacted report for a model-pinned disk.
    --start-smart-long DISK    Start a long test on a model-pinned disk.
    --thermal-load             Run the fixed two-minute moderate CPU load test.
EOF
}

parse_args() {
    case "${1:---report}" in
        --report)
            [ "$#" -eq 1 ] || return 2
            mode=--report
            ;;
        --report-disk)
            [ "$#" -eq 2 ] || return 2
            mode=--report-disk
            disk_alias="$2"
            ;;
        --start-smart-long)
            [ "$#" -eq 2 ] || return 2
            mode=--start-smart-long
            disk_alias="$2"
            ;;
        --thermal-load)
            [ "$#" -eq 1 ] || return 2
            mode=--thermal-load
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *) return 2 ;;
    esac
}

require_privileges() {
    if [ "${POL_SERVER_ALLOW_UNPRIVILEGED:-false}" != true ] && (( EUID != 0 )); then
        error 'Run through the tracked root-owned launcher.'
        return 1
    fi
}

disk_spec() {
    case "$1" in
        kingston) printf '%s\t%s\t%s\n' 'KINGSTON SA400S37960G' 900000000000 1000000000000 ;;
        micron) printf '%s\t%s\t%s\n' 'Micron_1100_MTFDDAV256TBN' 240000000000 270000000000 ;;
        wd-backup) printf '%s\t%s\t%s\n' 'WDC WD15SMRW-11YNDS0' 1400000000000 1600000000000 ;;
        *)
            error "Unknown disk alias: $1"
            return 2
            ;;
    esac
}

resolve_disk() {
    local alias="$1"
    local expected_model minimum_size maximum_size path model size match=
    IFS=$'\t' read -r expected_model minimum_size maximum_size < <(disk_spec "$alias")

    while read -r path model; do
        if [ "$model" = "$expected_model" ]; then
            if [ -n "$match" ]; then
                error "More than one disk matches model: $expected_model"
                return 1
            fi
            match="$path"
        fi
    done < <(lsblk -dn -o PATH,MODEL)

    if [ -z "$match" ]; then
        error "Expected disk model not found: $expected_model"
        return 1
    fi

    size="$(blockdev --getsize64 "$match")"
    if (( size < minimum_size || size > maximum_size )); then
        error "Unexpected capacity for $expected_model: $size bytes"
        return 1
    fi

    printf '%s\n' "$match"
}

smartctl_for_disk() {
    local alias="$1"
    local device="$2"
    shift 2

    if [ "$alias" = wd-backup ]; then
        smartctl -d sat "$@" "$device"
    else
        smartctl "$@" "$device"
    fi
}

redact_smart_output() {
    awk '{ normalized = tolower($0) } normalized !~ /serial number|wwn device|logical unit id/'
}

report_disk() {
    local alias="$1"
    local model device mounts
    IFS=$'\t' read -r model _ < <(disk_spec "$alias")
    device="$(resolve_disk "$alias")"
    mounts="$(lsblk -nr -o MOUNTPOINTS "$device" | sed '/^[[:space:]]*$/d')"

    printf '\n## %s: %s\n' "$model" "$device"
    printf 'Capacity bytes: %s\n' "$(blockdev --getsize64 "$device")"
    if [ -n "$mounts" ]; then
        printf 'Mounts:\n%s\n' "$mounts"
    else
        printf 'Mounts: none\n'
    fi
    smartctl_for_disk "$alias" "$device" -c -H -A -l selftest | redact_smart_output
}

report_battery() {
    local battery file value
    shopt -s nullglob
    for battery in "$battery_root"/BAT*; do
        printf '\n## Battery: %s\n' "$(basename "$battery")"
        for file in manufacturer model_name technology cycle_count energy_full_design energy_full charge_full_design charge_full capacity status; do
            if [ -r "$battery/$file" ]; then
                value="$(< "$battery/$file")"
                printf '%s: %s\n' "$file" "$value"
            fi
        done
    done
}

report_hardware() {
    printf '# pol-server hardware qualification\n'
    printf 'Root filesystem source: %s\n' "$(findmnt -n -o SOURCE /)"
    report_disk kingston
    report_disk micron
    report_battery
    printf '\n## Network addresses\n'
    ip -brief address
    printf '\n## Failed systemd units\n'
    systemctl --failed --no-legend
}

start_smart_long() {
    local alias="$1"
    local device
    device="$(resolve_disk "$alias")"
    printf 'Starting SMART long test for %s at %s\n' "$alias" "$device"
    smartctl_for_disk "$alias" "$device" -t long
}

run_thermal_load() {
    stress-ng --cpu 2 --cpu-load 60 --timeout 2m --metrics-brief --thermalstat 10
}

main() {
    if ! parse_args "$@"; then
        usage >&2
        exit 2
    fi
    require_privileges

    case "$mode" in
        --report) report_hardware ;;
        --report-disk) report_disk "$disk_alias" ;;
        --start-smart-long) start_smart_long "$disk_alias" ;;
        --thermal-load) run_thermal_load ;;
    esac
}

main "$@"