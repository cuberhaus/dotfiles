[Unit]
Description=Update the pol-home-nas DuckDNS address
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
LoadCredential=duckdns-token:/etc/cuberhaus/duckdns-token
ExecStart=/usr/local/lib/cuberhaus/pol-server/wireguard-setup --update-duckdns
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict