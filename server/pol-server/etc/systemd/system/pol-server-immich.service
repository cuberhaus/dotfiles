[Unit]
Description=Run the pinned Immich stack on pol-server
Wants=network-online.target
After=docker.service network-online.target
Requires=docker.service
RequiresMountsFor=/srv/storage
ConditionPathExists=/etc/cuberhaus/immich.env

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/pol-server-immich --start
ExecStop=/usr/local/sbin/pol-server-immich --stop
TimeoutStartSec=10min
TimeoutStopSec=5min
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
