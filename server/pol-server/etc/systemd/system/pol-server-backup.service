[Unit]
Description=Back up pol-server storage to the external WD disk
After=local-fs.target
RequiresMountsFor=/mnt/pol-server-backup
Conflicts=pol-server-backup-check.service
ConditionACPower=true

[Service]
Type=oneshot
StateDirectory=cuberhaus-backup
StateDirectoryMode=0700
LoadCredential=restic-password:/etc/cuberhaus/restic-password
ExecStart=/usr/local/lib/cuberhaus/pol-server/backup-setup --backup
StandardOutput=journal
StandardError=journal
TimeoutStartSec=12h
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/srv/storage
ReadWritePaths=/srv/storage/immich /mnt/pol-server-backup /var/lib/cuberhaus-backup
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native