[Unit]
Description=Restrict pol-server WireGuard peer traffic
Before=wg-quick@wg0.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/cuberhaus/pol-server/wireguard-setup --apply-firewall
ExecReload=/usr/local/lib/cuberhaus/pol-server/wireguard-setup --apply-firewall
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target