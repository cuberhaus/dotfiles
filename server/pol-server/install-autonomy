#!/usr/bin/env bash
# Description: Enroll the root-owned pol-server bootstrap and narrow sudo rule.
set -euo pipefail

server_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
root_prefix="${POL_SERVER_ROOT:-}"
temporary_full_access=false
maintenance_hours="${POL_SERVER_MAINTENANCE_HOURS:-8}"
install_dir="${root_prefix%/}/usr/local/lib/cuberhaus/pol-server"
launcher_target="${root_prefix%/}/usr/local/sbin/pol-server-bootstrap"
hardware_launcher_target="${root_prefix%/}/usr/local/sbin/pol-server-hardware"
maintenance_launcher_target="${root_prefix%/}/usr/local/sbin/pol-server-maintenance"
github_mirror_launcher_target="${root_prefix%/}/usr/local/sbin/pol-server-github-mirror"
rss_email_launcher_target="${root_prefix%/}/usr/local/sbin/pol-server-rss-email"
sudoers_target="${root_prefix%/}/etc/sudoers.d/pol-server-bootstrap"
maintenance_sudoers_target="${root_prefix%/}/etc/sudoers.d/pol-server-maintenance"
staging_dir="${install_dir}.new.$$"
sudoers_staging="${sudoers_target}.new.$$"
maintenance_sudoers_staging="${maintenance_sudoers_target}.new.$$"

cleanup() {
    rm -rf "$staging_dir"
    rm -f "$sudoers_staging"
    rm -f "$maintenance_sudoers_staging"
}
trap cleanup EXIT

case "${1:-}" in
    '') ;;
    --temporary-full-access) temporary_full_access=true ;;
    *)
        printf 'Usage: install-autonomy [--temporary-full-access]\n' >&2
        exit 2
        ;;
esac

if [ "${POL_SERVER_ALLOW_UNPRIVILEGED:-false}" != true ] && (( EUID != 0 )); then
    printf 'Run install-autonomy as root.\n' >&2
    exit 1
fi

rm -rf "$staging_dir"
install -d -m 0755 "$staging_dir"
install -m 0755 \
    "$server_dir/bootstrap" \
    "$server_dir/apply-power-policy" \
    "$server_dir/github-mirror" \
    "$server_dir/hardware-qualification" \
    "$server_dir/maintenance-access" \
    "$server_dir/rss-email" \
    "$staging_dir/"
install -m 0644 "$server_dir/packages.txt" "$staging_dir/packages.txt"
cp -R "$server_dir/etc" "$server_dir/keys" "$staging_dir/"
find "$staging_dir/etc" "$staging_dir/keys" -type d -exec chmod 0755 {} +
find "$staging_dir/etc" "$staging_dir/keys" -type f -exec chmod 0644 {} +

if [ -z "$root_prefix" ]; then
    chown -R root:root "$staging_dir"
fi

install -d -m 0755 "$(dirname "$install_dir")" "$(dirname "$launcher_target")"
rm -rf "$install_dir"
mv "$staging_dir" "$install_dir"
install -m 0755 "$server_dir/pol-server-bootstrap" "$launcher_target"
install -m 0755 "$server_dir/pol-server-hardware" "$hardware_launcher_target"
install -m 0755 "$server_dir/pol-server-maintenance" "$maintenance_launcher_target"
install -m 0755 "$server_dir/pol-server-github-mirror" "$github_mirror_launcher_target"
install -m 0755 "$server_dir/pol-server-rss-email" "$rss_email_launcher_target"

install -d -m 0755 "$(dirname "$sudoers_target")"
printf '%s\n' \
    'pol ALL=(root) NOPASSWD: /usr/local/sbin/pol-server-bootstrap --apply' \
    'pol ALL=(root) NOPASSWD: /usr/local/sbin/pol-server-bootstrap --check' \
    'pol ALL=(root) NOPASSWD: /usr/local/sbin/pol-server-hardware --report' \
    'pol ALL=(root) NOPASSWD: /usr/local/sbin/pol-server-hardware --report-disk wd-backup' \
    'pol ALL=(root) NOPASSWD: /usr/local/sbin/pol-server-hardware --start-smart-long kingston' \
    'pol ALL=(root) NOPASSWD: /usr/local/sbin/pol-server-hardware --start-smart-long micron' \
    'pol ALL=(root) NOPASSWD: /usr/local/sbin/pol-server-hardware --start-smart-long wd-backup' \
    'pol ALL=(root) NOPASSWD: /usr/local/sbin/pol-server-hardware --thermal-load' \
    'pol ALL=(root) NOPASSWD: /usr/local/sbin/pol-server-maintenance --revoke' \
    'pol ALL=(root) NOPASSWD: /usr/local/sbin/pol-server-github-mirror --configure-token' \
    'pol ALL=(root) NOPASSWD: /usr/local/sbin/pol-server-github-mirror --sync' \
    'pol ALL=(root) NOPASSWD: /usr/local/sbin/pol-server-github-mirror --check' \
    'pol ALL=(root) NOPASSWD: /usr/local/sbin/pol-server-rss-email --configure' \
    'pol ALL=(root) NOPASSWD: /usr/local/sbin/pol-server-rss-email --test-email' \
    'pol ALL=(root) NOPASSWD: /usr/local/sbin/pol-server-rss-email --send-wd-report' \
    'pol ALL=(root) NOPASSWD: /usr/bin/systemctl start pol-server-rss-email.service' \
    > "$sudoers_staging"
chmod 0440 "$sudoers_staging"
visudo -cf "$sudoers_staging"
install -m 0440 "$sudoers_staging" "$sudoers_target"

if [ "$temporary_full_access" = true ]; then
    if ! [[ "$maintenance_hours" =~ ^[0-9]+$ ]] ||
        (( maintenance_hours < 1 || maintenance_hours > 24 )); then
        printf 'POL_SERVER_MAINTENANCE_HOURS must be an integer from 1 through 24.\n' >&2
        exit 2
    fi
    expires_at="$(date -u -d "+$maintenance_hours hours" +%Y%m%d%H%M%SZ)"
    printf 'pol ALL=(ALL:ALL) NOTAFTER=%s NOPASSWD: ALL\n' "$expires_at" \
        > "$maintenance_sudoers_staging"
    chmod 0440 "$maintenance_sudoers_staging"
    visudo -cf "$maintenance_sudoers_staging"
    install -m 0440 "$maintenance_sudoers_staging" "$maintenance_sudoers_target"
    printf 'Temporary full maintenance access expires at %s.\n' "$expires_at"
fi

printf 'Installed root-owned bootstrap at %s\n' "$install_dir"
printf 'Installed narrow sudo rule at %s\n' "$sudoers_target"
if [ -n "$root_prefix" ]; then
    "$install_dir/bootstrap" --apply
else
    "$launcher_target" --apply
fi