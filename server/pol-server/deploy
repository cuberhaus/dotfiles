#!/usr/bin/env bash
# Description: Deploy and run the tracked pol-server bootstrap over SSH.
set -euo pipefail

server_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
remote_host="${POL_SERVER_HOST:-home-nas}"
mode=--check
remote_dir=/tmp/cuberhaus-pol-server-bootstrap

usage() {
    cat <<'EOF'
Usage: deploy [--host HOST] MODE

    --host HOST                    SSH host or alias (default: home-nas).
    --check                        Audit the installed root-owned baseline (default).
    --apply                        Converge the baseline through narrow passwordless sudo.
    --enroll                       Update the root-owned bundle; requires a sudo password.
    --enroll-maintenance           Enroll with eight-hour full maintenance access.
    --revoke-maintenance           Revoke temporary full maintenance access immediately.
    --hardware-report              Print the redacted hardware qualification report.
    --start-smart-long-kingston    Start the Kingston SMART long test.
    --start-smart-long-micron      Start the Micron SMART long test.
EOF
}

while (( $# > 0 )); do
    case "$1" in
        --host)
            [ "$#" -ge 2 ] || {
                printf 'Missing value for --host\n' >&2
                exit 2
            }
            remote_host="$2"
            shift
            ;;
        --check|--apply|--enroll|--enroll-maintenance|--revoke-maintenance|--hardware-report|--start-smart-long-kingston|--start-smart-long-micron)
            mode="$1"
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            printf 'Unknown option: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

case "$mode" in
--enroll|--enroll-maintenance)
    ssh -o BatchMode=yes "$remote_host" "rm -rf '$remote_dir' && mkdir -p '$remote_dir'"
    tar -C "$server_dir" -cf - \
        bootstrap \
        apply-power-policy \
        hardware-qualification \
        install-autonomy \
        maintenance-access \
        pol-server-bootstrap \
        pol-server-hardware \
        pol-server-maintenance \
        packages.txt \
        etc \
        keys |
        ssh -o BatchMode=yes "$remote_host" "tar -xf - -C '$remote_dir'"
    installer_argument=
    if [ "$mode" = --enroll-maintenance ]; then
        installer_argument=' --temporary-full-access'
    fi
    ssh -o BatchMode=yes -t "$remote_host" \
        "trap 'rm -rf \"$remote_dir\"' EXIT; sudo '$remote_dir/install-autonomy'$installer_argument"
    ;;
--apply)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-bootstrap --apply'
    ;;
--check)
    ssh -o BatchMode=yes "$remote_host" \
        '/usr/local/sbin/pol-server-bootstrap --check'
    ;;
--hardware-report)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-hardware --report'
    ;;
--start-smart-long-kingston)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-hardware --start-smart-long kingston'
    ;;
--start-smart-long-micron)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-hardware --start-smart-long micron'
    ;;
--revoke-maintenance)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-maintenance --revoke'
    ;;
esac