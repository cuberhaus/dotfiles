#!/usr/bin/env bash
# Description: Deploy and run the tracked pol-server bootstrap over SSH.
set -euo pipefail

server_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
remote_host="${POL_SERVER_HOST:-home-nas}"
mode=--check
remote_dir=/tmp/cuberhaus-pol-server-bootstrap

usage() {
    cat <<'EOF'
Usage: deploy [--host HOST] MODE

    --host HOST                    SSH host or alias (default: home-nas).
    --check                        Audit the installed root-owned baseline (default).
    --apply                        Converge the baseline through narrow passwordless sudo.
    --enroll                       Update the root-owned bundle; requires a sudo password.
    --enroll-maintenance           Enroll with eight-hour full maintenance access.
    --revoke-maintenance           Revoke temporary full maintenance access immediately.
    --reboot                       Reboot while temporary maintenance access is active.
    --upgrade                      Apply current Debian upgrades during maintenance.
    --hardware-report              Print the redacted hardware qualification report.
    --audit-wd-backup              Print the WD backup disk SMART report.
    --start-smart-long-kingston    Start the Kingston SMART long test.
    --start-smart-long-micron      Start the Micron SMART long test.
    --start-smart-long-wd-backup   Start the WD backup disk SMART long test.
    --thermal-load                 Run the fixed two-minute thermal load test.
    --configure-github-mirrors     Store a read-only GitHub token interactively.
    --sync-github-mirrors          Run the GitHub mirror service now.
    --check-github-mirrors         Verify local mirror integrity and schedule state.
EOF
}

while (( $# > 0 )); do
    case "$1" in
        --host)
            [ "$#" -ge 2 ] || {
                printf 'Missing value for --host\n' >&2
                exit 2
            }
            remote_host="$2"
            shift
            ;;
        --check|--apply|--enroll|--enroll-maintenance|--revoke-maintenance|--reboot|--upgrade|--hardware-report|--audit-wd-backup|--start-smart-long-kingston|--start-smart-long-micron|--start-smart-long-wd-backup|--thermal-load|--configure-github-mirrors|--sync-github-mirrors|--check-github-mirrors)
            mode="$1"
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            printf 'Unknown option: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

case "$mode" in
--enroll|--enroll-maintenance)
    ssh -o BatchMode=yes "$remote_host" "rm -rf '$remote_dir' && mkdir -p '$remote_dir'"
    tar -C "$server_dir" -cf - \
        bootstrap \
        apply-power-policy \
        hardware-qualification \
        github-mirror \
        install-autonomy \
        maintenance-access \
        pol-server-bootstrap \
        pol-server-hardware \
        pol-server-github-mirror \
        pol-server-maintenance \
        packages.txt \
        etc \
        keys |
        ssh -o BatchMode=yes "$remote_host" "tar -xf - -C '$remote_dir'"
    installer_argument=
    if [ "$mode" = --enroll-maintenance ]; then
        installer_argument=' --temporary-full-access'
    fi
    ssh -o BatchMode=yes -t "$remote_host" \
        "trap 'rm -rf \"$remote_dir\"' EXIT; sudo '$remote_dir/install-autonomy'$installer_argument"
    ;;
--apply)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-bootstrap --apply'
    ;;
--check)
    ssh -o BatchMode=yes "$remote_host" \
        '/usr/local/sbin/pol-server-bootstrap --check'
    ;;
--hardware-report)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-hardware --report'
    ;;
--audit-wd-backup)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-hardware --report-disk wd-backup'
    ;;
--start-smart-long-kingston)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-hardware --start-smart-long kingston'
    ;;
--start-smart-long-micron)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-hardware --start-smart-long micron'
    ;;
--start-smart-long-wd-backup)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-hardware --start-smart-long wd-backup'
    ;;
--thermal-load)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-hardware --thermal-load'
    ;;
--configure-github-mirrors)
    ssh -o BatchMode=yes -t "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-github-mirror --configure-token'
    ;;
--sync-github-mirrors)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-github-mirror --sync'
    ;;
--check-github-mirrors)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-github-mirror --check'
    ;;
--revoke-maintenance)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-maintenance --revoke'
    ;;
--reboot)
    ssh -o BatchMode=yes "$remote_host" 'sudo -n systemctl reboot'
    ;;
--upgrade)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n apt-get update && sudo -n env DEBIAN_FRONTEND=noninteractive apt-get full-upgrade -y'
    ;;
esac