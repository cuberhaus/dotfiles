#!/usr/bin/env bash
# Description: Deploy and run the tracked pol-server bootstrap over SSH.
set -euo pipefail

server_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
remote_host="${POL_SERVER_HOST:-home-nas}"
mode=--check
remote_dir=/tmp/cuberhaus-pol-server-bootstrap

usage() {
    cat <<'EOF'
Usage: deploy [--host HOST] MODE

    --host HOST                    SSH host or alias (default: home-nas).
    --check                        Audit the installed root-owned baseline (default).
    --apply                        Converge the baseline through narrow passwordless sudo.
    --enroll                       Update the root-owned bundle; requires a sudo password.
    --enroll-maintenance           Enroll with eight-hour full maintenance access.
    --revoke-maintenance           Revoke temporary full maintenance access immediately.
    --reboot                       Reboot while temporary maintenance access is active.
    --upgrade                      Apply current Debian upgrades during maintenance.
    --hardware-report              Print the redacted hardware qualification report.
    --check-storage                Verify the model-pinned Kingston storage preflight.
    --prepare-storage              Erase the approved Kingston disk and create /srv/storage.
    --check-samba                  Audit Samba configuration, account, and service state.
    --configure-samba              Stage authenticated LAN-only Samba configuration.
    --set-samba-password           Enroll the Samba password and activate smbd interactively.
    --generate-samba-password      Generate a private local password and activate smbd.
    --test-samba-access            Test SMB3 file operations and guest denial on every share.
    --check-backup                 Audit the WD mount, Restic repository, and timers.
    --prepare-backup               Mount the accepted WD partition without formatting it.
    --generate-restic-password     Generate a private local password and initialize Restic.
    --run-backup                   Back up /srv/storage now.
    --check-backup-repository      Check Restic metadata and a rotating data subset.
    --restore-test-backup          Restore and compare the backup acceptance probe.
    --audit-wd-backup              Print the WD backup disk SMART report.
    --start-smart-long-kingston    Start the Kingston SMART long test.
    --start-smart-long-micron      Start the Micron SMART long test.
    --start-smart-long-wd-backup   Start the WD backup disk SMART long test.
    --thermal-load                 Run the fixed two-minute thermal load test.
    --configure-github-mirrors     Store a read-only GitHub token interactively.
    --sync-github-mirrors          Run the GitHub mirror service now.
    --check-github-mirrors         Verify local mirror integrity and schedule state.
    --configure-rss-email          Validate and store Gmail delivery settings.
    --run-rss-email                Run the RSS email service immediately.
    --test-rss-email               Send one RSS delivery test email.
    --email-wd-report              Email the current redacted WD SMART report.
    --install-immich               Install official Docker Engine packages.
    --check-immich                 Audit Immich placement, binding, and health.
    --configure-immich             Configure and start the pinned Immich stack.
    --start-immich                 Reconcile and start Immich.
    --stop-immich                  Stop Immich without deleting data.
    --backup-immich                Create a consistent database dump for Restic.
    --upgrade-immich               Back up, pull, and reconcile the pinned stack.
    --restore-immich               Validate and preview the fixed WD recovery set.
    --restore-immich-apply         Apply the fixed WD recovery set with rollback copies.
    --install-monitoring           Install native LAN-only Netdata.
    --check-monitoring             Audit Netdata configuration and reachability.
    --install-wireguard            Install the restricted WireGuard server.
    --check-wireguard              Audit WireGuard, peer, and firewall state.
    --generate-wireguard-client    Generate and enroll pol-iphone locally.
    --show-wireguard-qr            Show pol-iphone's QR in an interactive terminal.
    --revoke-wireguard-client      Revoke pol-iphone from the server.
    --configure-duckdns            Store the DuckDNS token interactively.
EOF
}

while (( $# > 0 )); do
    case "$1" in
        --host)
            [ "$#" -ge 2 ] || {
                printf 'Missing value for --host\n' >&2
                exit 2
            }
            remote_host="$2"
            shift
            ;;
        --check|--apply|--enroll|--enroll-maintenance|--revoke-maintenance|--reboot|--upgrade|--hardware-report|--check-storage|--prepare-storage|--check-samba|--configure-samba|--set-samba-password|--generate-samba-password|--test-samba-access|--check-backup|--prepare-backup|--generate-restic-password|--run-backup|--check-backup-repository|--restore-test-backup|--audit-wd-backup|--start-smart-long-kingston|--start-smart-long-micron|--start-smart-long-wd-backup|--thermal-load|--configure-github-mirrors|--sync-github-mirrors|--check-github-mirrors|--configure-rss-email|--run-rss-email|--test-rss-email|--email-wd-report|--install-immich|--check-immich|--configure-immich|--start-immich|--stop-immich|--backup-immich|--upgrade-immich|--restore-immich|--restore-immich-apply|--install-monitoring|--check-monitoring|--install-wireguard|--check-wireguard|--generate-wireguard-client|--show-wireguard-qr|--revoke-wireguard-client|--configure-duckdns)
            mode="$1"
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            printf 'Unknown option: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

case "$mode" in
--enroll|--enroll-maintenance)
    ssh -o BatchMode=yes "$remote_host" "rm -rf '$remote_dir' && mkdir -p '$remote_dir'"
    tar -C "$server_dir" -cf - \
        bootstrap \
        apply-power-policy \
        backup-setup \
        hardware-qualification \
        storage-setup \
        github-mirror \
        immich-setup \
        install-autonomy \
        maintenance-access \
        monitoring-setup \
        wireguard-setup \
        samba-setup \
        pol-server-bootstrap \
        pol-server-hardware \
        pol-server-storage \
        pol-server-samba \
        pol-server-backup \
        pol-server-github-mirror \
        pol-server-rss-email \
        pol-server-immich \
        pol-server-monitoring \
        pol-server-wireguard \
        rss-email \
        pol-server-maintenance \
        packages.txt \
        etc \
        keys |
        ssh -o BatchMode=yes "$remote_host" "tar -xf - -C '$remote_dir'"
    installer_argument=
    if [ "$mode" = --enroll-maintenance ]; then
        installer_argument=' --temporary-full-access'
    fi
    ssh -o BatchMode=yes -t "$remote_host" \
        "trap 'rm -rf \"$remote_dir\"' EXIT; sudo '$remote_dir/install-autonomy'$installer_argument"
    ;;
--apply)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-bootstrap --apply'
    ;;
--check)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-bootstrap --check'
    ;;
--hardware-report)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-hardware --report'
    ;;
--check-storage)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-storage --check'
    ;;
--prepare-storage)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-storage --apply ERASE-KINGSTON-SA400S37960G'
    ;;
--check-samba)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-samba --check'
    ;;
--configure-samba)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-samba --apply'
    ;;
--set-samba-password)
    ssh -o BatchMode=yes -t "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-samba --set-password'
    ;;
--generate-samba-password)
    secret_dir="${XDG_CONFIG_HOME:-$HOME/.config}/cuberhaus/secrets"
    secret_file="$secret_dir/pol-server-samba-password"
    install -d -m 0700 "$secret_dir"
    umask 077
    temporary_secret="$(mktemp "$secret_dir/.pol-server-samba-password.XXXXXX")"
    cleanup_secret() {
        rm -f "$temporary_secret"
    }
    trap cleanup_secret EXIT
    openssl rand -base64 24 | tr -d '\n' > "$temporary_secret"
    printf '\n' >> "$temporary_secret"
    {
        cat "$temporary_secret"
        cat "$temporary_secret"
    } | ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-samba --set-password-stdin'
    mv "$temporary_secret" "$secret_file"
    chmod 0600 "$secret_file"
    trap - EXIT
    printf 'Samba password stored locally at %s (mode 0600).\n' "$secret_file"
    ;;
--test-samba-access)
    secret_file="${XDG_CONFIG_HOME:-$HOME/.config}/cuberhaus/secrets/pol-server-samba-password"
    if [ ! -r "$secret_file" ] || [ "$(stat -c '%a' "$secret_file")" != 600 ]; then
        printf 'Expected a readable mode-0600 Samba password at %s\n' "$secret_file" >&2
        exit 1
    fi
    {
        printf 'username = pol-files\npassword = '
        cat "$secret_file"
    } | ssh -o BatchMode=yes "$remote_host" '
        set -eu
        umask 077
        auth="$(mktemp /tmp/cuberhaus-smb-auth.XXXXXX)"
        payload="$(mktemp /tmp/cuberhaus-smb-payload.XXXXXX)"
        download="$(mktemp /tmp/cuberhaus-smb-download.XXXXXX)"
        remote_name=".cuberhaus-acceptance-$$"
        cleanup() {
            for share in shared incoming private; do
                smbclient "//127.0.0.1/$share" -A "$auth" -m SMB3 \
                    -c "del $remote_name; del ${remote_name}.renamed" >/dev/null 2>&1 || true
            done
            rm -f "$auth" "$payload" "$download"
        }
        trap cleanup EXIT HUP INT TERM
        cat > "$auth"
        printf "cuberhaus Samba acceptance\n" > "$payload"
        for share in shared incoming private; do
            if ! smbclient "//127.0.0.1/$share" -A "$auth" -m SMB3 \
                -c "put $payload $remote_name; rename $remote_name ${remote_name}.renamed; get ${remote_name}.renamed $download; del ${remote_name}.renamed"; then
                printf "ERROR: SMB3 file lifecycle failed: %s\n" "$share" >&2
                exit 1
            fi
            if ! cmp -s "$payload" "$download"; then
                printf "ERROR: SMB3 downloaded content differed: %s\n" "$share" >&2
                exit 1
            fi
            printf "SMB3 file lifecycle passed: %s\n" "$share"
        done
        if smbclient //127.0.0.1/shared -N -m SMB3 -c ls >/dev/null 2>&1; then
            printf "ERROR: guest access unexpectedly succeeded\n" >&2
            exit 1
        fi
        printf "Guest access denied as expected.\n"
    '
    ;;
--check-backup)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-backup --check'
    ;;
--prepare-backup)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-backup --prepare'
    ;;
--generate-restic-password)
    secret_dir="${XDG_CONFIG_HOME:-$HOME/.config}/cuberhaus/secrets"
    secret_file="$secret_dir/pol-server-restic-password"
    install -d -m 0700 "$secret_dir"
    umask 077
    temporary_secret="$(mktemp "$secret_dir/.pol-server-restic-password.XXXXXX")"
    cleanup_secret() {
        rm -f "$temporary_secret"
    }
    trap cleanup_secret EXIT
    openssl rand -base64 32 | tr -d '\n' > "$temporary_secret"
    printf '\n' >> "$temporary_secret"
    {
        cat "$temporary_secret"
        cat "$temporary_secret"
    } | ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-backup --configure-password-stdin'
    mv "$temporary_secret" "$secret_file"
    chmod 0600 "$secret_file"
    trap - EXIT
    printf 'Restic password stored locally at %s (mode 0600).\n' "$secret_file"
    ;;
--run-backup)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-backup --backup'
    ;;
--check-backup-repository)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-backup --check-repository'
    ;;
--restore-test-backup)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-backup --restore-test'
    ;;
--audit-wd-backup)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-hardware --report-disk wd-backup'
    ;;
--start-smart-long-kingston)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-hardware --start-smart-long kingston'
    ;;
--start-smart-long-micron)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-hardware --start-smart-long micron'
    ;;
--start-smart-long-wd-backup)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-hardware --start-smart-long wd-backup'
    ;;
--thermal-load)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-hardware --thermal-load'
    ;;
--configure-github-mirrors)
    ssh -o BatchMode=yes -t "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-github-mirror --configure-token'
    ;;
--sync-github-mirrors)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-github-mirror --sync'
    ;;
--check-github-mirrors)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-github-mirror --check'
    ;;
--configure-rss-email)
    ssh -o BatchMode=yes -t "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-rss-email --configure'
    ;;
--run-rss-email)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/bin/systemctl start pol-server-rss-email.service'
    ;;
--test-rss-email)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-rss-email --test-email'
    ;;
--email-wd-report)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-rss-email --send-wd-report'
    ;;
--install-immich)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-immich --install'
    ;;
--check-immich)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-immich --check'
    ;;
--configure-immich)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-immich --configure'
    ;;
--start-immich)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-immich --start'
    ;;
--stop-immich)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-immich --stop'
    ;;
--backup-immich)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-immich --backup'
    ;;
--upgrade-immich)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-immich --upgrade'
    ;;
--restore-immich)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-immich --restore-existing'
    ;;
--restore-immich-apply)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-immich --restore-existing-apply RESTORE-WD-IMMICH'
    ;;
--install-monitoring)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-monitoring --install'
    ;;
--check-monitoring)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-monitoring --check'
    ;;
--install-wireguard)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-wireguard --install'
    ;;
--check-wireguard)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-wireguard --check'
    ;;
--generate-wireguard-client)
    if ! command -v wg >/dev/null 2>&1; then
        printf 'Local wireguard-tools is required to generate the iPhone key.\n' >&2
        exit 127
    fi
    secret_dir="${XDG_CONFIG_HOME:-$HOME/.config}/cuberhaus/secrets"
    client_config="$secret_dir/pol-server-wireguard-pol-iphone.conf"
    install -d -m 0700 "$secret_dir"
    umask 077
    private_key="$(mktemp "$secret_dir/.pol-iphone-private.XXXXXX")"
    public_key="$(mktemp "$secret_dir/.pol-iphone-public.XXXXXX")"
    temporary_config="$(mktemp "$secret_dir/.pol-iphone-config.XXXXXX")"
    cleanup_wireguard_client() {
        rm -f -- "$private_key" "$public_key" "$temporary_config"
    }
    trap cleanup_wireguard_client EXIT
    if [ -e "$client_config" ]; then
        if [ ! -r "$client_config" ] || [ "$(stat -c '%a' "$client_config")" != 600 ]; then
            printf 'Existing WireGuard profile must be readable and mode 0600: %s\n' "$client_config" >&2
            exit 1
        fi
        awk -F ' = ' '$1 == "PrivateKey" { print $2 }' "$client_config" > "$private_key"
        if [ "$(wc -l < "$private_key")" != 1 ] || ! wg pubkey < "$private_key" > "$public_key"; then
            printf 'Existing WireGuard profile has an invalid private key: %s\n' "$client_config" >&2
            exit 1
        fi
    else
        wg genkey > "$private_key"
        wg pubkey < "$private_key" > "$public_key"
    fi
    server_public_key="$(
        ssh -o BatchMode=yes "$remote_host" \
            'sudo -n /usr/local/sbin/pol-server-wireguard --server-public-key'
    )"
    {
        printf '%s\n' '[Interface]'
        printf 'PrivateKey = %s\n' "$(cat "$private_key")"
        printf '%s\n' 'Address = 10.77.0.2/32'
        printf '\n%s\n' '[Peer]'
        printf 'PublicKey = %s\n' "$server_public_key"
        printf '%s\n' 'Endpoint = pol-home-nas.duckdns.org:51820'
        printf '%s\n' 'AllowedIPs = 192.168.1.34/32'
        printf '%s\n' 'PersistentKeepalive = 25'
    } > "$temporary_config"
    if ! ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-wireguard --enroll-pol-iphone-stdin' \
        < "$public_key"; then
        printf 'Peer enrollment failed; the local client configuration was not replaced.\n' >&2
        exit 1
    fi
    install -m 0600 "$temporary_config" "$client_config"
    cleanup_wireguard_client
    trap - EXIT
    printf 'WireGuard client configuration enrolled from %s (mode 0600).\n' "$client_config"
    printf 'Run make show-pol-server-wireguard-qr in your own terminal to scan it.\n'
    ;;
--show-wireguard-qr)
    client_config="${XDG_CONFIG_HOME:-$HOME/.config}/cuberhaus/secrets/pol-server-wireguard-pol-iphone.conf"
    if [ ! -r "$client_config" ] || [ "$(stat -c '%a' "$client_config")" != 600 ]; then
        printf 'Expected a readable mode-0600 client configuration at %s\n' "$client_config" >&2
        exit 1
    fi
    if ! command -v qrencode >/dev/null 2>&1; then
        printf 'Local qrencode is required to display the enrollment QR.\n' >&2
        exit 127
    fi
    if [ ! -t 1 ]; then
        printf 'Refusing to emit the private enrollment QR outside an interactive terminal.\n' >&2
        exit 1
    fi
    qrencode -t ANSIUTF8 < "$client_config"
    ;;
--revoke-wireguard-client)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-wireguard --revoke-pol-iphone'
    ;;
--configure-duckdns)
    ssh -o BatchMode=yes -t "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-wireguard --configure-duckdns-token'
    ;;
--revoke-maintenance)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n /usr/local/sbin/pol-server-maintenance --revoke'
    ;;
--reboot)
    ssh -o BatchMode=yes "$remote_host" 'sudo -n systemctl reboot'
    ;;
--upgrade)
    ssh -o BatchMode=yes "$remote_host" \
        'sudo -n apt-get update && sudo -n env DEBIAN_FRONTEND=noninteractive apt-get full-upgrade -y'
    ;;
esac