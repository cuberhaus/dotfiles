#!/usr/bin/env python3
"""Send one email for each unseen item in the configured RSS feed."""

import json
import getpass
import os
import smtplib
import ssl
import subprocess
import sys
import tempfile
import urllib.request
import xml.etree.ElementTree as ET
from dataclasses import dataclass
from contextlib import contextmanager
from email.headerregistry import Address
from email.message import EmailMessage
from html.parser import HTMLParser
from pathlib import Path


DEFAULT_FEED_URL = "https://steamcommunity.com/groups/GrabFreeGames/rss/"


@dataclass(frozen=True)
class FeedItem:
    guid: str
    title: str
    link: str
    description: str
    published: str


class TextExtractor(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.parts: list[str] = []

    def handle_data(self, data: str) -> None:
        self.parts.append(data)

    def handle_starttag(
        self, tag: str, attrs: list[tuple[str, str | None]]
    ) -> None:
        del attrs
        if tag in {"br", "div", "li", "p"}:
            self.parts.append("\n")

    def text(self) -> str:
        lines = [" ".join(line.split()) for line in "".join(self.parts).splitlines()]
        return "\n".join(line for line in lines if line)


def load_credentials() -> dict[str, str]:
    credentials_directory = Path(
        os.environ.get("CREDENTIALS_DIRECTORY", "/etc/cuberhaus")
    )
    credential_path = credentials_directory / "rss-email.json"
    with credential_path.open(encoding="utf-8") as credential_file:
        credentials = json.load(credential_file)

    for field in ("sender", "recipient", "app_password"):
        if not isinstance(credentials.get(field), str) or not credentials[field]:
            raise ValueError(f"RSS email credential field is missing: {field}")
    return credentials


def normalize_address(value: str) -> str:
    value = value.strip()
    if "\r" in value or "\n" in value:
        raise ValueError("Email address contains a line break")
    return str(Address(addr_spec=value))


def read_configuration() -> dict[str, str]:
    if sys.stdin.isatty():
        sender = input("Gmail sender address: ")
        recipient = input("Recipient address [same as sender]: ")
        app_password = getpass.getpass("Gmail app password: ")
    else:
        sender = sys.stdin.readline()
        recipient = sys.stdin.readline()
        app_password = sys.stdin.readline()
    sender = normalize_address(sender)
    recipient = normalize_address(recipient) if recipient.strip() else sender
    app_password = "".join(app_password.split())
    if not app_password:
        raise ValueError("Gmail app password cannot be empty")
    return {
        "sender": sender,
        "recipient": recipient,
        "app_password": app_password,
    }


@contextmanager
def gmail_connection(sender: str, app_password: str):
    with smtplib.SMTP("smtp.gmail.com", 587, timeout=30) as smtp:
        smtp.ehlo()
        smtp.starttls(context=ssl.create_default_context())
        smtp.ehlo()
        smtp.login(sender, app_password)
        yield smtp


def configured_credential_path() -> Path:
    root_prefix = os.environ.get("POL_SERVER_ROOT") or "/"
    return Path(root_prefix) / "etc" / "cuberhaus" / "rss-email.json"


def write_credentials(credentials: dict[str, str]) -> None:
    credential_path = configured_credential_path()
    credential_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    file_descriptor, temporary_name = tempfile.mkstemp(
        prefix=".rss-email.", dir=credential_path.parent
    )
    try:
        with os.fdopen(file_descriptor, "w", encoding="utf-8") as credential_file:
            json.dump(credentials, credential_file)
            credential_file.write("\n")
        os.chmod(temporary_name, 0o600)
        os.replace(temporary_name, credential_path)
    except BaseException:
        Path(temporary_name).unlink(missing_ok=True)
        raise


def configure() -> int:
    if (
        os.environ.get("POL_SERVER_ALLOW_UNPRIVILEGED") != "true"
        and os.geteuid() != 0
    ):
        raise PermissionError(
            "Run --configure through the tracked root-owned deploy command"
        )
    credentials = read_configuration()
    with gmail_connection(credentials["sender"], credentials["app_password"]):
        pass
    write_credentials(credentials)
    subprocess.run(["systemctl", "daemon-reload"], check=True)
    subprocess.run(
        ["systemctl", "start", "pol-server-rss-email.service"], check=True
    )
    subprocess.run(
        ["systemctl", "enable", "--now", "pol-server-rss-email.timer"],
        check=True,
    )
    print("RSS email credential validated and timer enabled")
    return 0


def fetch_items(feed_url: str) -> list[FeedItem]:
    request = urllib.request.Request(
        feed_url,
        headers={"User-Agent": "pol-server-rss-email/1.0"},
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        root = ET.fromstring(response.read())

    items: list[FeedItem] = []
    guids: set[str] = set()
    for item in root.findall("./channel/item"):
        guid = (item.findtext("guid") or "").strip()
        if not guid:
            raise ValueError("RSS item is missing a GUID")
        if guid in guids:
            continue
        title = " ".join((item.findtext("title") or "Untitled feed item").split())
        link = (item.findtext("link") or "").strip()
        extractor = TextExtractor()
        extractor.feed(item.findtext("description") or "")
        items.append(
            FeedItem(
                guid=guid,
                title=title,
                link=link,
                description=extractor.text(),
                published=(item.findtext("pubDate") or "").strip(),
            )
        )
        guids.add(guid)
    if not items:
        raise ValueError("RSS feed contains no items")
    return items


def write_seen_guids(state_path: Path, guids: list[str]) -> None:
    state_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    file_descriptor, temporary_name = tempfile.mkstemp(
        prefix=".seen-guids.", dir=state_path.parent
    )
    try:
        with os.fdopen(file_descriptor, "w", encoding="utf-8") as state_file:
            json.dump(guids, state_file)
            state_file.write("\n")
        os.replace(temporary_name, state_path)
    except BaseException:
        Path(temporary_name).unlink(missing_ok=True)
        raise


def read_seen_guids(state_path: Path) -> list[str]:
    with state_path.open(encoding="utf-8") as state_file:
        guids = json.load(state_file)
    if not isinstance(guids, list) or not all(
        isinstance(guid, str) and guid for guid in guids
    ):
        raise ValueError("RSS email state is invalid")
    return guids


def build_message(item: FeedItem, sender: str, recipient: str) -> EmailMessage:
    message = EmailMessage()
    message["Subject"] = item.title.replace("\r", " ").replace("\n", " ")
    message["From"] = sender
    message["To"] = recipient
    sections = [item.title]
    if item.published:
        sections.append(f"Published: {item.published}")
    if item.description:
        sections.append(item.description)
    if item.link:
        sections.append(item.link)
    message.set_content("\n\n".join(sections))
    return message


def send_new_items(
    items: list[FeedItem], credentials: dict[str, str], state_path: Path
) -> int:
    seen_guids = read_seen_guids(state_path)
    seen = set(seen_guids)
    new_items = [item for item in reversed(items) if item.guid not in seen]
    if not new_items:
        print("No new feed items")
        return 0

    with gmail_connection(credentials["sender"], credentials["app_password"]) as smtp:
        for item in new_items:
            smtp.send_message(
                build_message(item, credentials["sender"], credentials["recipient"])
            )
            seen_guids.append(item.guid)
            seen.add(item.guid)
            write_seen_guids(state_path, seen_guids)

    print(f"Sent feed items: {len(new_items)}")
    return 0


def send_test_email() -> int:
    credentials = load_credentials()
    item = FeedItem(
        guid="delivery-test",
        title="[pol-server] RSS email delivery test",
        link=DEFAULT_FEED_URL,
        description=(
            "The pol-server RSS-to-Gmail automation can deliver messages "
            "successfully."
        ),
        published="",
    )
    with gmail_connection(credentials["sender"], credentials["app_password"]) as smtp:
        smtp.send_message(
            build_message(item, credentials["sender"], credentials["recipient"])
        )
    print(f"Test email sent to {credentials['recipient']}")
    return 0


def send_wd_report() -> int:
    report = subprocess.run(
        [
            "/usr/local/sbin/pol-server-hardware",
            "--report-disk",
            "wd-backup",
        ],
        capture_output=True,
        check=False,
        text=True,
    )
    report_sections = [f"Command exit code: {report.returncode}"]
    if report.stdout.strip():
        report_sections.append(report.stdout.strip())
    if report.stderr.strip():
        report_sections.append(report.stderr.strip())

    credentials = load_credentials()
    item = FeedItem(
        guid="wd-smart-post-test-report",
        title="[pol-server] WD SMART post-test report",
        link="",
        description="\n\n".join(report_sections),
        published="",
    )
    with gmail_connection(credentials["sender"], credentials["app_password"]) as smtp:
        smtp.send_message(
            build_message(item, credentials["sender"], credentials["recipient"])
        )
    print(f"WD SMART report sent to {credentials['recipient']}")
    return 0 if report.returncode == 0 else 1


def run() -> int:
    credentials = load_credentials()
    feed_url = os.environ.get("RSS_EMAIL_FEED_URL", DEFAULT_FEED_URL)
    state_directory = Path(
        os.environ.get("STATE_DIRECTORY", "/var/lib/cuberhaus-rss-email")
    )
    state_path = state_directory / "seen-guids.json"
    items = fetch_items(feed_url)

    if not state_path.exists():
        write_seen_guids(state_path, [item.guid for item in items])
        print(f"Baseline recorded: {len(items)} feed items")
        return 0

    return send_new_items(items, credentials, state_path)


def main(arguments: list[str] | None = None) -> int:
    arguments = sys.argv[1:] if arguments is None else arguments
    if arguments not in (
        ["--run"],
        ["--configure"],
        ["--test-email"],
        ["--send-wd-report"],
    ):
        print(
            "Usage: rss-email "
            "[--configure | --run | --test-email | --send-wd-report]",
            file=sys.stderr,
        )
        return 2

    try:
        if arguments == ["--run"]:
            return run()
        if arguments == ["--configure"]:
            return configure()
        if arguments == ["--test-email"]:
            return send_test_email()
        return send_wd_report()
    except (
        OSError,
        ValueError,
        ET.ParseError,
        json.JSONDecodeError,
        smtplib.SMTPException,
        subprocess.CalledProcessError,
    ) as error:
        print(f"RSS email failed: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())