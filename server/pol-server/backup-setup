#!/usr/bin/env bash
# Description: Prepare and operate the model-pinned pol-server backup destination.
set -euo pipefail

wd_model='WDC WD15SMRW-11YNDS0'
minimum_bytes=1400000000000
maximum_bytes=1600000000000
backup_uuid='5EEB-7DF6'
backup_label='Pol-HDD'
backup_filesystem=exfat
mount_point=/mnt/pol-server-backup
fstab_options='defaults,nofail,x-systemd.automount,x-systemd.idle-timeout=10min,x-systemd.device-timeout=30s,nosuid,nodev,noexec,uid=0,gid=0,fmask=0077,dmask=0077'
root_prefix="${POL_SERVER_ROOT:-}"
storage_path="${root_prefix%/}/srv/storage"
credential_path="${root_prefix%/}/etc/cuberhaus/restic-password"
state_path="${root_prefix%/}/var/lib/cuberhaus-backup"
immich_environment="${root_prefix%/}/etc/cuberhaus/immich.env"
immich_command="${root_prefix%/}/usr/local/lib/cuberhaus/pol-server/immich-setup"

error() { printf '\033[31m[ERROR]\033[0m %s\n' "$*" >&2; }

usage() {
    cat <<'EOF'
Usage: backup-setup MODE

    --check                     Audit the WD mount, repository, credential, and timer.
    --prepare                   Mount the existing exFAT partition and create the restic directory.
    --configure-password-stdin  Initialize restic from a confirmed password on standard input.
    --backup                    Back up /srv/storage and record success only after completion.
    --check-repository          Verify metadata and a rotating twelfth of repository data.
    --restore-test              Restore and compare the stable acceptance probe.
EOF
}

root_path() {
    printf '%s%s\n' "${root_prefix%/}" "$1"
}

repository_path() {
    printf '%s/pol-server-restic\n' "$(root_path "$mount_point")"
}

expected_fstab_entry() {
    printf 'UUID=%s %s %s %s 0 0\n' \
        "$backup_uuid" "$mount_point" "$backup_filesystem" "$fstab_options"
}

backup_mount_info() {
    local partition="$1"
    local mount_path="$2"
    local fstab_path mount_info concrete_mounts

    fstab_path="$(root_path /etc/fstab)"
    mount_info="$(findmnt -n -o SOURCE,FSTYPE --mountpoint "$mount_path" 2>/dev/null || true)"
    if [ "$mount_info" = 'systemd-1 autofs' ] &&
        grep -Fqx "$(expected_fstab_entry)" "$fstab_path"; then
        find "$mount_path" -mindepth 1 -maxdepth 1 -print -quit >/dev/null 2>&1 || true
        mount_info="$(findmnt -n -o SOURCE,FSTYPE --mountpoint "$mount_path" 2>/dev/null || true)"
    fi

    concrete_mounts="$(awk '$2 != "autofs" { print }' <<< "$mount_info")"
    if [ "$concrete_mounts" = "$partition $backup_filesystem" ]; then
        printf '%s %s\n' "$partition" "$backup_filesystem"
    else
        printf '%s\n' "$mount_info"
    fi
}

resolve_wd_backup() {
    local path model candidate_size
    local match=

    while read -r path model; do
        [ "$model" = "$wd_model" ] || continue
        candidate_size="$(blockdev --getsize64 "$path")"
        if (( candidate_size < minimum_bytes || candidate_size > maximum_bytes )); then
            error "Refusing WD candidate with unexpected capacity: $candidate_size bytes"
            return 1
        fi
        if [ -n "$match" ]; then
            error 'Refusing ambiguous WD backup disk inventory.'
            return 1
        fi
        match="$path"
    done < <(lsblk -dn -o PATH,MODEL)

    if [ -z "$match" ]; then
        error 'Expected WD backup disk was not found.'
        return 1
    fi
    printf '%s\n' "$match"
}

resolve_backup_partition() {
    local device="$1"
    local path type filesystem label uuid
    local match=

    while read -r path type filesystem label uuid; do
        [ "$type" = part ] || continue
        [ "$uuid" = "$backup_uuid" ] || continue
        if [ "$filesystem" != "$backup_filesystem" ] || [ "$label" != "$backup_label" ]; then
            error 'Refusing WD partition with unexpected filesystem or label.'
            return 1
        fi
        if [ -n "$match" ]; then
            error 'Refusing ambiguous WD backup partition inventory.'
            return 1
        fi
        match="$path"
    done < <(lsblk -nrpo PATH,TYPE,FSTYPE,LABEL,UUID "$device")

    if [ -z "$match" ]; then
        error "Expected WD partition UUID $backup_uuid was not found."
        return 1
    fi
    printf '%s\n' "$match"
}

check_backup() {
    local device partition mount_path mount_info fstab_path repository

    device="$(resolve_wd_backup)"
    partition="$(resolve_backup_partition "$device")"
    mount_path="$(root_path "$mount_point")"
    fstab_path="$(root_path /etc/fstab)"
    repository="$(repository_path)"

    printf 'Backup disk: %s (%s)\n' "$device" "$wd_model"
    printf 'Backup partition: %s (%s, UUID %s)\n' \
        "$partition" "$backup_filesystem" "$backup_uuid"

    mount_info="$(backup_mount_info "$partition" "$mount_path")"
    if [ -z "$mount_info" ]; then
        if [ -r "$fstab_path" ] && grep -Eq \
            "^UUID=${backup_uuid}[[:space:]]+${mount_point}[[:space:]]+${backup_filesystem}[[:space:]]" \
            "$fstab_path"; then
            printf 'Backup state: staged, unmounted\n'
        else
            printf 'Backup state: available, unconfigured\n'
        fi
        return
    fi

    if [ "$mount_info" != "$partition $backup_filesystem" ]; then
        error "Unexpected backup mount: $mount_info"
        return 1
    fi
    if [ -f "$repository/config" ] && [ -r "$credential_path" ] &&
        [ "$(stat -c %a "$credential_path")" = 600 ]; then
        if systemctl is-enabled pol-server-backup.timer >/dev/null 2>&1 &&
            systemctl is-active pol-server-backup.timer >/dev/null 2>&1 &&
            systemctl is-enabled pol-server-backup-check.timer >/dev/null 2>&1 &&
            systemctl is-active pol-server-backup-check.timer >/dev/null 2>&1; then
            if [ ! -s "$state_path/last-success" ] || [ ! -s "$state_path/last-check" ]; then
                error 'Backup acceptance is incomplete: success or check marker is missing.'
                return 1
            fi
            printf 'Backup state: configured\n'
            printf 'Last successful backup: %s\n' "$(cat "$state_path/last-success")"
            printf 'Last repository check: %s\n' "$(cat "$state_path/last-check")"
        else
            printf 'Backup state: repository initialized, timer inactive\n'
        fi
    else
        printf 'Backup state: prepared, repository not initialized\n'
    fi
}

require_apply_privileges() {
    if [ "${POL_SERVER_ALLOW_UNPRIVILEGED:-false}" != true ] && (( EUID != 0 )); then
        error 'Run --prepare as root through the tracked deploy command.'
        return 1
    fi
}

prepare_backup() {
    local device partition mount_path mount_info source_mount fstab_path repository_path
    local expected_fstab conflicting_entry fstab_backup=

    require_apply_privileges
    device="$(resolve_wd_backup)"
    partition="$(resolve_backup_partition "$device")"
    mount_path="$(root_path "$mount_point")"
    fstab_path="$(root_path /etc/fstab)"
    repository_path="$mount_path/pol-server-restic"
    expected_fstab="$(expected_fstab_entry)"

    install -d -m 0700 "$mount_path"
    source_mount="$(findmnt -n -o TARGET --source "$partition" 2>/dev/null || true)"
    if [ -n "$source_mount" ] && [ "$source_mount" != "$mount_path" ]; then
        error "Refusing WD partition already mounted at $source_mount."
        return 1
    fi
    mount_info="$(backup_mount_info "$partition" "$mount_path")"
    if [ -n "$mount_info" ] && [ "$mount_info" != "$partition $backup_filesystem" ]; then
        error "Refusing unexpected filesystem at backup mountpoint: $mount_info"
        return 1
    fi

    conflicting_entry="$(awk -v source="UUID=$backup_uuid" -v target="$mount_point" '
        $0 !~ /^[[:space:]]*#/ && NF >= 2 && ($1 == source || $2 == target) { print }
    ' "$fstab_path")"
    if [ -n "$conflicting_entry" ] && ! grep -Fqx "$expected_fstab" "$fstab_path"; then
        error 'Refusing conflicting WD backup entry in fstab.'
        return 1
    fi

    if ! grep -Fqx "$expected_fstab" "$fstab_path"; then
        fstab_backup="${fstab_path}.pre-pol-server-backup.$(date -u +%Y%m%d%H%M%SZ)"
        cp -a "$fstab_path" "$fstab_backup"
        printf '%s\n' "$expected_fstab" >> "$fstab_path"
        if [ -z "$root_prefix" ]; then
            systemctl daemon-reload
        fi
    fi

    if [ -z "$mount_info" ]; then
        if ! mount "$mount_path"; then
            if [ -n "$fstab_backup" ]; then
                cp -a "$fstab_backup" "$fstab_path"
                [ -n "$root_prefix" ] || systemctl daemon-reload
            fi
            error 'Failed to mount the WD backup partition; restored fstab.'
            return 1
        fi
    fi

    mount_info="$(backup_mount_info "$partition" "$mount_path")"
    if [ "$mount_info" != "$partition $backup_filesystem" ]; then
        error "Unexpected backup mount after preparation: ${mount_info:-unmounted}"
        return 1
    fi

    install -d -m 0700 "$repository_path" "$storage_path"
    if [ ! -e "$storage_path/.cuberhaus-backup-probe" ]; then
        printf 'pol-server backup restore probe\n' > "$storage_path/.cuberhaus-backup-probe"
        chmod 0600 "$storage_path/.cuberhaus-backup-probe"
    fi
    printf 'Prepared existing WD backup partition at %s.\n' "$mount_point"
    printf 'Restic repository directory: %s\n' "$mount_point/pol-server-restic"
}

verify_prepared_mount() {
    local device partition mount_path mount_info

    device="$(resolve_wd_backup)"
    partition="$(resolve_backup_partition "$device")"
    mount_path="$(root_path "$mount_point")"
    mount_info="$(backup_mount_info "$partition" "$mount_path")"
    if [ "$mount_info" != "$partition $backup_filesystem" ]; then
        error "Expected the WD exFAT partition at $mount_point; found ${mount_info:-unmounted}."
        return 1
    fi
}

restic_with_password() {
    local password_file="$1"
    shift
    RESTIC_REPOSITORY="$(repository_path)" \
        RESTIC_PASSWORD_FILE="$password_file" \
        restic "$@"
}

active_password_file() {
    if [ -n "${CREDENTIALS_DIRECTORY:-}" ] &&
        [ -r "$CREDENTIALS_DIRECTORY/restic-password" ]; then
        printf '%s\n' "$CREDENTIALS_DIRECTORY/restic-password"
    else
        printf '%s\n' "$credential_path"
    fi
}

verify_repository() {
    local password_file

    verify_prepared_mount
    [ -f "$(repository_path)/config" ] || {
        error 'Restic repository is not initialized.'
        return 1
    }
    password_file="$(active_password_file)"
    [ -r "$password_file" ] || {
        error 'Restic credential is unavailable.'
        return 1
    }
}

record_success() {
    local marker="$1"
    local staging

    install -d -m 0700 "$state_path"
    staging="$(mktemp "$state_path/.${marker}.XXXXXX")"
    date -u +%Y-%m-%dT%H:%M:%SZ > "$staging"
    mv "$staging" "$state_path/$marker"
}

prepare_application_backups() {
    [ -e "$immich_environment" ] || return 0
    [ -x "$immich_command" ] || {
        error "Configured Immich backup command is unavailable: $immich_command"
        return 1
    }
    "$immich_command" --backup
}

configure_password() {
    local password confirmation credential_directory credential_staging repository

    require_apply_privileges
    verify_prepared_mount
    repository="$(repository_path)"
    if [ ! -f "$repository/config" ] &&
        [ -n "$(find "$repository" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
        error 'Refusing to initialize a non-empty directory that is not a restic repository.'
        return 1
    fi
    IFS= read -r password
    IFS= read -r confirmation
    if [ -z "$password" ] || [ "$password" != "$confirmation" ] ||
        (( ${#password} < 24 )); then
        error 'Restic password confirmation failed or is too short.'
        return 1
    fi

    credential_directory="$(dirname "$credential_path")"
    install -d -m 0700 "$credential_directory"
    credential_staging="$(mktemp "$credential_directory/.restic-password.XXXXXX")"
    printf '%s\n' "$password" > "$credential_staging"
    chmod 0600 "$credential_staging"
    password=
    confirmation=

    if [ -f "$repository/config" ]; then
        if ! restic_with_password "$credential_staging" snapshots >/dev/null; then
            rm -f "$credential_staging"
            error 'The supplied password cannot unlock the existing restic repository.'
            return 1
        fi
    elif ! restic_with_password "$credential_staging" init; then
        rm -f "$credential_staging"
        error 'Restic repository initialization failed.'
        return 1
    fi

    mv "$credential_staging" "$credential_path"
    chmod 0600 "$credential_path"
    if [ -z "$root_prefix" ]; then
        chown root:root "$credential_path"
    fi
    systemctl enable --now pol-server-backup.timer pol-server-backup-check.timer
    printf 'Restic repository initialized and backup timers enabled.\n'
}

run_backup() {
    local password_file

    require_apply_privileges
    verify_repository
    prepare_application_backups
    password_file="$(active_password_file)"
    restic_with_password "$password_file" \
        backup --one-file-system --exclude-caches "$storage_path"
    sync -f "$(repository_path)"
    record_success last-success
    printf 'Backup completed successfully.\n'
}

check_repository() {
    local password_file week subset

    require_apply_privileges
    verify_repository
    password_file="$(active_password_file)"
    week="$(date -u +%V)"
    subset="$((10#$week % 12 + 1))/12"
    restic_with_password "$password_file" check --read-data-subset="$subset"
    sync -f "$(repository_path)"
    record_success last-check
    printf 'Repository check completed successfully.\n'
}

restore_test() {
    local password_file probe restore_directory restored_probe
    local result=0

    require_apply_privileges
    verify_repository
    probe="$storage_path/.cuberhaus-backup-probe"
    [ -r "$probe" ] || {
        error "Restore probe is unavailable: $probe"
        return 1
    }
    password_file="$(active_password_file)"
    restore_directory="$(mktemp -d /tmp/pol-server-restic-restore.XXXXXX)"
    restored_probe="$restore_directory$probe"

    if ! restic_with_password "$password_file" restore latest \
        --target "$restore_directory" --include "$probe"; then
        error 'Restic restore command failed.'
        result=1
    elif ! cmp -s "$probe" "$restored_probe"; then
        error 'Restored acceptance probe does not match the source.'
        result=1
    else
        printf 'Restore test passed for %s.\n' "$probe"
    fi
    rm -rf "$restore_directory"
    return "$result"
}

main() {
    [ "$#" -eq 1 ] || {
        usage >&2
        return 2
    }
    case "$1" in
        --check) check_backup ;;
        --prepare) prepare_backup ;;
        --configure-password-stdin) configure_password ;;
        --backup) run_backup ;;
        --check-repository) check_repository ;;
        --restore-test) restore_test ;;
        --help|-h) usage ;;
        *)
            error "Unknown option: $1"
            usage >&2
            return 2
            ;;
    esac
}

main "$@"