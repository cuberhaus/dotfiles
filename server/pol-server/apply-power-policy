#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source_file="$script_dir/etc/systemd/logind.conf.d/90-pol-server.conf"
root_prefix="${POL_SERVER_ROOT:-}"
target_dir="${root_prefix%/}/etc/systemd/logind.conf.d"
target_file="$target_dir/90-pol-server.conf"
changed=false

if ! cmp -s "$source_file" "$target_file" 2>/dev/null; then
    install -D -m 0644 "$source_file" "$target_file"
    changed=true
fi

for unit in sleep.target suspend.target hibernate.target hybrid-sleep.target; do
    if [ "$(systemctl is-enabled "$unit" 2>/dev/null || true)" != masked ]; then
        systemctl mask "$unit"
        changed=true
    fi
done

if [ "$changed" = true ]; then
    systemctl daemon-reload
    systemctl restart systemd-logind
    printf 'Applied no-sleep policy from %s\n' "$source_file"
else
    printf 'No-sleep policy is current.\n'
fi