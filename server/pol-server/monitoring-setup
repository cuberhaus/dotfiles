#!/usr/bin/env bash
# Description: Install and audit LAN-only Netdata monitoring on pol-server.
set -euo pipefail

server_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
root_prefix="${POL_SERVER_ROOT:-}"
mode=check
config_source="$server_dir/etc/netdata/netdata.conf"
repository_package=netdata-repo
repository_package_version=5-5
repository_package_file='netdata-repo_5-5+debian13_all.deb'
repository_package_url="https://repository.netdata.cloud/repos/repoconfig/debian/trixie/$repository_package_file"
repository_package_sha256=af3db52c10df3ea2df9c7d4a5d2925a4fcb8d0ecda26ed53e226fcc0e26c2d98
configuration_changed=false
rollback_available=false
rollback_target=
config_was_created=false
telemetry_created=false

info() { printf '\033[34m[INFO]\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[WARN]\033[0m %s\n' "$*"; }
error() { printf '\033[31m[ERROR]\033[0m %s\n' "$*" >&2; }

usage() {
    cat <<'EOF'
Usage: monitoring-setup [--check | --install]

  --check    Audit Netdata package, configuration, service, API, and listeners.
  --install  Install and configure native LAN-only Netdata.
EOF
}

root_path() {
    printf '%s%s\n' "${root_prefix%/}" "$1"
}

parse_args() {
    while (( $# > 0 )); do
        case "$1" in
            --check|--install) mode="$1" ;;
            --help|-h)
                usage
                exit 0
                ;;
            *)
                error "Unknown option: $1"
                usage >&2
                exit 2
                ;;
        esac
        shift
    done
}

require_supported_host() {
    local os_release distro_id distro_version
    os_release="$(root_path /etc/os-release)"
    [ -r "$os_release" ] || {
        error "Cannot read $os_release"
        return 1
    }

    distro_id="$(. "$os_release"; printf '%s' "${ID:-}")"
    distro_version="$(. "$os_release"; printf '%s' "${VERSION_ID:-}")"
    if [ "$distro_id" != debian ] || [ "$distro_version" != 13 ]; then
        error "Expected Debian 13, found ${distro_id:-unknown} ${distro_version:-unknown}"
        return 1
    fi
}

require_install_privileges() {
    if [ "${POL_SERVER_ALLOW_UNPRIVILEGED:-false}" != true ] && (( EUID != 0 )); then
        error 'Run --install as root through the tracked deploy script.'
        return 1
    fi
}

package_installed() {
    dpkg-query -W -f='${db:Status-Status}' netdata >/dev/null 2>&1
}

package_version() {
    dpkg-query -W -f='${Version}' netdata 2>/dev/null
}

repository_package_installed() {
    dpkg-query -W -f='${db:Status-Status}' "$repository_package" >/dev/null 2>&1
}

repository_package_installed_version() {
    dpkg-query -W -f='${Version}' "$repository_package" 2>/dev/null
}

install_repository_package() {
    local temporary_directory package_path metadata
    repository_package_installed && return

    temporary_directory="$(mktemp -d)"
    package_path="$temporary_directory/$repository_package_file"
    if ! curl -fsSL -o "$package_path" "$repository_package_url"; then
        rm -rf -- "$temporary_directory"
        error 'Failed to download the pinned Netdata repository package.'
        return 1
    fi
    if ! printf '%s  %s\n' "$repository_package_sha256" "$package_path" | sha256sum -c - >/dev/null; then
        rm -rf -- "$temporary_directory"
        error 'Netdata repository package checksum verification failed.'
        return 1
    fi
    metadata="$(
        printf '%s\n%s\n%s\n' \
            "$(dpkg-deb -f "$package_path" Package)" \
            "$(dpkg-deb -f "$package_path" Version)" \
            "$(dpkg-deb -f "$package_path" Architecture)"
    )"
    if [ "$metadata" != "$repository_package
$repository_package_version
all" ]; then
        rm -rf -- "$temporary_directory"
        error 'Netdata repository package metadata verification failed.'
        return 1
    fi
    if ! DEBIAN_FRONTEND=noninteractive apt-get install -y \
        -o Dpkg::Options::=--force-confold "$package_path"; then
        rm -rf -- "$temporary_directory"
        error 'Netdata repository package installation failed.'
        return 1
    fi
    rm -rf -- "$temporary_directory"
}

service_ready() {
    systemctl is-enabled netdata.service >/dev/null 2>&1 &&
        systemctl is-active netdata.service >/dev/null 2>&1
}

install_configuration() {
    local config_target telemetry_target persistent_backup
    config_target="$(root_path /etc/netdata/netdata.conf)"
    telemetry_target="$(root_path /etc/netdata/.opt-out-from-anonymous-statistics)"
    rollback_target="${config_target}.rollback.$$"
    persistent_backup="${config_target}.cuberhaus-before-netdata"
    configuration_changed=false
    rollback_available=false
    config_was_created=false
    telemetry_created=false

    if ! cmp -s "$config_source" "$config_target" 2>/dev/null; then
        if [ -e "$config_target" ]; then
            cp -a -- "$config_target" "$rollback_target"
            rollback_available=true
            if [ ! -e "$persistent_backup" ]; then
                cp -a -- "$config_target" "$persistent_backup"
            fi
        else
            config_was_created=true
        fi
        install -D -m 0644 "$config_source" "$config_target"
        configuration_changed=true
    fi

    if [ ! -e "$telemetry_target" ]; then
        install -D -m 0644 /dev/null "$telemetry_target"
        configuration_changed=true
        telemetry_created=true
    fi
}

rollback_configuration() {
    local config_target
    config_target="$(root_path /etc/netdata/netdata.conf)"
    if [ "$rollback_available" = true ]; then
        install -m 0644 "$rollback_target" "$config_target"
    elif [ "$config_was_created" = true ]; then
        rm -f -- "$config_target"
    fi
    if [ "$telemetry_created" = true ]; then
        rm -f -- "$(root_path /etc/netdata/.opt-out-from-anonymous-statistics)"
    fi
    rm -f -- "$rollback_target"
}

validate_tracked_configuration() {
    local setting
    for setting in \
        'db = dbengine' \
        'storage tiers = 1' \
        'dbengine tier 0 retention size = 2GiB' \
        'dbengine tier 0 retention time = 3mo' \
        'bind to = 127.0.0.1 192.168.1.34' \
        'default port = 19999' \
        'allow connections from = localhost 192.168.1.*' \
        'allow dashboard from = localhost 192.168.1.*' \
        'allow mcp from = localhost' \
        'allow badges from = localhost' \
        'allow streaming from = localhost' \
        'allow netdata.conf from = localhost' \
        'allow management from = localhost'; do
        grep -Fq -- "$setting" "$config_source" || {
            error "Tracked Netdata configuration is missing: $setting"
            return 1
        }
    done

    if grep -Eq 'bind to[[:space:]]*=[[:space:]]*(\*|0\.0\.0\.0|::)' "$config_source" ||
        grep -Fq '/var/run/docker.sock' "$config_source"; then
        error 'Tracked Netdata configuration exposes a forbidden listener or Docker socket.'
        return 1
    fi
}

apply_monitoring() {
    local was_installed=false
    package_installed && was_installed=true
    validate_tracked_configuration
    install_configuration

    if [ "$was_installed" = false ]; then
        info 'Installing native Netdata package'
        if ! install_repository_package; then
            systemctl disable --now netdata.service >/dev/null 2>&1 || true
            rollback_configuration
            error 'Netdata repository setup failed; disabled any partial service and reverted configuration.'
            return 1
        fi
        if ! apt-get update; then
            rollback_configuration
            error 'APT metadata refresh failed; reverted staged Netdata configuration.'
            return 1
        fi
        if ! DEBIAN_FRONTEND=noninteractive apt-get install -y \
            -o Dpkg::Options::=--force-confold netdata; then
            systemctl disable --now netdata.service >/dev/null 2>&1 || true
            rollback_configuration
            error 'Netdata package installation failed; disabled any partial service and reverted configuration.'
            return 1
        fi
    fi

    if ! service_ready; then
        if ! systemctl enable --now netdata.service; then
            if [ "$was_installed" = false ]; then
                systemctl disable --now netdata.service >/dev/null 2>&1 || true
            fi
            rollback_configuration
            error 'Netdata failed to start; restored the previous configuration when available.'
            return 1
        fi
    elif [ "$configuration_changed" = true ] && [ "$was_installed" = true ]; then
        if ! systemctl restart netdata.service; then
            if [ "$rollback_available" = true ]; then
                rollback_configuration
                systemctl restart netdata.service || true
                error 'Netdata rejected the tracked configuration; restored the previous configuration.'
            else
                rollback_configuration
                systemctl disable --now netdata.service >/dev/null 2>&1 || true
                error 'Netdata rejected the tracked configuration; disabled the service because no prior configuration existed.'
            fi
            return 1
        fi
    fi

    rm -f -- "$rollback_target"
    info 'Netdata is installed and configured for LAN-only access'
}

check_listeners() {
    local listener_rows listeners unexpected
    listener_rows="$(ss -H -ltnp 'sport = :19999')"
    listeners="$(awk '{print $4}' <<< "$listener_rows")"
    if ! grep -Fxq '127.0.0.1:19999' <<< "$listeners" ||
        ! grep -Fxq '192.168.1.34:19999' <<< "$listeners"; then
        warn 'Netdata is not listening on both expected addresses'
        return 1
    fi

    unexpected="$(grep -Fvx -e '127.0.0.1:19999' -e '192.168.1.34:19999' <<< "$listeners" || true)"
    if [ -n "$unexpected" ]; then
        warn "Unexpected Netdata listener: $unexpected"
        return 1
    fi

    if ! awk '$4 == "127.0.0.1:19999" && /users:\(\("netdata",/' <<< "$listener_rows" | grep -q . ||
        ! awk '$4 == "192.168.1.34:19999" && /users:\(\("netdata",/' <<< "$listener_rows" | grep -q .; then
        warn 'Expected listeners are not owned by the Netdata process'
        return 1
    fi

    info 'Netdata listener restricted to loopback and 192.168.1.34:19999'
}

check_effective_configuration() {
    local effective_config setting
    if ! effective_config="$(curl --fail --silent --show-error --max-time 5 \
        http://127.0.0.1:19999/netdata.conf)"; then
        warn 'Netdata effective configuration endpoint is unavailable'
        return 1
    fi

    for setting in \
        'db = dbengine' \
        'storage tiers = 1' \
        'dbengine tier 0 retention size = 2GiB' \
        'dbengine tier 0 retention time = 3mo' \
        'bind to = 127.0.0.1 192.168.1.34' \
        'allow connections from = localhost 192.168.1.*' \
        'allow dashboard from = localhost 192.168.1.*' \
        'allow mcp from = localhost' \
        'allow badges from = localhost' \
        'allow streaming from = localhost' \
        'allow netdata.conf from = localhost' \
        'allow management from = localhost'; do
        if ! awk -v expected="$setting" '
            {
                line = $0
                sub(/^[[:space:]]*/, "", line)
                sub(/[[:space:]]*$/, "", line)
                if (line == expected) {
                    found = 1
                }
            }
            END { exit !found }
        ' <<< "$effective_config"; then
            warn "Netdata effective configuration is missing: $setting"
            return 1
        fi
    done

    info 'Netdata effective access and retention settings verified'
}

check_file_security() {
    local path="$1"
    local description="$2"
    local mode_bits owner_group
    if [ ! -e "$path" ]; then
        warn "$description missing"
        return 1
    fi

    mode_bits="$(stat -c '%a' "$path")"
    if [ "$mode_bits" != 644 ]; then
        warn "$description mode is $mode_bits; expected 644"
        return 1
    fi
    if [ -z "$root_prefix" ]; then
        owner_group="$(stat -c '%U:%G' "$path")"
        if [ "$owner_group" != root:root ]; then
            warn "$description owner is $owner_group; expected root:root"
            return 1
        fi
    fi
    info "$description permissions current"
}

check_monitoring() {
    local failures=0
    local api_info config_target repository_version telemetry_target version
    config_target="$(root_path /etc/netdata/netdata.conf)"
    telemetry_target="$(root_path /etc/netdata/.opt-out-from-anonymous-statistics)"

    if package_installed; then
        version="$(package_version)"
        info "Netdata package installed: ${version:-unknown version}"
    else
        warn 'Netdata package missing'
        failures=1
    fi

    if repository_package_installed; then
        repository_version="$(repository_package_installed_version)"
        info "Netdata repository package installed: ${repository_version:-unknown version}"
    else
        warn 'Netdata repository package missing'
        failures=1
    fi

    if cmp -s "$config_source" "$config_target" 2>/dev/null; then
        info 'Netdata configuration current'
    else
        warn 'Netdata configuration drift'
        failures=1
    fi

    if [ -e "$telemetry_target" ]; then
        info 'Netdata anonymous telemetry disabled'
    else
        warn 'Netdata anonymous telemetry opt-out missing'
        failures=1
    fi

    check_file_security "$config_target" 'Netdata configuration' || failures=1
    check_file_security "$telemetry_target" 'Netdata telemetry opt-out' || failures=1

    if service_ready; then
        info 'Netdata service active and enabled'
    else
        warn 'Netdata service is not active and enabled'
        failures=1
    fi

    if api_info="$(curl --fail --silent --show-error --max-time 5 \
        http://127.0.0.1:19999/api/v1/info)" &&
        jq -e '(.version | type == "string" and length > 0) and
            any(.mirrored_hosts_status[]?; .hostname == "pol-server" and .reachable == true)' \
            >/dev/null <<< "$api_info"; then
        info 'Netdata API healthy on loopback'
    else
        warn 'Netdata API is not healthy on loopback'
        failures=1
    fi

    check_listeners || failures=1
    check_effective_configuration || failures=1
    return "$failures"
}

parse_args "$@"
require_supported_host

case "$mode" in
    --install)
        require_install_privileges
        apply_monitoring
        ;;
    --check) check_monitoring ;;
esac