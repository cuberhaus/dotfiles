#!/bin/bash
# This file runs when a DM logs you into a graphical session.
# If you use startx/xinit like a Chad, this file will also be sourced. (from xinitrc)
[[ -f ~/.zshenv ]] && source ~/.zshenv

# if [[ "$DESKTOP_SESSION" == "i3" ]]; then
#     # This runs before i3
# fi

if [ -x "${DOTFILES:-$HOME}/.local/scripts/bin/keyboard-swap" ]; then
    "${DOTFILES:-$HOME}/.local/scripts/bin/keyboard-swap" --sync-x11 > /dev/null 2>&1
else
    setxkbmap -layout es -option caps:swapescape > /dev/null 2>&1
fi

if [[ "$DESKTOP_SESSION" == "cinnamon" ]]; then
    # xss-lock displays betterlockscreen when lid is closed
    exec xss-lock --transfer-sleep-lock -- cinnamon-screensaver -l &
    cinnamon-screensaver &
fi
