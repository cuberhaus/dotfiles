#!/usr/bin/env bash
# Description: Display and adjust the laptop backlight from i3blocks.
set -euo pipefail

STEP_SIZE="${STEP_SIZE:-5}"

case "${BLOCK_BUTTON:-}" in
    3) xset dpms force off ;;
    4) changeBrightness "$STEP_SIZE" ;;
    5) changeBrightness "-$STEP_SIZE" ;;
esac

if command -v brightnessctl >/dev/null 2>&1; then
    brightnessctl -m | awk -F, 'NR == 1 { gsub(/%/, "", $5); print $5 "%"; exit }'
elif command -v light >/dev/null 2>&1; then
    printf '%s%%\n' "$(light -G)"
else
    printf 'n/a\n'
fi
