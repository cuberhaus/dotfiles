{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  // Lightweight tasks (session titles, summaries)
  "small_model": "github-copilot/claude-haiku-5.5",
  // Subagents otherwise inherit the caller's model; run them on cheaper ones
  "agent": {
    "explore": { "model": "github-copilot/claude-haiku-5.5" },
    "general": { "model": "github-copilot/claude-sonnet-5.5" }
  }
}
