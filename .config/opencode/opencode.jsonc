{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  // Lightweight tasks (session titles, summaries)
  "small_model": "github-copilot/gpt-6-luna",
  // Subagents otherwise inherit the caller's model; run them on cheaper ones
  "agent": {
    "explore": { "model": "github-copilot/gpt-6-luna" },
    "general": { "model": "github-copilot/gpt-6.1-sol" }
  }
}
