## Create a directory and enter it.
function mkd() {
	mkdir -p "$@" && cd "$_" || exit;
}

## List dotfiles aliases, functions, and managed commands.
commands() {
    local aliases_file="${ZDOTDIR:-$HOME/.config/zsh}/aliases"
    local functions_file="${ZDOTDIR:-$HOME/.config/zsh}/functions"
    local command_dir="$HOME/.local/scripts/bin"
    local alias_group command_name definition description first_word source_file
    local first_line was_multiline wrapped_line
    local columns="${COLUMNS:-100}"
    local inline_width detail_width

    case "$columns" in
        ''|*[!0-9]*) columns=100 ;;
    esac
    [ "$columns" -lt 40 ] && columns=40
    inline_width=$((columns - 29))
    detail_width=$((inline_width * 2))

    for alias_group in aliases defaults; do
        if [ "$alias_group" = aliases ]; then
            printf '\033[34mAliases and workflows\033[0m\n'
            printf '  %-24s %s\n' 'NAME' 'EXPANDS TO'
        else
            printf '\n\033[34mCommand defaults\033[0m\n'
            printf '  %-24s %s\n' 'COMMAND' 'ADDS'
        fi

        if [ -f "$aliases_file" ]; then
            while IFS= read -r command_name; do
                definition=$(alias "$command_name" 2>/dev/null) || continue
                definition=${definition#*=}
                case "$definition" in
                    \$\'*) was_multiline=true ;;
                    *) was_multiline=false ;;
                esac
                definition=$(printf '%s' "$definition" \
                    | tr '\r\n\t' '   ' \
                    | sed -e "s/^\\$'//" -e "s/^'//" -e "s/'$//" \
                        -e 's/[[:space:]][[:space:]]*/ /g')
                if [ "$was_multiline" = true ]; then
                    definition=$(printf '%s' "$definition" \
                        | sed -e 's/\\n/ /g' -e "s/\\\\'/'/g" \
                            -e 's/[[:space:]][[:space:]]*/ /g')
                fi
                first_word=${definition%%[[:space:]]*}

                if [ "$alias_group" = defaults ]; then
                    [ "$first_word" = "$command_name" ] || continue
                    definition=${definition#"$command_name"}
                    definition=${definition# }
                else
                    [ "$first_word" = "$command_name" ] && continue
                fi

                if [ "${#definition}" -gt "$detail_width" ]; then
                    definition="${definition:0:$((detail_width - 3))}..."
                fi
                first_line=true
                while IFS= read -r wrapped_line; do
                    if [ "$first_line" = true ]; then
                        printf '  %-24s %s\n' "$command_name" "$wrapped_line"
                        first_line=false
                    else
                        printf '  %-24s %s\n' '' "$wrapped_line"
                    fi
                done < <(
                    printf '%s\n' "$definition" | awk -v width="$inline_width" '
                        {
                            current_line = ""
                            for (word_index = 1; word_index <= NF; word_index++) {
                                word = $word_index
                                if (length(word) > width) {
                                    word = substr(word, 1, width - 3) "..."
                                }
                                if (!length(current_line)) {
                                    current_line = word
                                } else if (length(current_line) + length(word) + 1 <= width) {
                                    current_line = current_line " " word
                                } else {
                                    print current_line
                                    current_line = word
                                }
                            }
                            print current_line
                        }
                    '
                )
            done < <(
                awk '
                    {
                        line = $0
                        sub(/^[[:space:]]*/, "", line)
                        if (line ~ /^alias[[:space:]]+/) {
                            sub(/^alias[[:space:]]+/, "", line)
                        } else if (line ~ /&&[[:space:]]*alias[[:space:]]+/) {
                            sub(/^.*&&[[:space:]]*alias[[:space:]]+/, "", line)
                        } else {
                            next
                        }
                        sub(/=.*/, "", line)
                        print line
                    }
                ' "$aliases_file" | LC_ALL=C sort -u
            )
        fi
    done

    printf '\n\033[34mFunctions\033[0m\n'
    printf '  %-24s %s\n' 'NAME' 'DESCRIPTION'
    for source_file in "$aliases_file" "$functions_file"; do
        [ -f "$source_file" ] || continue
        while IFS=$'\t' read -r command_name description; do
            typeset -f "$command_name" >/dev/null 2>&1 || continue
            [ -n "$description" ] || description='No description provided.'
            first_line=true
            while IFS= read -r wrapped_line; do
                if [ "$first_line" = true ]; then
                    printf '  %-24s %s\n' "$command_name" "$wrapped_line"
                    first_line=false
                else
                    printf '  %-24s %s\n' '' "$wrapped_line"
                fi
            done < <(printf '%s\n' "$description" | fold -s -w "$inline_width")
        done < <(
            awk '
                /^[[:space:]]*##[[:space:]]+/ {
                    description = $0
                    sub(/^[[:space:]]*##[[:space:]]+/, "", description)
                    next
                }
                /^[[:space:]]*(function[[:space:]]+)?[^#[:space:]()=]+[[:space:]]*\(\)/ {
                    function_name = $0
                    sub(/^[[:space:]]*/, "", function_name)
                    sub(/^function[[:space:]]+/, "", function_name)
                    sub(/[[:space:]]*\(\).*/, "", function_name)
                    print function_name "\t" description
                    description = ""
                    next
                }
                /^[[:space:]]*#/ { next }
                /[^[:space:]]/ { description = "" }
            ' "$source_file" | LC_ALL=C sort -u
        )
    done

    printf '\n\033[34mManaged commands\033[0m\n'
    printf '  %-24s %s\n' 'NAME' 'DESCRIPTION'
    if [ -d "$command_dir" ]; then
        while IFS= read -r source_file; do
            description=$(awk -v command_name="${source_file##*/}" '
                NR == 1 && /^#!/ { next }
                /^[[:space:]]*#/ {
                    sub(/^[[:space:]]*#[[:space:]]*/, "")
                    if (/^Description:[[:space:]]*/) {
                        sub(/^Description:[[:space:]]*/, "")
                        description = $0
                    } else if (!description && length && $0 != command_name &&
                               $0 !~ /^(Author|Date|Script inspired by|https?:|shellcheck|=+)/) {
                        description = $0
                    }
                    next
                }
                /^[[:space:]]*$/ { next }
                { if (description) print description; found = 1; exit }
                END { if (!found && description) print description }
            ' "$source_file")
            [ -n "$description" ] || description='Executable managed by dotfiles'
            printf '  %-24s %s\n' "${source_file##*/}" "$description"
        done < <(find "$command_dir" -maxdepth 1 -type f -perm -u+x -print | LC_ALL=C sort)
    fi
}

## Apply a GitHub PAT to HTTPS remotes recursively.
function add_pat() {
    local pat="$1"
    if [ -z "$pat" ]; then
        echo "Usage: add_pat <token>"
        echo "Recursively changes all https://github.com/... remotes to use the defined PAT."
        return 1
    fi
    printf "\033[34mdepth: 2 \033[0m\n"
    while IFS= read -r -d '' dot_git; do
        local dir
        dir=$(dirname "$dot_git")
        local remote_url
        remote_url=$(git -C "$dir" remote get-url origin 2>/dev/null)
        if [ -n "$remote_url" ]; then
            if [[ "$remote_url" == *"github.com"* && "$remote_url" == https://* ]]; then
                # Remove any existing credentials and insert new formatting
                local new_url
                new_url=$(echo "$remote_url" | sed -E "s|https://([^@]+@)?github\\.com|https://$pat@github.com|")
                if [ "$remote_url" != "$new_url" ]; then
                    git -C "$dir" remote set-url origin "$new_url"
                    printf "\033[32m✓ %s\033[0m (remote updated)\n" "$dir"
                else
                    printf "\033[34m- %s\033[0m (already using this token)\n" "$dir"
                fi
            else
                printf "\033[33m! %s\033[0m (ignored: not an HTTPS GitHub remote)\n" "$dir"
            fi
        fi
    done < <(find . -maxdepth 2 -type d -name .git -print0 2>/dev/null)
}
