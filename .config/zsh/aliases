##@ Packages & updates

# cleanup is a script, not a function or alias: .local/scripts/bin/cleanup. An alias cannot
# take options, and a script also runs where zsh does not.

# An interpreter marked EXTERNALLY-MANAGED (PEP 668: Debian, Ubuntu, Arch, Homebrew)
# rejects `pip install --user`, and a virtualenv has no user site. There the system
# package manager keeps python3-pynvim and pip current, so pip must leave them alone.
## Upgrade pip and pynvim for the current user unless the OS manages Python.
pip_user_upgrade() {
    command -v python3 >/dev/null 2>&1 || return 0
    if ! python3 -c '
import os, sys, sysconfig
marker = os.path.join(sysconfig.get_path("stdlib"), "EXTERNALLY-MANAGED")
sys.exit(1 if os.path.exists(marker) or sys.prefix != sys.base_prefix else 0)
'; then
        printf '\033[34mSkipping pip upgrade: Python is externally managed (PEP 668) or a virtualenv is active.\033[0m\n'
        return 0
    fi
    python3 -m pip install --user --upgrade pip pynvim
}

# update and updateall are functions, because an alias cannot do what they need:
#   - zsh-syntax-highlighting reads the text of an alias and paints the whole command red
#     when any command inside it is not installed, however carefully it is guarded
#   - words typed after an alias are appended to its last command, so it has no --dry-run
# A live alias of the same name (from an older copy of this file that the running shell
# already loaded) turns the definitions below into a parse error, so drop it first.
unalias update 2>/dev/null
unalias updateall 2>/dev/null

# The command runs as typed, so shell functions work too (antigen, pip_user_upgrade). A
# binary that a function of the same name shadows needs `command` in front of it.
# --best-effort keeps a failure out of the summary, for a step that fails when it has
# nothing to do. It reads and updates the locals of _update_run: dry_run, the colours and
# failed_steps. A failing step never stops the ones after it.
## Run one update step, or only print it under --dry-run (helper of update and updateall).
_update_step() {
    local best_effort=false label
    if [ "$1" = --best-effort ]; then
        best_effort=true
        shift
    fi
    label=$1
    shift
    printf '%s==> %s%s\n' "$blue" "$label" "$reset"
    if [ "$dry_run" = true ]; then
        printf '    would run:'
        printf ' %q' "$@"
        printf '\n'
        return 0
    fi
    if ! "$@" && [ "$best_effort" = false ]; then
        printf '%s!! %s did not finish%s\n' "$yellow" "$label" "$reset" >&2
        failed_steps="${failed_steps:+$failed_steps, }$label"
    fi
    return 0
}

# Every step runs in the foreground, one after another, except Emacs. nvim draws a
# full-screen UI, so as a background job the shell stops it ("suspended (tty output)")
# before it updates anything, and background output would land in the middle of the prompt.
# Steps for tools that are not installed are skipped.
## Run update or updateall; the first argument is the name it was called by (helper).
_update_run() {
    local name=$1 arg dry_run=false failed_steps='' blue='' yellow='' reset=''
    local npm_self=false npm_update=false with_emacs=false with_gcloud=false
    shift
    for arg in "$@"; do
        case "$arg" in
            -n|--dry-run)
                dry_run=true
                ;;
            -h|--help)
                printf 'Usage: %s [-n|--dry-run]\n\n' "$name"
                if [ "$name" = updateall ]; then
                    printf '%s\n' \
                        'Update the operating system, then npm, Emacs, the Google Cloud CLI, pip and' \
                        'pynvim, the Zsh plugins (antigen) and the Neovim plugins.'
                else
                    printf '%s\n' "Update the operating system's packages."
                fi
                printf '%s\n' \
                    'Steps for tools that are not installed are skipped. A step that fails does not' \
                    'stop the others; the exit status is 1 if any of them failed.' \
                    '' \
                    '  -n, --dry-run  print what would run, without running it' \
                    '  -h, --help     show this help'
                return 0
                ;;
            *)
                printf '%s: unknown option: %s (try %s --help)\n' "$name" "$arg" "$name" >&2
                return 2
                ;;
        esac
    done
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
        blue=$'\033[34m' yellow=$'\033[33m' reset=$'\033[0m'
    fi

    case "${OSTYPE:-}:${DISTRO:-}" in
        darwin*:*)
            if command -v brew >/dev/null 2>&1; then
                _update_step 'Homebrew package lists' brew update
                _update_step 'Homebrew packages' brew upgrade
            fi
            _update_step 'macOS software updates' sudo softwareupdate -i -a
            # xcode-select --install installs developer tools that need to be updated with
            # every update to MacOS. It fails when they are installed already, which is fine.
            # sudo xcode-select -switch /Library/Developer/CommandLineTools
            _update_step --best-effort 'Command line tools' xcode-select --install
            npm_self=true
            ;;
        linux*:arch|linux*:manjaro)
            # updateall prefers yay, which upgrades the AUR packages along with the repositories.
            # `command -v` finds the yay() wrapper defined below even without the binary, so look
            # for the binary with the wrapper unset, and run it through `command`: the wrapper
            # would turn `yay -Syu` into `yay -S --noconfirm --needed -Syu`.
            if [ "$name" = updateall ] && (unset -f yay; command -v yay) >/dev/null 2>&1; then
                _update_step 'pacman and AUR packages' command yay -Syu
            else
                _update_step 'pacman packages' sudo pacman -Syu
            fi
            if command -v snap >/dev/null 2>&1; then
                _update_step 'Snap packages' sudo snap refresh
            fi
            # Do not add `sudo npm install -g npm` or `sudo gem update`: they break pacman.
            npm_update=true
            with_emacs=true
            ;;
        linux*:ubuntu|linux*:ubuntu_windows)
            _update_step 'apt package lists' sudo apt-get update
            _update_step 'apt packages' sudo apt-get full-upgrade
            if [ "$DISTRO" = ubuntu ]; then
                with_emacs=true
                with_gcloud=true
            fi
            ;;
        *)
            printf '%s-- No operating-system update is set up for OSTYPE=%s DISTRO=%s; skipping it%s\n' \
                "$yellow" "${OSTYPE:-unset}" "${DISTRO:-unset}" "$reset"
            ;;
    esac

    if [ "$name" = updateall ]; then
        if [ "$npm_self" = true ] && command -v npm >/dev/null 2>&1; then
            _update_step 'npm itself' npm install npm -g
        fi
        if [ "$npm_update" = true ] && command -v npm >/dev/null 2>&1; then
            _update_step 'npm packages (current directory)' npm update
        fi
        if [ "$with_emacs" = true ] && command -v emacs >/dev/null 2>&1; then
            # Emacs is its own window, so it updates in the background instead of being waited for.
            printf '%s==> Emacs packages (started in the background)%s\n' "$blue" "$reset"
            if [ "$dry_run" = true ]; then
                printf '    would run: emacs -f auto-package-update-now &\n'
            else
                command emacs -f auto-package-update-now &
            fi
        fi
        if [ "$with_gcloud" = true ] && command -v gcloud >/dev/null 2>&1; then
            _update_step 'Google Cloud CLI' gcloud components update --quiet
        fi
        _update_step 'pip and pynvim' pip_user_upgrade
        if type antigen >/dev/null 2>&1; then
            _update_step 'Zsh plugins (antigen)' antigen update
        fi
        if command -v nvim >/dev/null 2>&1; then
            _update_step 'Neovim plugins' nvim +PlugUpgrade +PlugUpdate +qall
        fi
    fi

    if [ "$dry_run" = true ]; then
        printf '%sDry run: nothing was changed.%s\n' "$blue" "$reset"
    fi
    if [ -n "$failed_steps" ]; then
        printf '%s!! Did not finish: %s%s\n' "$yellow" "$failed_steps" "$reset" >&2
        return 1
    fi
    return 0
}

## Update the operating system's packages; -n previews the commands without running them.
update() { _update_run update "$@"; }

## Update the OS, npm, Emacs, Google Cloud CLI, pip, and the Zsh and Neovim plugins; -n previews it.
updateall() { _update_run updateall "$@"; }

