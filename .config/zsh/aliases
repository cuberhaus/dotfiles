###############################################################
# Info:
# & send a process to background. Example: discord &
# ! disown a process. Example: discord !
# </dev/null &>/dev/null completely silence a process.
# Combinations are possible. Example: discord &!
# alias="" Is created during shell startup and won't change
# alias='' Is created during runtime and will evaluate every time it's called
# $RANDOM will generate a random number from 0 through 32767
# array=('Element1' 'Element2')
# Use mimeopen to set default apps
###############################################################

# The `commands` function reads this file to build its listing: a `##@ Group` line starts a
# group for everything below it, and a `## Description.` line directly above an alias or a
# function says what it does. A new alias is documented by writing that line; see "Shell
# command catalog" in AGENTS.md. An alias with no `##` line that only renames one command
# (gr="git-recurse") is listed next to that command.

scripts=$HOME/.local/scripts

##@ Files & navigation

# Easier navigation: .., ..., ...., ....., ~ and -
## Go up one directory.
alias ..="cd .."
## Go up two directories.
alias ...="cd ../.."
## Go up three directories.
alias ....="cd ../../.."
## Go up four directories.
alias .....="cd ../../../.."
## Go to the repos folder, ~/repos.
alias cr='cd $HOME/repos'

if command -v eza &> /dev/null
then
    ## List files, directories first (eza; exa or plain ls when eza is missing).
    alias ls="eza --group-directories-first"
    ## List all files, hidden ones included.
    alias la="eza --group-directories-first -a"
    ## List all files in long format with owner, size and git status (eza or exa; plain ls otherwise).
    alias l="eza -a -F --long --header --links --group --group-directories-first --git"
elif command -v exa &> /dev/null
then
    alias ls="exa --group-directories-first"
    alias la="exa --group-directories-first -a"
    alias l="exa -a -F --long --header --links --group --group-directories-first --git"
else
    alias ls="ls -l"
    alias la="ls -a"
    alias l="ls"
fi

## Copy, asking before it overwrites a file and printing each one copied.
alias cp="cp -iv"          # confirm before overwriting something
## Move, asking before it overwrites a file and printing each one moved.
