# restore-app-data only previews a restore unless it is given --apply, and it ignores every
# argument after that. So the rclonepull_* commands always pass --apply and refuse any other
# argument: as aliases, a stray -h reached it after --apply and restored the files.
unalias rclonepull_calibre rclonepull_thunderbird rclonepull_anki 2>/dev/null
## Restore one app's data from Google Drive with restore-app-data (helper of the rclonepull_* commands).
_rclonepull() {
    local name=$1 app=$2 what=$3
    shift 3
    case ${1:-} in
        '') ;;
        -h|--help)
            printf 'Usage: %s\n\n' "$name"
            printf 'Restore %s from Google Drive: restore-app-data %s --apply.\n' "$what" "$app"
            printf 'Close the app first. Nothing is deleted. Run ~/.local/scripts/restore-app-data %s\n' "$app"
            printf 'without --apply to preview the restore.\n'
            return 0
            ;;
        *)
            printf '%s: unexpected argument: %s (try %s --help)\n' "$name" "$1" "$name" >&2
            return 2
            ;;
    esac
    "$HOME/.local/scripts/restore-app-data" "$app" --apply
}
## Restore the Calibre library from Google Drive (close Calibre first; nothing is deleted).
