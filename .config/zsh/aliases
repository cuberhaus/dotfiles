## Change the login shell with chsh, or print the help of tobash or tozsh (helper of both).
_use_login_shell() {
    local name=$1 shell_name=$2
    shift 2
    case ${1:-} in
        '') ;;
        -h|--help)
            printf 'Usage: %s\n\n' "$name"
            printf 'Make %s your login shell (sudo chsh). Log out and back in to apply it.\n' "$shell_name"
            return 0
            ;;
        *)
            printf '%s: unexpected argument: %s (try %s --help)\n' "$name" "$1" "$name" >&2
            return 2
            ;;
    esac
    sudo chsh "$USER" -s "/bin/$shell_name" && echo "Now log out."
}
## Make bash your login shell (asks for sudo); log out and back in to apply it.
tobash() { _use_login_shell tobash bash "$@"; }
## Make zsh your login shell (asks for sudo); log out and back in to apply it.
tozsh() { _use_login_shell tozsh zsh "$@"; }

