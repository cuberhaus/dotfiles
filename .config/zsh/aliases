###############################################################
# => Enterprise RAG test environment
###############################################################

# Local k3s (Traefik) intercepts port 443 via iptables, so the tunnel uses 8443
# and Chrome maps erag.com hostnames to it. Host details live in ~/.ssh/config.
# Both are functions, not aliases: what an alias is given lands after its fixed host or URL,
# where ssh takes it as a remote command and Chrome as another page, so -h would open the
# tunnel or a browser instead of answering.
unalias erag-tunnel erag-chrome 2>/dev/null
# 1) Start the tunnel (prompts for the jump host passphrase and sdp password).
## Open the SSH tunnel to the Enterprise RAG test environment on local port 8443.
erag-tunnel() {
    case ${1:-} in
        '') ;;
        -h|--help)
            printf 'Usage: erag-tunnel\n\n'
            printf 'Open the SSH tunnel to the Enterprise RAG test environment (the erag-test host in\n'
            printf 'your ~/.ssh/config) on local port 8443. It asks for the jump host passphrase and the\n'
            printf 'sdp password, then stays open until you press Ctrl-C.\n'
            return 0
            ;;
        *)
            printf 'erag-tunnel: unexpected argument: %s (try erag-tunnel --help)\n' "$1" >&2
            return 2
            ;;
    esac
    ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -L 8443:localhost:443 erag-test
}
# 2) Open a throwaway Chrome profile that resolves erag.com to the tunnel.
## Open a throwaway Chrome profile that resolves erag.com to the tunnel; start erag-tunnel first.
erag-chrome() {
    case ${1:-} in
        -h|--help)
            printf 'Usage: erag-chrome [URL...]\n\n'
            printf 'Open https://erag.com/ (and any URLs you add) in a throwaway Chrome profile,\n'
            printf '/tmp/chrome-erag, that resolves erag.com to the tunnel on local port 8443. Start\n'
            printf 'erag-tunnel first.\n'
            return 0
            ;;
    esac
    google-chrome --user-data-dir=/tmp/chrome-erag --host-resolver-rules="MAP erag.com 127.0.0.1:8443, MAP *.erag.com 127.0.0.1:8443" --ignore-certificate-errors https://erag.com/ "$@"
}
