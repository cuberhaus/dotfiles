# Generalize commands
# shellcheck disable=SC1078,SC1079,SC2139
cleanup="command -v nvim &>/dev/null && nvim +PlugClean +qall;
    command -v pip3 &>/dev/null && pip3 cache purge;
    command -v yarn &>/dev/null && yarn cache clean;
    command -v npm &>/dev/null && npm cache clean --force;
    command -v docker &>/dev/null && docker builder prune -af --filter 'until=168h';
    command -v docker &>/dev/null && docker image prune -af --filter 'until=168h';
    command -v docker &>/dev/null && docker container prune -f --filter 'until=168h'
    "
update=""
updateall="command -v python3 &>/dev/null && python3 -m pip install --user --upgrade pynvim &
    command -v nvim &>/dev/null && nvim +PlugUpgrade +PlugUpdate +qall &
    type antigen &>/dev/null && antigen update &
    command -v pip3 &>/dev/null && pip3 install --user --upgrade pip &
"
### MacOS
if [[ "$OSTYPE" == "darwin"* ]]; then
    alias rm="rm -v"
    update="command -v brew &>/dev/null && { brew update; brew upgrade; }; sudo softwareupdate -i -a; xcode-select --install; "$update
    updateall=$update"command -v npm &>/dev/null && npm install npm -g;
    "$updateall
    #emacs -f auto-package-update-now &;

    # sudo xcode-select -switch /Library/Developer/CommandLineTools
    # xcode-select --install installs developer tools that need to be updated with every update to MacOS
    cleanup="command -v brew &>/dev/null && brew cleanup; command -v gem &>/dev/null && sudo gem cleanup;"$cleanup
    # Recursively delete `.DS_Store` files
    alias clean="find . -type f -name '*.DS_Store' -ls -delete; find . -type f -name '._*' -exec rm -f {} \;
"
fi

if [[ "$OSTYPE" == "linux"* ]]; then

    alias rm="rm -vI"
    # Lock screen
    LockScreens=()
    command -v pipes.sh &>/dev/null && LockScreens+=('pipes.sh')
    command -v cmatrix &>/dev/null && LockScreens+=('cmatrix')
    if (( ${#LockScreens[@]} > 0 )); then
        alias lock='${LockScreens[$RANDOM % ${#LockScreens[@]}]}'
    fi
    # Get the error messages from journalctl
    alias jctl="journalctl -p 3 -xb"
    # Check vulnerabilities microcode
    alias microcode="grep . /sys/devices/system/cpu/vulnerabilities/*"

    ### Arch & Manjaro
    if [[ "$DISTRO" == "arch" || "$DISTRO" == "manjaro" ]]; then
        update="sudo pacman -Syu; command -v snap &>/dev/null && sudo snap refresh; "$update
        updateall="command -v yay &>/dev/null && yay -Syu; command -v npm &>/dev/null && npm update & command -v snap &>/dev/null && sudo snap refresh;
        command -v emacs &>/dev/null && emacs -f auto-package-update-now &
        "$updateall
        # This breaks pacman sudo npm install -g npm; sudo gem update;
        # Cleans pacman and AUR cache and vim no longer used plugins
        cleanup="command -v yay &>/dev/null && yay -Sc;"$cleanup
        #sudo pacman -R $(pacman -Qdtq)
        alias unlock="sudo rm /var/lib/pacman/db.lck" #pacman unlock
    fi

    ### Arch
    if [[ "$DISTRO" == "arch" ]]; then
        # Get fastest mirrors in your neighborhood
        alias mirror="sudo reflector -f 30 -l 30 --number 10 --verbose --save /etc/pacman.d/mirrorlist"
    fi

    ### Manjaro
    if [[ "$DISTRO" == "manjaro" ]]; then
        # Update mirrors and update
        alias mirror="sudo pacman-mirrors -f && sudo pacman -Syyu"
    fi

    ### Ubuntu
    if [[ "$DISTRO" == "ubuntu" ]]; then
        update="sudo apt-get update; sudo apt-get full-upgrade; "$update
        updateall=$update"command -v emacs &>/dev/null && emacs -f auto-package-update-now & command -v gcloud &>/dev/null && gcloud components update --quiet;"$updateall
        cleanup="sudo apt-get autoclean;
        sudo apt-get clean;
        sudo apt-get autoremove;
        command -v brew &>/dev/null && brew cleanup;
        "$cleanup
        alias tmux='tmux -f $HOME/.config/tmux/tmux.conf'
    fi

    ### Ubuntu_windows
    if [[ "$DISTRO" == "ubuntu_windows" ]]; then
        update="sudo apt-get update; sudo apt-get full-upgrade; "$update
        updateall=$update$updateall
        cleanup="sudo apt-get autoclean;
        sudo apt-get clean;
        sudo apt-get autoremove;
        command -v brew &>/dev/null && brew cleanup;
        "$cleanup
        alias tmux='tmux -f $HOME/.config/tmux/tmux.conf'
    fi

    if [[ "$DISTRO" == "arch" || "$DISTRO" == "manjaro" ]]; then
        pac() { sudo pacman -S --noconfirm --needed "$@"; }
        yay() { command yay -S --noconfirm --needed "$@"; }
    fi

    if [[ "$DISTRO" == "ubuntu"* ]]; then
        apt() { sudo apt-get -y install "$@"; }
    fi
fi

