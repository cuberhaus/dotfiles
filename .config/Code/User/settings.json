    "path": "/bin/bash",
    "args": ["--noprofile", "--norc"],
    "env": {
      "BASH_ENV": null,
      "ENV": null,
      "GH_PAGER": "cat",
      "GIT_PAGER": "cat",
      "PAGER": "cat"
    }
  },
  "vim.incsearch": true,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "vim.leader": "<space>",
  "vim.surround": true,
  "code-runner.executorMap": {
    "cpp": "cd $dir && g++ -g -std=c++11 $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
    "python": "$pythonPath -u $fullFileName"
  },
  "vim.normalModeKeyBindings": [
    {
      "before": [
        "leader",
        "CR"
      ],
      "commands": [
        ":nohl"
      ]
    },
    {
      "before": [
        "leader",
        "f",
        "s"
      ],
      "commands": [
        "workbench.action.files.save"
      ]
    }
  ],
  "workbench.colorCustomizations": {},
  "gitlens.blame.highlight.enabled": false,
  "git.autofetch": true,
  "debug.onTaskErrors": "showErrors",
  "code-runner.runInTerminal": true,
