# =============================================================================
# Whitelist gitignore — ignore everything, then un-ignore what we track.
# New apps that write to ~/.config or ~/.local are invisible by default.
# =============================================================================

# Ignore everything
*

# =============================================================================
# Top-level files
# =============================================================================
!.zshenv
!.bashrc
!.bash_profile
!.xinitrc
!.xprofile
!.Xresources
!.Xmodmap
!.screenrc
!.editorconfig
!.markdownlint.json
!.shellcheckrc
!.gitattributes
!.gitignore
!.gitmodules
!.stow-local-ignore
!Makefile
!README.md
!LICENSE
!AGENTS.md
!skills-lock.json
!.cursorrules
!.github/
!.github/**

# =============================================================================
# Top-level directories (fully tracked)
# =============================================================================
!.vim/
!.vim/**
.vim/.netrwhist
!.doom.d/
!.doom.d/**
!.xmonad/
!.xmonad/**
!.cinnamon/
!.cinnamon/**
!.conky/
!.conky/**
!.hammerspoon/
!.hammerspoon/**
!.tomighty/
!.tomighty/**
!cuberhaus-workspace/
!cuberhaus-workspace/**

# =============================================================================
# .cache/ — only emacs bookmarks
# =============================================================================
!.cache/
.cache/*
!.cache/emacs/
.cache/emacs/*
!.cache/emacs/var/
.cache/emacs/var/*
!.cache/emacs/var/bookmark-default.el

# =============================================================================
# .config/ — un-ignore tracked subdirs and standalone files
# =============================================================================
!.config/
.config/*

# Standalone files in .config/
!.config/.p10k.zsh
!.config/.git-prompt-colors.sh
# birdtray-config.json contains per-user Thunderbird mailbox paths — don't track
!.config/emacs.org
!.config/inputrc
!.config/stick
!.config/stickyKeys
!.config/libinput-gestures.conf
!.config/Colemak DH ISO KS.keylayout
!.config/colemak DH ISO ES.bundle/
!.config/colemak DH ISO ES.bundle/**

# Shell
!.config/zsh/
!.config/zsh/**
!.config/antigen/
!.config/antigen/**
!.config/base16-shell
!.config/bash-git-prompt

# Editors
!.config/nvim/
!.config/nvim/**
!.config/my_emacs/
!.config/my_emacs/**
!.config/chemacs/
!.config/chemacs/**
!.config/snippets
!.config/sublime-text-3/
!.config/sublime-text-3/**
!.config/Cursor/
!.config/Cursor/**
!.config/Antigravity/
!.config/Antigravity/**
!.config/warp-terminal/
!.config/warp-terminal/**

# Terminals
!.config/kitty/
!.config/kitty/**
!.config/alacritty/
!.config/alacritty/**
!.config/termite/
!.config/termite/**
!.config/iterm2/
!.config/iterm2/**

# Window managers / bars
!.config/i3/
!.config/i3/**
!.config/i3blocks/
!.config/i3blocks/**
!.config/i3-layout-manager/
!.config/i3-layout-manager/**
!.config/sway/
!.config/sway/**
!.config/qtile/
!.config/qtile/**
!.config/xmobar/
!.config/xmobar/**
!.config/polybar/
!.config/polybar/**
!.config/rofi/
!.config/rofi/**
!.config/rasi/
!.config/rasi/**

# Notifications / compositor
!.config/dunst/
!.config/dunst/**
!.config/picom/
!.config/picom/**

# Desktop environment
!.config/cinnamon/
!.config/cinnamon/**
!.config/dconf/
!.config/dconf/**

# Utilities
!.config/ranger/
!.config/ranger/**
!.config/tmux/
!.config/tmux/**
!.config/albert/
!.config/albert/**
!.config/karabiner/
!.config/karabiner/**
!.config/htop/
!.config/htop/**
!.config/betterlockscreen/
!.config/betterlockscreen/**

# Apps
!.config/vlc/
!.config/vlc/vlcrc
# vlc-qt-interface.conf contains recent file paths and window geometry — don't track
!.config/cava/
!.config/cava/**
!.config/glava/
!.config/glava/**
!.config/conky/
!.config/conky/**
!.config/neofetch/
!.config/neofetch/**
!.config/nvidia/
!.config/nvidia/**
!.config/rstudio/
!.config/rstudio/**
!.config/zathura/
!.config/zathura/**
!.config/texstudio/
!.config/texstudio/**
!.config/libreoffice/
!.config/libreoffice/**
!.config/composer/
!.config/composer/**
!.config/wget/
!.config/wget/**

# Icons / dictionaries
!.config/icons/
!.config/icons/**
!.config/Dictionary/
!.config/Dictionary/**

# =============================================================================
# .local/ — un-ignore tracked subdirs
# =============================================================================
!.local/
.local/*

!.local/README.md
!.local/scripts/
!.local/scripts/**
!.local/etc/
!.local/etc/**
!.local/LibreOfficePluggins/
!.local/LibreOfficePluggins/**
!.local/Mini/
!.local/Mini/**
!.local/xdg/
!.local/xdg/**

!.local/share/
.local/share/*
!.local/share/fonts/
!.local/share/fonts/**
.local/share/fonts/**/.uuid
!.local/share/icons/
!.local/share/icons/**
!.local/share/nvim/
!.local/share/nvim/**
.local/share/nvim/.netrwhist
!.local/share/xfce4/
!.local/share/xfce4/**
!.local/share/composer/
!.local/share/composer/**
!.local/share/man/
!.local/share/man/**
!.local/share/firefox_shortcuts.md

# =============================================================================
# Noise — auto-generated files that should never be tracked
# =============================================================================

# macOS metadata
.DS_Store
**/.DS_Store

# npm man pages auto-installed into .local/share/man
.local/share/man/man1/npm-*.1

# iterm2 runtime data (not config)
.config/iterm2/AppSupport/

# kitty bad XDG path written by app
.config/kitty/$XDG_DATA_HOME/

# emacs init.el with bad path suffix written by app
.config/my_emacs/init.el ~/

# =============================================================================
# Build artifacts inside tracked dirs
# =============================================================================

# Xmonad
.xmonad/xmonad-x86_64-linux
.xmonad/xmonad.errors
.xmonad/*.hi
.xmonad/*.o
.xmonad/build-x86_64-linux/

# Vim (plugin dirs installed by package managers)
.vim/autoload/
.vim/plugged/
.vim/spell/
.vim/cache/
.vim/theme

# Antigen runtime
.config/antigen/bundles/
.config/antigen/init.zsh
.config/antigen/init.zsh.zwc
.config/antigen/.zcompdump*
.config/antigen/debug.log
.config/antigen/.resources
.config/antigen/revert-info

# Zsh runtime
.config/zsh/.zcompdump*
.config/zsh/.zsh_history
.config/zsh/.zshrc.zwc
.config/zsh/.zsh_sessions/

# Nvim plugin dirs
.config/nvim/autoload/
.config/nvim/plugged/

# Tmux plugins (installed by tpm, except tpm itself which is a submodule)
.config/tmux/plugins/tmux-battery/
.config/tmux/plugins/tmux-continuum/
.config/tmux/plugins/tmux-pain-control/
.config/tmux/plugins/tmux-prefix-highlight/
.config/tmux/plugins/tmux-resurrect/
.config/tmux/plugins/tmux-sensible/

# Emacs
.config/my_emacs/eln-cache/
.config/my_emacs/elpa/
.config/my_emacs/.last-package-update-day
.config/chemacs/profile

# Texstudio runtime
.config/texstudio/templates/
.config/texstudio/macro/
.config/texstudio/completion/
.config/texstudio/lastSession.txss
.config/texstudio/lastSession.txss2
.config/texstudio/packageCache.dat
.config/texstudio/template_resources.xml
.config/texstudio/wordCount.usage
# texstudio.ini holds recent-files/last-document with absolute per-user paths;
# cache/ holds per-document JSON also with absolute paths
.config/texstudio/cache/
.config/texstudio/texstudio.ini

# LibreOffice runtime
.config/libreoffice/4/user/GraphicsRenderTests.log
.config/libreoffice/4/user/autotext/
.config/libreoffice/4/user/basic/
.config/libreoffice/4/user/config/javasettings_Linux_X86_64.xml
.config/libreoffice/4/user/database/
.config/libreoffice/4/user/extensions/
.config/libreoffice/4/user/gallery/
.config/libreoffice/4/user/pack/
.config/libreoffice/4/user/registrymodifications.xcu
.config/libreoffice/4/user/uno_packages/
.config/libreoffice/4/cache/

# Sublime Text runtime
.config/sublime-text-3/Installed Packages/
.config/sublime-text-3/Local/
.config/sublime-text-3/Packages/SublimeCodeIntel/

# Albert runtime
.config/albert/core.db
.config/albert/org.albert*
.config/albert/last_used_version

# Ranger runtime
.config/ranger/plugins/__init__.py
.config/ranger/plugins/__pycache__/

# Cinnamon runtime
.cinnamon/spices.cache
# Cinnamon dconf dumps regenerate on every login with absolute /home/<user>/ paths
.cinnamon/backgrounds/user-folders.lst
.config/cinnamon/dark/gnome.dconf
.config/cinnamon/light/gnome.dconf

# Distro (generated by bootstrap scripts)
.config/distro
