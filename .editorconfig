# EditorConfig – https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{json,toml}]
indent_size = 2

[*.{vim,vimrc}]
indent_size = 4

[*.lua]
indent_size = 2

[*.hs]
indent_size = 4

[*.el]
indent_size = 2

[*.conf]
indent_size = 4
