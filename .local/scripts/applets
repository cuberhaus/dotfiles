#!/usr/bin/env bash
# Author: https://github.com/cuberhaus

echo "Do you want to install cinnamon applets? [y/n]"
read -r install
if [[ "$install" == y ]]; then
    dest="$HOME/.local/share/cinnamon/applets"
    mkdir -p "$dest"
    cd "$dest" || exit

    urls=(
        "https://cinnamon-spices.linuxmint.com/files/applets/SpicesUpdate@claudiux.zip"
        "https://cinnamon-spices.linuxmint.com/files/applets/clean-show-desktop@filipetorresbr.zip"
        "https://cinnamon-spices.linuxmint.com/files/applets/weather@mockturtl.zip"
        "https://cinnamon-spices.linuxmint.com/files/applets/color-picker@fmete.zip"
        "https://cinnamon-spices.linuxmint.com/files/applets/show-hide-applets@mohammad-sn.zip"
        "https://cinnamon-spices.linuxmint.com/files/applets/force-quit@cinnamon.org.zip"
        "https://cinnamon-spices.linuxmint.com/files/applets/betterlock.zip"
        "https://cinnamon-spices.linuxmint.com/files/applets/Cinnamenu@json.zip"
        "https://cinnamon-spices.linuxmint.com/files/desklets/calendar@deeppradhan.zip"
        "https://cinnamon-spices.linuxmint.com/files/desklets/diskspace@schorschii.zip"
    )

    echo "Downloading applets in parallel..."
    pids=()
    files=()
    for url in "${urls[@]}"; do
        file="${url##*/}"
        wget -q "$url" -O "$file" &
        pids+=($!)
        files+=("$file")
    done

    failures=0
    for i in "${!pids[@]}"; do
        if wait "${pids[$i]}"; then
            unzip -qo "${files[$i]}"
        else
            echo "Failed to download ${files[$i]}"
            ((failures++)) || true
        fi
    done
    if [ "$failures" -gt 0 ]; then
        echo "$failures download(s) failed"
    fi
fi
