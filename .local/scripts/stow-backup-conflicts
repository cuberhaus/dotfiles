#!/usr/bin/env bash
# stow-backup-conflicts — detect stow conflicts and back them up
#
# Usage: stow-backup-conflicts [backup-dir]
#
# Runs a stow dry-run, parses conflicts, and moves each conflicting file
# into a timestamped backup folder.  Exits 0 if there were no conflicts
# or all conflicts were backed up successfully.
set -euo pipefail

# ---------------------------------------------------------------------------
# Colours
# ---------------------------------------------------------------------------
info()  { printf '\033[1;34m[INFO]\033[0m  %s\n' "$*"; }
warn()  { printf '\033[1;33m[WARN]\033[0m  %s\n' "$*"; }
ok()    { printf '\033[1;32m[OK]\033[0m    %s\n' "$*"; }

# ---------------------------------------------------------------------------
# Paths — same logic the Makefile uses
# ---------------------------------------------------------------------------
STOW_DIR="$(cd "$(dirname "$0")/../.." && pwd)"          # repo root (dotfiles)
PARENT_DIR="$(dirname "$STOW_DIR")"                      # parent of repo
PKG_NAME="$(basename "$STOW_DIR")"                       # e.g. "dotfiles"
TARGET="${HOME}"

BACKUP_ROOT="${1:-$HOME/.dotfiles-backup}"
BACKUP_DIR="$BACKUP_ROOT/$(date '+%Y-%m-%d_%H%M%S')"

# ---------------------------------------------------------------------------
# Detect conflicts via stow dry-run
# ---------------------------------------------------------------------------
conflicts=()

while IFS= read -r line; do
    # Lines look like:
    #   * existing target is neither a link nor a directory: .bashrc
    if [[ "$line" =~ ^\*\ existing\ target\ is\ neither\ a\ link\ nor\ a\ directory:\ (.+)$ ]]; then
        conflicts+=("${BASH_REMATCH[1]}")
    fi
done < <(stow -n -t "$TARGET" -d "$PARENT_DIR" "$PKG_NAME" 2>&1 | sed 's/^[[:space:]]*//')

# ---------------------------------------------------------------------------
# Back up conflicting files
# ---------------------------------------------------------------------------
if (( ${#conflicts[@]} == 0 )); then
    ok "No stow conflicts found."
    exit 0
fi

info "Found ${#conflicts[@]} conflict(s). Backing up to $BACKUP_DIR"
mkdir -p "$BACKUP_DIR"

for rel in "${conflicts[@]}"; do
    src="$TARGET/$rel"
    dest="$BACKUP_DIR/$rel"

    if [ ! -e "$src" ]; then
        warn "Conflict reported but file missing: $rel (skipping)"
        continue
    fi

    mkdir -p "$(dirname "$dest")"
    mv -v "$src" "$dest"
done

ok "All conflicts backed up to $BACKUP_DIR"
