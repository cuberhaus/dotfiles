#!/usr/bin/env bash
# stow-backup-conflicts — detect stow conflicts and back them up
#
# Usage: stow-backup-conflicts [--dry-run] [backup-dir]
#
# Runs a stow dry-run, parses conflicts, and moves each conflicting file
# into a timestamped backup folder.  Exits 0 if there were no conflicts
# or all conflicts were backed up successfully.
set -euo pipefail

# ---------------------------------------------------------------------------
# Colours
# ---------------------------------------------------------------------------
info()  { printf '\033[1;34m[INFO]\033[0m  %s\n' "$*"; }
warn()  { printf '\033[1;33m[WARN]\033[0m  %s\n' "$*"; }
ok()    { printf '\033[1;32m[OK]\033[0m    %s\n' "$*"; }

# ---------------------------------------------------------------------------
# Paths — same logic the Makefile uses
# ---------------------------------------------------------------------------
STOW_DIR="$(cd "$(dirname "$0")/../.." && pwd)"          # repo root (dotfiles)
PARENT_DIR="$(dirname "$STOW_DIR")"                      # parent of repo
PKG_NAME="$(basename "$STOW_DIR")"                       # e.g. "dotfiles"
TARGET="${HOME}"

BACKUP_ROOT="${1:-$HOME/.dotfiles-backup}"
BACKUP_DIR="$BACKUP_ROOT/$(date '+%Y-%m-%d_%H%M%S')"
DRY_RUN=false

if [ "${1:-}" = "--dry-run" ]; then
    DRY_RUN=true
    BACKUP_ROOT="${2:-$HOME/.dotfiles-backup}"
    BACKUP_DIR="$BACKUP_ROOT/$(date '+%Y-%m-%d_%H%M%S')"
fi

# ---------------------------------------------------------------------------
# Detect conflicts via stow dry-run
# ---------------------------------------------------------------------------
conflicts=()

# A plain file standing in the way is worded differently by Stow version:
#   Stow 2.3 and earlier:  * existing target is neither a link nor a directory: .bashrc
#   Stow 2.4 and later:    * cannot stow ../dotfiles/.bashrc over existing target .bashrc since neither a link nor a directory and --adopt not specified
# Both capture the path relative to the target directory as group 1.
legacy_conflict='^\* existing target is neither a link nor a directory: (.+)$'
current_conflict='^\* cannot stow .+ over existing target (.+) since neither a link nor a directory and --adopt not specified$'

while IFS= read -r line; do
    if [[ "$line" =~ $legacy_conflict ]] || [[ "$line" =~ $current_conflict ]]; then
        conflicts+=("${BASH_REMATCH[1]}")
    fi
done < <(stow -n -t "$TARGET" -d "$PARENT_DIR" "$PKG_NAME" 2>&1 | sed 's/^[[:space:]]*//')

# ---------------------------------------------------------------------------
# Back up conflicting files
# ---------------------------------------------------------------------------
if (( ${#conflicts[@]} == 0 )); then
    ok "No stow conflicts found."
    exit 0
fi

if [ "$DRY_RUN" = true ]; then
    info "Found ${#conflicts[@]} conflict(s). Would back up to $BACKUP_DIR"
else
    info "Found ${#conflicts[@]} conflict(s). Backing up to $BACKUP_DIR"
    mkdir -p "$BACKUP_DIR"
fi

for rel in "${conflicts[@]}"; do
    src="$TARGET/$rel"
    dest="$BACKUP_DIR/$rel"

    if [ ! -e "$src" ]; then
        warn "Conflict reported but file missing: $rel (skipping)"
        continue
    fi

    if [ "$DRY_RUN" = true ]; then
        info "  Would move $src to $dest"
        continue
    fi

    mkdir -p "$(dirname "$dest")"
    mv -v "$src" "$dest"
done

if [ "$DRY_RUN" = true ]; then
    ok "No files were moved."
else
    ok "All conflicts backed up to $BACKUP_DIR"
fi
