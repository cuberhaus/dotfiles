#! /usr/bin/env bash
# Ubuntu bootstrap UNINSTALL functions
# Author: https://github.com/cuberhaus

apt_remove="sudo apt-get remove --purge -y"
apt_autoremove="sudo apt-get autoremove -y"

###############################################################
# => Base packages uninstall
###############################################################
base_uninstall() {
    info "Uninstalling base packages..."

    rclone_drive_mount_uninstall || true

    ubuntu_cli_base_uninstall
    ubuntu_python_uninstall

    $apt_remove autoconf automake file fonts-powerline gnome-shell inkscape \
        laptop-detect libgtk-3-dev nodejs npm optipng pkg-config ruby-dev \
        samba-common-bin sassc subversion yarn || true

    git config --global --unset credential.helper || true
}

###############################################################
# => Ubuntu GUI packages uninstall
###############################################################
ubuntu_gui_uninstall() {
    info "Uninstalling Ubuntu GUI packages..."

    ubuntu_desktop_base_uninstall

    $apt_remove lxappearance arc-theme audacity calibre \
        cpu-checker qemu-kvm libvirt-daemon-system libvirt-clients bridge-utils \
        gnome-screensaver gparted pavucontrol timeshift \
        transmission r-base cursor antigravity rstudio || true

    ide_apt_sources_uninstall cursor antigravity

    ubuntu_gnome_desktop_uninstall

    common_ai_tools_uninstall
}


###############################################################
# => kondo uninstall
###############################################################
# Removes the binary that kondo_install put in /usr/local/bin.
kondo_uninstall() {
    info "Uninstalling kondo..."
    sudo rm -f /usr/local/bin/kondo || true
}

###############################################################
# => Snaps uninstall
###############################################################
snaps_uninstall() {
    info "Uninstalling snaps..."

    common_snaps_uninstall
    sudo snap remove code 2>/dev/null || true
    sudo snap remove intellij-idea-professional 2>/dev/null || true
    sudo snap remove pycharm-professional 2>/dev/null || true
    sudo snap remove skype 2>/dev/null || true
    sudo snap remove slack 2>/dev/null || true
    sudo snap remove sublime-merge 2>/dev/null || true
}

###############################################################
# => Emacs uninstall
###############################################################
emacs_uninstall() {
    info "Uninstalling Emacs..."

    $apt_remove emacs-gtk tar clang libtool || true

    rm -rf "$HOME/.emacs.d" 2>/dev/null || true
    rm -rf "$HOME/.config/doom-emacs" 2>/dev/null || true
    rm -f "$HOME/.config/chemacs/profile" 2>/dev/null || true
}

###############################################################
# => Vim/neovim uninstall
###############################################################
vim_uninstall() {
    info "Uninstalling vim/neovim extras..."

    sudo npm uninstall -g neovim 2>/dev/null || true
    sudo gem uninstall neovim 2>/dev/null || true
}

###############################################################
# => Homebrew uninstall
###############################################################
brew_uninstall() {
    if ! command -v brew &>/dev/null; then
        info "Homebrew not found, skipping."
        return
    fi

    info "Uninstalling Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/uninstall.sh)" || true
}

###############################################################
# => Cleanup
###############################################################
cleanup() {
    info "Running apt cleanup..."
    sudo apt-get update
    $apt_autoremove
}
