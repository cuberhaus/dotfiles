#! /usr/bin/env bash
# Author: https://github.com/cuberhaus
set -euo pipefail

### VARIABLES
bootstrap_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_ROOT="$(cd "$bootstrap_dir/../../.." && pwd)"
export DOTFILES_ROOT
source "$bootstrap_dir/base_functions"
source "$bootstrap_dir/ubuntu_functions"
parse_bootstrap_args "$@"
configure_dual_boot_utc_rtc

### INSTALLATION
info "Updating system..."
sudo apt-get update && sudo apt-get full-upgrade -y

bootstrap_stow_checkout ubuntu

install_preparation

echo "#! /bin/sh
export DISTRO=ubuntu" > "$HOME/.config/distro"

configure_inotify_watches

### ONLY CHANGE FROM HERE ON
base_install
sops_install

#albert_install
#bloat_install
emacs_install
#steam_install

clone_repos
chrome_install
#i3_install # Installing i3 requires manual input
snaps_install
ubuntu_install
# OpenLogi comes from GitHub releases, so the network or a changed release layout can break it;
# that must not abort provisioning.
openlogi_install ||
    warn "OpenLogi setup failed; rerun it with: bash -c 'source ~/.local/scripts/bootstrap/base_functions; source ~/.local/scripts/bootstrap/ubuntu_functions; openlogi_install'"
obsidian_vault_install
nvidia_display_config
# The installer skips machines that are not supported ASUS laptops. It needs the
# network and a few minutes of compiling, so a failure must not abort provisioning.
asusctl_install ||
    warn "asusctl setup failed; rerun it with: make repair REPAIR=asusctl PROFILE=ubuntu"
# Skipped unless asusctl is installed and the keyboard supports the effect.
asusctl_lighting ||
    warn "Keyboard lighting failed; rerun it with: make repair REPAIR=asusctl-lighting"
ai_tools_install
vim_install
if [ "$(basename "$SHELL")" != "zsh" ]; then
    chsh -s "$(which zsh)"                  # Change default shell to zsh
fi

apply_skip_worktree
info "Bootstrap complete!"
