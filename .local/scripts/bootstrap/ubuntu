#! /usr/bin/env bash
# Author: https://github.com/cuberhaus
set -euo pipefail

### VARIABLES
bootstrap_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_ROOT="$(cd -P "$bootstrap_dir/../../.." && pwd)"
export DOTFILES_ROOT
source "$bootstrap_dir/base_functions"
source "$bootstrap_dir/ubuntu_functions"
parse_bootstrap_args "$@"
configure_dual_boot_utc_rtc

### INSTALLATION
info "Updating system..."
sudo apt-get update && sudo apt-get full-upgrade -y

bootstrap_stow_checkout ubuntu

install_preparation

echo "#! /bin/sh
export DISTRO=ubuntu" > "$HOME/.config/distro"

configure_inotify_watches

### ONLY CHANGE FROM HERE ON
base_install
# LanguageTool (grammar checker for Emacs and TeXstudio) is a 240 MB download, so a failure must not abort provisioning.
languagetool_install ||
    warn "LanguageTool setup failed; rerun it with: bash -c 'source ~/.local/scripts/bootstrap/base_functions; languagetool_install'"
sops_install

#albert_install
#bloat_install
emacs_install
#steam_install

clone_repos
chrome_install
#i3_install # Installing i3 requires manual input
snaps_install
ubuntu_install
# Only writes one file under ~/.config/autostart; the package itself comes from ubuntu_install.
caffeine_indicator_autostart_install ||
    warn "Caffeine indicator autostart failed; rerun it with: bash -c 'source ~/.local/scripts/bootstrap/base_functions; caffeine_indicator_autostart_install'"
# Only writes one entry under ~/.local/share/applications and one default in ~/.config/mimeapps.list;
# Nautilus itself comes from the Ubuntu desktop, and a machine without it is skipped.
smb_scheme_handler_install ||
    warn "smb:// link handler failed; rerun it with: bash -c 'source ~/.local/scripts/bootstrap/base_functions; smb_scheme_handler_install'"
# Adds <Super><Shift>s to GNOME Shell's interactive screenshot shortcut for keyboards without Print.
gnome_screenshot_shortcut_install ||
    warn "GNOME screenshot shortcut failed; rerun it with: bash -c 'source ~/.local/scripts/bootstrap/base_functions; gnome_screenshot_shortcut_install'"
# Configures Spanish ('es') layout and caps:swapescape in GNOME and XWayland.
gnome_keyboard_layout_install ||
    warn "GNOME keyboard layout failed; rerun it with: bash -c 'source ~/.local/scripts/bootstrap/base_functions; gnome_keyboard_layout_install'"
# OpenLogi comes from GitHub releases, so the network or a changed release layout can break it;
# that must not abort provisioning.
openlogi_install ||
    warn "OpenLogi setup failed; rerun it with: bash -c 'source ~/.local/scripts/bootstrap/base_functions; source ~/.local/scripts/bootstrap/ubuntu_functions; openlogi_install'"
# kondo comes from a GitHub release, so the network or a changed release layout can break it;
# that must not abort provisioning.
kondo_install ||
    warn "kondo setup failed; rerun it with: bash -c 'source ~/.local/scripts/bootstrap/base_functions; source ~/.local/scripts/bootstrap/ubuntu_functions; kondo_install'"
obsidian_vault_install
rclone_drive_mount_install ||
    warn "Google Drive mount setup failed; rerun it with: make repair REPAIR=drive-mount"
thunderbird_restore ||
    warn "Thunderbird profile restore failed; rerun it with: rclonepull_thunderbird"
nvidia_display_config
# The installer skips machines that are not supported ASUS laptops. It needs the
# network and a few minutes of compiling, so a failure must not abort provisioning.
asusctl_install ||
    warn "asusctl setup failed; rerun it with: make repair REPAIR=asusctl PROFILE=ubuntu"
# Skipped unless asusctl is installed and the keyboard supports the effect.
asusctl_lighting ||
    warn "Keyboard lighting failed; rerun it with: make repair REPAIR=asusctl-lighting"
# The free DaVinci Resolve needs a ZIP that only you can download (Blackmagic asks for a
# registration), and its installer asks questions. The step skips machines without an NVIDIA
# GPU, and a missing ZIP must not abort provisioning.
davinci_resolve_install ||
    warn "DaVinci Resolve setup failed; rerun it with: make repair REPAIR=davinci-resolve"
ai_tools_install
vim_install
if [ "$(basename "$SHELL")" != "zsh" ]; then
    chsh -s "$(which zsh)"                  # Change default shell to zsh
fi

apply_skip_worktree
info "Bootstrap complete!"
