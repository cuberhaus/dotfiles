ensure_virtualization_groups() {
    local user group
    user="$(id -un)"
    for group in libvirt kvm; do
        if ! id -nG "$user" | tr ' ' '\n' | grep -Fxq "$group"; then
            sudo usermod -aG "$group" "$user"
        fi
    done
}

ubuntu_install() {
    ubuntu_desktop_base_install

    local packages=(
        lxappearance            # Theme
        arc-theme
        audacity
        calibre
        cpu-checker qemu-kvm libvirt-daemon-system libvirt-clients bridge-utils
        gnome-screensaver       # Screensaver
        gparted                 # Manage partitions
        pavucontrol             # Audio
        timeshift               # Backups
        transmission            # A simpler Torrent client
        r-base
    )
    $apt "${packages[@]}"

    # Parallel: download RStudio + gnome-terminal theme at the same time
    local tmp_dir
    tmp_dir="$(mktemp -d)" || return 1
    chmod 755 "$tmp_dir"        # apt reads the file as its unprivileged _apt user
    local rstudio_deb="$tmp_dir/rstudio-latest-amd64.deb"
    local theme_script="$tmp_dir/one-dark-gnome.sh"

    if ! command -v rstudio &>/dev/null; then
        wget -qO "$rstudio_deb" https://rstudio.org/download/latest/stable/desktop/noble/rstudio-latest-amd64.deb &
        local pid_rstudio=$!
    fi

    # One dark profile for gnome-terminal
    # https://github.com/denysdovhan/one-gnome-terminal
    curl -fsSL https://raw.githubusercontent.com/denysdovhan/gnome-terminal-one/master/one-dark.sh \
        -o "$theme_script" &
    local pid_theme=$!

    if [ -n "${pid_rstudio:-}" ]; then
        if wait "$pid_rstudio"; then
            chmod 644 "$rstudio_deb"
            sudo apt-get install -y "$rstudio_deb" ||
                warn "Failed to install RStudio"
        else
            warn "Failed to download RStudio"
        fi
    else
        info "RStudio already installed, skipping."
    fi

    if wait "$pid_theme" && [ -f "$theme_script" ]; then
        bash "$theme_script"
    else
        warn "Failed to download gnome-terminal theme"
    fi
    rm -rf "$tmp_dir"

    ensure_virtualization_groups
}


# kondo removes rebuildable folders (node_modules, target, build, ...) from project directories.
# Ubuntu does not package it and its releases carry no checksum file, so the SHA-256 of each
# build is pinned below; GitHub shows the same value as the asset's digest. Change the version
# and both digests together, and the copies in tests/test_kondo_install.sh with them.
# kondo 0.9 has no --version flag, so the skip message below names no version.
# Callers run this as `kondo_install ||`, where the shell ignores `set -e`, so every step is
# chained and a failure warns and returns 1.
kondo_install () {
    if command -v kondo &>/dev/null; then
        info "kondo already installed, skipping."
        return
    fi

    local version="0.9"
    local releases="https://github.com/tbillington/kondo/releases/download/v${version}"
    local -a fetch=(curl --proto '=https' --proto-redir '=https' --tlsv1.2 --fail --location
        --silent --show-error --retry 3 --retry-connrefused)
    local arch target digest work asset

    arch="$(dpkg --print-architecture)"
    case "$arch" in
        amd64)
            target="x86_64-unknown-linux-gnu"
            digest="56f89890fd4e16cf5e11bb212bb812b60a8319dabfb05fabaf80c6c8b5133b65"
            ;;
        arm64)
            target="aarch64-unknown-linux-gnu"
            digest="531cfc381e851300878e20f77ebd58724ddc28ecf5e48bec654f630f0bfc7fb0"
            ;;
        *)
            warn "kondo publishes amd64 and arm64 Linux builds, not $arch."
            return 1
            ;;
    esac

    asset="kondo-${target}.tar.gz"
    work="$(mktemp -d)" || return 1
    info "Installing kondo ${version}..."
    if "${fetch[@]}" --output "$work/$asset" "$releases/$asset" &&
        printf '%s  %s\n' "$digest" "$asset" > "$work/$asset.sha256" &&
        (cd "$work" && sha256sum --check --strict "$asset.sha256") &&
        tar -xzf "$work/$asset" -C "$work" kondo &&
        sudo install -m 0755 "$work/kondo" /usr/local/bin/kondo; then
        rm -rf "$work"
    else
        rm -rf "$work"
        warn "kondo ${version} was not installed: the download, its checksum, or the install failed."
        return 1
    fi
    info "kondo ${version} installed."
}

emacs_install () {
    $apt emacs-gtk              # Emacs
    # Doom optional dependencies (git, ripgrep, fd-find come from ubuntu_cli_base_install)
    $apt tar clang libtool      # libtool is needed for vterm-module compilation

    # Chemacs installation to manage doom and personal
    if [ ! -d ~/.emacs.d ] || [ ! -f ~/.emacs.d/chemacs.el ]; then
        [ -f ~/.emacs ] && mv ~/.emacs ~/.emacs.bak
        [ -d ~/.emacs.d ] && mv ~/.emacs.d ~/.emacs.default
        git clone https://github.com/plexus/chemacs2.git ~/.emacs.d
    else
        info "Chemacs2 already installed, skipping."
    fi

    mkdir -p "$HOME/.config/chemacs"
    printf 'default\n' > "$HOME/.config/chemacs/profile"

    # systemctl --user enable emacs # this enables emacs as a daemon

    if [ ! -d ~/.config/doom-emacs ]; then
        git clone https://github.com/hlissner/doom-emacs ~/.config/doom-emacs
        ~/.config/doom-emacs/bin/doom install
    else
        info "Doom Emacs already installed, skipping."
    fi
}

