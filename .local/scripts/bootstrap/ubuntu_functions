clone_repos() {
    info "Cloning repos in parallel..."
    mkdir -p "$HOME/repos"
    local repos=(
        "cuberhaus/WinDotfiles"
        "cuberhaus/dev"
        "cuberhaus/TFG"
        "cuberhaus/docs"
    )
    local pids=() names=()
    for repo in "${repos[@]}"; do
        local name="${repo##*/}"
        if [ -d "$HOME/repos/$name" ]; then
            info "$name already exists, skipping"
        else
            git clone "https://github.com/$repo" "$HOME/repos/$name" &
            pids+=($!)
            names+=("$repo")
        fi
    done
    local failures=0
    for i in "${!pids[@]}"; do
        if ! wait "${pids[$i]}"; then
            warn "Failed to clone ${names[$i]}"
            ((failures++)) || true
        fi
    done
    if [ "$failures" -gt 0 ]; then
        warn "$failures repo(s) failed to clone"
    fi
}

