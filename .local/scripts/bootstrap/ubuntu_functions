ai_tools_install() {
    info "Installing AI tools..."

    # ── Apt-repo-based installs ──────────────────────────────────
    # Cursor and Antigravity install from their vendor apt repositories, so the
    # weekly full-upgrade keeps them current (VS Code is a snap on this profile).
    # The sources are re-asserted on every run because Ubuntu release upgrades
    # disable them.
    ide_apt_sources_ensure cursor antigravity ||
        warn "Some IDE apt sources are not configured; fix the cause, then run 'make repair REPAIR=ide-repos'."

    common_ai_tools_install
}

vim_install() {
    info "Installing vim/neovim plugins..."
    # A failed build must not skip the language providers below; rerun make repair REPAIR=vim later.
    vim_plugins_install ||
        warn "Vim/Neovim plugin setup failed; rerun it with: make repair REPAIR=vim PROFILE=ubuntu"

    # Parallel language provider installs (npm and gem are independent; python3-pynvim is installed by apt)
    sudo npm install -g neovim &
    local pid_npm=$!

    sudo gem install neovim &
    local pid_gem=$!

    wait "$pid_npm" || warn "npm neovim install had errors"
    wait "$pid_gem" || warn "gem neovim install had errors"
}

clone_repos() {
    info "Cloning repos in parallel..."
    mkdir -p "$HOME/repos"
    local repos=(
        "cuberhaus/WinDotfiles"
        "cuberhaus/dev"
        "cuberhaus/TFG"
        "cuberhaus/docs"
    )
    local pids=() names=()
    for repo in "${repos[@]}"; do
        local name="${repo##*/}"
        if [ -d "$HOME/repos/$name" ]; then
            info "$name already exists, skipping"
        else
            git clone "https://github.com/$repo" "$HOME/repos/$name" &
            pids+=($!)
            names+=("$repo")
        fi
    done
    local failures=0
    for i in "${!pids[@]}"; do
        if ! wait "${pids[$i]}"; then
            warn "Failed to clone ${names[$i]}"
            ((failures++)) || true
        fi
    done
    if [ "$failures" -gt 0 ]; then
        warn "$failures repo(s) failed to clone"
    fi
}
