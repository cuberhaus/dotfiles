# OpenLogi (Logitech Options+ alternative for Bolt and Unifying receivers) has no apt repository:
# it ships as .deb files on GitHub releases, each signed with minisign. The file must verify
# against the vendor key below before sudo opens it. The key is the trust anchor in
# packaging/linux/install.sh of https://github.com/AprilNEA/OpenLogi; check it there before
# changing it. Installs the latest stable release, or OPENLOGI_VERSION (for example 0.8.11).
# Callers run this as `openlogi_install ||`, where the shell ignores `set -e`, so every step is
# chained and a failure warns and returns 1.
openlogi_install () {
    if command -v openlogi-agent &>/dev/null; then
        info "OpenLogi already installed, skipping."
        return
    fi

    local releases="https://github.com/AprilNEA/OpenLogi/releases"
    local minisign_key="RWRRkFtw+rqkvTlCTGKUszSE5dX9CK1teaQD45jO4P9rYlWLO4/nHVUF" # gitleaks:allow (public key)
    local tag_pattern='^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?$'
    local -a fetch=(curl --proto '=https' --proto-redir '=https' --tlsv1.2 --fail --location
        --silent --show-error --retry 3 --retry-connrefused)
    local arch tag latest_url work package

    arch="$(dpkg --print-architecture)"
    case "$arch" in
        amd64|arm64) ;;
        *)
            warn "OpenLogi publishes amd64 and arm64 packages, not $arch."
            return 1
            ;;
    esac

    if [ -n "${OPENLOGI_VERSION:-}" ]; then
        tag="v${OPENLOGI_VERSION#v}"
    else
        latest_url="$("${fetch[@]}" --output /dev/null --write-out '%{url_effective}' "$releases/latest")" || {
            warn "Could not resolve the latest OpenLogi release."
            return 1
        }
        tag="${latest_url#"$releases/tag/"}"
    fi
    if ! [[ "$tag" =~ $tag_pattern ]]; then
        warn "Refusing the OpenLogi release tag [$tag]."
        return 1
    fi

    $apt minisign               # Verifies the release signature
    if ! command -v minisign &>/dev/null; then
        warn "minisign could not be installed, so the OpenLogi package cannot be verified."
        return 1
    fi

    package="openlogi-${tag}-linux-${arch}.deb"
    work="$(mktemp -d)" || return 1
    chmod 755 "$work"           # apt reads the file as its unprivileged _apt user
    local openlogi_deb="$work/$package"
    info "Installing OpenLogi $tag..."
    if "${fetch[@]}" --output "$openlogi_deb" "$releases/download/$tag/$package" &&
        "${fetch[@]}" --output "$openlogi_deb.minisig" "$releases/download/$tag/$package.minisig" &&
        minisign -V -P "$minisign_key" -m "$openlogi_deb" -x "$openlogi_deb.minisig" &&
        sudo apt-get install -y "$openlogi_deb"; then
        rm -rf "$work"
    else
        rm -rf "$work"
        warn "OpenLogi $tag was not installed: the download, its signature check, or apt failed."
        return 1
    fi

    # The package ships a systemd user unit for the agent that owns the receiver.
    if systemctl --user enable --now openlogi-agent.service; then
        info "OpenLogi agent started."
    else
        warn "Start the OpenLogi agent from a graphical session: systemctl --user enable --now openlogi-agent.service"
    fi
    info "Replug the Logitech receiver so the new udev rules apply, then open OpenLogi."
}

# kondo removes rebuildable folders (node_modules, target, build, ...) from project directories.
# Ubuntu does not package it and its releases carry no checksum file, so the SHA-256 of each
# build is pinned below; GitHub shows the same value as the asset's digest. Change the version
# and both digests together, and the copies in tests/test_kondo_install.sh with them.
# kondo 0.9 has no --version flag, so the skip message below names no version.
# Callers run this as `kondo_install ||`, where the shell ignores `set -e`, so every step is
# chained and a failure warns and returns 1.
kondo_install () {
    if command -v kondo &>/dev/null; then
        info "kondo already installed, skipping."
        return
    fi

    local version="0.9"
    local releases="https://github.com/tbillington/kondo/releases/download/v${version}"
    local -a fetch=(curl --proto '=https' --proto-redir '=https' --tlsv1.2 --fail --location
        --silent --show-error --retry 3 --retry-connrefused)
    local arch target digest work asset

    arch="$(dpkg --print-architecture)"
    case "$arch" in
        amd64)
            target="x86_64-unknown-linux-gnu"
            digest="56f89890fd4e16cf5e11bb212bb812b60a8319dabfb05fabaf80c6c8b5133b65"
            ;;
        arm64)
            target="aarch64-unknown-linux-gnu"
            digest="531cfc381e851300878e20f77ebd58724ddc28ecf5e48bec654f630f0bfc7fb0"
            ;;
        *)
            warn "kondo publishes amd64 and arm64 Linux builds, not $arch."
            return 1
            ;;
    esac

    asset="kondo-${target}.tar.gz"
    work="$(mktemp -d)" || return 1
    info "Installing kondo ${version}..."
    if "${fetch[@]}" --output "$work/$asset" "$releases/$asset" &&
        printf '%s  %s\n' "$digest" "$asset" > "$work/$asset.sha256" &&
        (cd "$work" && sha256sum --check --strict "$asset.sha256") &&
        tar -xzf "$work/$asset" -C "$work" kondo &&
        sudo install -m 0755 "$work/kondo" /usr/local/bin/kondo; then
        rm -rf "$work"
    else
        rm -rf "$work"
        warn "kondo ${version} was not installed: the download, its checksum, or the install failed."
        return 1
    fi
    info "kondo ${version} installed."
}

