ai_tools_install() {
    info "Installing AI tools..."
    $apt libfuse2

    # ── Apt-repo-based installs ──────────────────────────────────
    # Cursor and Antigravity install from their vendor apt repositories, so the
    # weekly full-upgrade keeps them current (VS Code is a snap on this profile).
    # The sources are re-asserted on every run because Ubuntu release upgrades
    # disable them.
    ide_apt_sources_ensure cursor antigravity ||
        warn "Some IDE apt sources are not configured; fix the cause, then run 'make repair REPAIR=ide-repos'."

    # Cursor (AI IDE — apt repo; an existing AppImage install is kept as is)
    if ! cursor_is_installed; then
        info "Installing Cursor..."
        $apt cursor
    else
        info "Cursor already installed, skipping."
    fi

    # Antigravity (Google AI IDE — apt repo)
    if ! command -v antigravity &>/dev/null; then
        info "Installing Antigravity..."
        $apt antigravity
    else
        info "Antigravity already installed, skipping."
    fi

    # ── curl|sh installers ───────────────────────────────────────
    # Ollama (local LLM serving)
    ollama_install

    # OpenCode (AI coding agent)
    opencode_install

    # Cursor CLI (`agent`; Cursor's own installer, because the IDE package does not include it)
    cursor_cli_install ||
        warn "Cursor CLI setup failed; rerun it with: bash -c 'source ~/.local/scripts/bootstrap/base_functions; cursor_cli_install'"

    # Pi (AI coding agent)
    pi_cli_install

    # GitHub Copilot CLI (AI coding assistant)
    copilot_cli_install

    # Aider (AI pair programming)
    aider_cli_install
}

vim_install () {
    info "Installing vim/neovim plugins..."
    cd "$HOME" || exit
    vim +PlugInstall +qall
    # A failed build must not skip the language providers below; rerun ycm.sh later.
    bash "$ycm" || warn "YouCompleteMe setup failed; rerun it with: bash $ycm"

    # Parallel language provider installs (npm and gem are independent; python3-pynvim is installed by apt)
    sudo npm install -g neovim &
    local pid_npm=$!

    sudo gem install neovim &
    local pid_gem=$!

    wait "$pid_npm" || warn "npm neovim install had errors"
    wait "$pid_gem" || warn "gem neovim install had errors"
}

