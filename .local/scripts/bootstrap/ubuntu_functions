    $apt pulseaudio-equalizer
    $apt python-dbus 
    $apt rofi 
    $apt udiskie
    $apt xbacklight
    $apt xdotool
    $apt xfce4-clipman
    $apt xss-lock
    $apt yad
    $apt zenity

    # Add current user to group video, type groups to see which groups you are in
    sudo usermod -a -G video "$LOGNAME"
    # Light setup | Enables brightness controls
    if ! command -v light &>/dev/null; then
        cd "$HOME" || exit
        git clone https://github.com/haikarainen/light
        cd "$HOME/light" || exit
        ./autogen.sh
        ./configure && make
        sudo make install
        ./configure --with-udev && make
        sudo make install
        cd "$HOME" || exit
        rm -rf "$HOME/light"
    else
        info "light already installed, skipping."
    fi
}

