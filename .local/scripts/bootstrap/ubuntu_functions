albert_install () {
    if ! command -v albert 2>/dev/null; then
        # Import the signing key into a dedicated keyring (apt-key is deprecated)
        curl -fsSL https://build.opensuse.org/projects/home:manuelschneid3r/public_key \
            | gpg --dearmor \
            | sudo tee /etc/apt/trusted.gpg.d/home-manuelschneid3r.gpg > /dev/null
        echo 'deb [signed-by=/etc/apt/trusted.gpg.d/home-manuelschneid3r.gpg] http://download.opensuse.org/repositories/home:/manuelschneid3r/xUbuntu_20.04/ /' \
            | sudo tee /etc/apt/sources.list.d/home-manuelschneid3r.list
        sudo apt-get update
        sudo apt-get install -y albert
    fi
}

chrome_install () {
    if command -v google-chrome-stable &>/dev/null; then
        info "Google Chrome already installed, skipping."
        return
    fi
    local chrome_deb="/tmp/google-chrome-stable_current_amd64.deb"
    wget -O "$chrome_deb" https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
    sudo apt install -y "$chrome_deb"
    rm -f "$chrome_deb"
}

emacs_install () {
    $apt emacs-gtk              # Emacs
    # Doom
    $apt git ripgrep            # required dependencies
    $apt tar fd-find clang      # optional dependencies
    $apt libtool                # vterm-module compilation

    # Chemacs installation to manage doom and personal
    if [ ! -d ~/.emacs.d ] || [ ! -f ~/.emacs.d/chemacs.el ]; then
        [ -f ~/.emacs ] && mv ~/.emacs ~/.emacs.bak
        [ -d ~/.emacs.d ] && mv ~/.emacs.d ~/.emacs.default
        git clone https://github.com/plexus/chemacs2.git ~/.emacs.d
    else
        info "Chemacs2 already installed, skipping."
    fi

    echo "default" | tee "$HOME/.config/chemacs/profile"

    # systemctl --user enable emacs # this enables emacs as a daemon

    if [ ! -d ~/.config/doom-emacs ]; then
        git clone https://github.com/hlissner/doom-emacs ~/.config/doom-emacs
        ~/.config/doom-emacs/bin/doom install
    else
        info "Doom Emacs already installed, skipping."
    fi
}

i3_install () {
    # Add repository and refresh apt
    sudo add-apt-repository -y ppa:kgilmer/speed-ricer
    sudo apt-get update
    $apt i3-gaps
    # Dependancies
    $apt alsa-utils
    $apt compton 
    $apt conky 
    $apt feh 
    $apt flameshot 
    $apt i3blocks 
    $apt kitty 
    $apt picom
    $apt player-ctl 
    $apt pulseaudio
