ensure_virtualization_groups() {
    local user group
    user="$(id -un)"
    for group in libvirt kvm; do
        if ! id -nG "$user" | tr ' ' '\n' | grep -Fxq "$group"; then
            sudo usermod -aG "$group" "$user"
        fi
    done
}

ubuntu_install() {
    local packages=(
        lxappearance            # Theme
        arc-theme
        audacity
        bleachbit               # Junk and cache cleaner (open source)
        calibre
        cpu-checker qemu-kvm libvirt-daemon-system libvirt-clients bridge-utils
        gnome-screensaver       # Screensaver
        gparted                 # Manage partitions
        pavucontrol             # Audio
        thunderbird             # Email
        timeshift               # Backups
        transmission            # A simpler Torrent client
        vlc                     # Media player
        caffeine                # Prevent screen from going to sleep
        dconf-editor            # Advanced configs
        obs-studio              # Video recording
        r-base
        wireguard-tools         # WireGuard VPN (wg, wg-quick)
        xdotool                 # X11 keyboard and mouse automation
        ydotool                 # Keyboard and mouse automation through /dev/uinput (needs ydotoold)
        qrencode                # Generate QR codes from the terminal
    )
    $apt "${packages[@]}"

    # Parallel: download RStudio + gnome-terminal theme at the same time
    local tmp_dir
    tmp_dir="$(mktemp -d)"
    local rstudio_deb="$tmp_dir/rstudio-latest-amd64.deb"
    local theme_script="$tmp_dir/one-dark-gnome.sh"

    if ! command -v rstudio &>/dev/null; then
        wget -qO "$rstudio_deb" https://rstudio.org/download/latest/stable/desktop/noble/rstudio-latest-amd64.deb &
        local pid_rstudio=$!
    fi

    # One dark profile for gnome-terminal
    # https://github.com/denysdovhan/one-gnome-terminal
    curl -fsSL https://raw.githubusercontent.com/denysdovhan/gnome-terminal-one/master/one-dark.sh \
        -o "$theme_script" &
    local pid_theme=$!

    if [ -n "${pid_rstudio:-}" ]; then
        if wait "$pid_rstudio"; then
            sudo apt-get install -y "$rstudio_deb"
        else
            warn "Failed to download RStudio"
        fi
    else
        info "RStudio already installed, skipping."
    fi

    if wait "$pid_theme" && [ -f "$theme_script" ]; then
        bash "$theme_script"
    else
        warn "Failed to download gnome-terminal theme"
    fi
    rm -rf "$tmp_dir"

    ensure_virtualization_groups
}

