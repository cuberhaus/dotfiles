ai_tools_install() {
    info "Installing AI tools..."
    $apt libfuse2
    mkdir -p "$HOME/Applications"

    # ── Parallel downloads ───────────────────────────────────────
    local pids=() names=()
    local warp_deb="/tmp/warp-terminal.deb"

    # Cursor (AI IDE — AppImage)
    if [ ! -f "$HOME/Applications/cursor.AppImage" ]; then
        info "Downloading Cursor..."
        curl -fsSL "https://www.cursor.com/api/download?platform=linux-x64&releaseTrack=stable" \
            -o "$HOME/Applications/cursor.AppImage" &
        pids+=($!); names+=("Cursor")
    fi

    # Warp (AI terminal — .deb download)
    if ! command -v warp-terminal &>/dev/null; then
        info "Downloading Warp terminal..."
        wget -qO "$warp_deb" "https://app.warp.dev/download?package=deb" &
        pids+=($!); names+=("Warp")
    fi

    # Wait for parallel downloads
    local failures=0
    for i in "${!pids[@]}"; do
        if ! wait "${pids[$i]}"; then
            warn "Failed to download ${names[$i]}"
            ((failures++)) || true
        else
            info "${names[$i]} download complete."
        fi
    done

    # ── Install from downloaded files ────────────────────────────
    if [ -f "$HOME/Applications/cursor.AppImage" ]; then
        chmod +x "$HOME/Applications/cursor.AppImage"
        cat > "$HOME/.local/share/applications/cursor.desktop" <<EOF
[Desktop Entry]
Name=Cursor
Exec=$HOME/Applications/cursor.AppImage --no-sandbox %U
Icon=cursor
Type=Application
Categories=Development;IDE;
StartupWMClass=Cursor
EOF
        info "Cursor installed."
    fi

    if [ -f "$warp_deb" ]; then
        info "Installing Warp terminal..."
        sudo apt-get install -y "$warp_deb"
        rm -f "$warp_deb"
    fi

    # ── Apt-repo-based installs ──────────────────────────────────
    # Antigravity (Google AI IDE — apt repo)
    if ! command -v antigravity &>/dev/null; then
        info "Installing Antigravity..."
        sudo mkdir -p /etc/apt/keyrings
        curl -fsSL https://us-central1-apt.pkg.dev/doc/repo-signing-key.gpg \
            | sudo gpg --dearmor --yes -o /etc/apt/keyrings/antigravity-repo-key.gpg
        echo "deb [signed-by=/etc/apt/keyrings/antigravity-repo-key.gpg] https://us-central1-apt.pkg.dev/projects/antigravity-auto-updater-dev/ antigravity-debian main" \
            | sudo tee /etc/apt/sources.list.d/antigravity.list > /dev/null
        sudo apt-get update
        $apt antigravity
    else
        info "Antigravity already installed, skipping."
    fi

    # ── curl|sh installers ───────────────────────────────────────
    # LM Studio (local LLM runner)
    if ! command -v lms &>/dev/null; then
        info "Installing LM Studio..."
        curl -fsSL https://lmstudio.ai/install.sh | bash
    else
        info "LM Studio already installed, skipping."
    fi

    # Ollama (local LLM serving)
    if ! command -v ollama &>/dev/null; then
        info "Installing Ollama..."
        curl -fsSL https://ollama.com/install.sh | sh
    else
        info "Ollama already installed, skipping."
    fi
}

vim_install () {
    info "Installing vim/neovim plugins..."
    cd "$HOME" || exit
    vim +PlugInstall +qall
    bash "$ycm"

    # Parallel language provider installs (npm, pip, gem are independent)
    sudo npm install -g neovim &
    local pid_npm=$!

    python3 -m pip install --user --upgrade pynvim &
    local pid_pip=$!

    sudo gem install neovim &
    local pid_gem=$!

    wait "$pid_npm" || warn "npm neovim install had errors"
    wait "$pid_pip" || warn "pip pynvim install had errors"
    wait "$pid_gem" || warn "gem neovim install had errors"

    python3 "$HOME/.vim/plugged/YouCompleteMe/install.py"
}

