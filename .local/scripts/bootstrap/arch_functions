git_repos() {
    info "Cloning repos in parallel..."
    mkdir -p "$HOME/repos/"
    cd "$HOME/repos/" || exit
    local pids=() names=()
    local repos=(WinDotfiles docs dev TFG fib)
    for name in "${repos[@]}"; do
        if [ ! -d "$name" ]; then
            git clone "https://github.com/cuberhaus/${name}.git" &
            pids+=($!)
            names+=("$name")
        fi
    done
    local failures=0
    for i in "${!pids[@]}"; do
        if ! wait "${pids[$i]}"; then
            warn "Failed to clone ${names[$i]}"
            ((failures++)) || true
        fi
    done
    if [ "$failures" -gt 0 ]; then
        warn "$failures repo(s) failed to clone"
    fi
}

configure_arch_services() {
    sudo systemctl enable --now org.cups.cupsd.service
    sudo systemctl enable bluetooth.service
    sudo systemctl enable lightdm.service
    sudo systemctl enable systemd-timesyncd.service
    sudo timedatectl set-ntp true
    if systemctl list-unit-files ntpd.service --no-legend 2>/dev/null | grep -q '^ntpd\.service'; then
        sudo systemctl disable --now ntpd.service
    fi
    sudo systemctl enable NetworkManager.service
}

