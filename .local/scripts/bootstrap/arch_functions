ai_tools_install() {
    info "Installing AI tools..."
    mkdir -p "$HOME/Applications"

    # ── Parallel downloads (AppImages) ───────────────────────────
    local pids=() names=()

    # Cursor (AI IDE — AppImage)
    if [ ! -f "$HOME/Applications/cursor.AppImage" ]; then
        info "Downloading Cursor..."
        curl -fsSL "https://www.cursor.com/api/download?platform=linux-x64&releaseTrack=stable" \
            -o "$HOME/Applications/cursor.AppImage" &
        pids+=($!); names+=("Cursor")
    fi

    # Antigravity (Google AI IDE — AppImage)
    if [ ! -f "$HOME/Applications/antigravity.AppImage" ]; then
        info "Downloading Antigravity..."
        curl -fsSL "https://antigravity.dev/api/download?platform=linux-x64" \
            -o "$HOME/Applications/antigravity.AppImage" &
        pids+=($!); names+=("Antigravity")
    fi

    # Wait for parallel downloads
    local failures=0
    for i in "${!pids[@]}"; do
        if ! wait "${pids[$i]}"; then
            warn "Failed to download ${names[$i]}"
            ((failures++)) || true
        else
            info "${names[$i]} download complete."
        fi
    done

    # ── Set up downloaded AppImages ──────────────────────────────
    if [ -f "$HOME/Applications/cursor.AppImage" ]; then
        chmod +x "$HOME/Applications/cursor.AppImage"
        cat > "$HOME/.local/share/applications/cursor.desktop" <<EOF
[Desktop Entry]
Name=Cursor
Exec=$HOME/Applications/cursor.AppImage --no-sandbox %U
Icon=cursor
Type=Application
Categories=Development;IDE;
StartupWMClass=Cursor
EOF
    fi

    if [ -f "$HOME/Applications/antigravity.AppImage" ]; then
        chmod +x "$HOME/Applications/antigravity.AppImage"
        cat > "$HOME/.local/share/applications/antigravity.desktop" <<EOF
[Desktop Entry]
Name=Antigravity
Exec=$HOME/Applications/antigravity.AppImage --no-sandbox %U
Icon=antigravity
Type=Application
Categories=Development;IDE;
StartupWMClass=Antigravity
EOF
    fi

    # ── Sequential installs (yay / curl|sh) ──────────────────────
    # Warp (AI terminal)
    if ! command -v warp-terminal &>/dev/null; then
        info "Installing Warp terminal..."
        $yay warp-terminal-bin
    else
        info "Warp terminal already installed, skipping."
    fi

    # LM Studio (local LLM runner)
    if ! command -v lms &>/dev/null; then
        info "Installing LM Studio..."
        curl -fsSL https://lmstudio.ai/install.sh | bash
    else
        info "LM Studio already installed, skipping."
    fi

    # Ollama (local LLM serving)
    if ! command -v ollama &>/dev/null; then
        info "Installing Ollama..."
        curl -fsSL https://ollama.com/install.sh | sh
    else
        info "Ollama already installed, skipping."
    fi
}

