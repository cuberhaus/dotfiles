# This function enables NaturalScrolling for the touchpad
trackpad_scrolling () {
    local conf="/etc/X11/xorg.conf.d/30-touchpad.conf"
    if [ -f "$conf" ] && grep -q 'NaturalScrolling' "$conf"; then
        info "Touchpad natural scrolling already configured, skipping."
        return
    fi
    sudo mkdir -p /etc/X11/xorg.conf.d
    echo 'Section "InputClass"
    Identifier "libinput touchpad catchall"
    MatchIsTouchpad "on"
    MatchDevicePath "/dev/input/event*"
    Driver "libinput"
    Option "NaturalScrolling" "true"
    EndSection' | sudo tee "$conf" > /dev/null
}

activate_reisub () {
    if grep -q 'kernel.sysrq=1' /etc/sysctl.d/99-sysctl.conf 2>/dev/null; then
        info "REISUB already enabled, skipping."
        return
    fi
    echo kernel.sysrq=1 | sudo tee --append /etc/sysctl.d/99-sysctl.conf
    sudo update-grub
}

