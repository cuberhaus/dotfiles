    $pac "${packages[@]}"

    cd "$HOME" || exit
    vim +PlugInstall +qall
    bash "$scripts/ycm.sh"
    sudo chmod +w "$HOME/.vim/cache/viminfo"

    # Parallel language provider installs (pip, npm, gem are independent)
    (
        $pip wheel
        $pip black
        python3 -m "$pip" --upgrade pynvim
    ) &
    local pid_pip=$!

    (
        npm install neovim
        npm install js-beautify
        npm install remark-cli
