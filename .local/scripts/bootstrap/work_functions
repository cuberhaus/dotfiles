###############################################################
# => Node.js (LTS via NodeSource)
###############################################################

node_install() {
    info "Installing Node.js LTS..."

    if command -v node &>/dev/null; then
        info "Node.js already installed ($(node --version)), skipping repo setup."
    else
        # NodeSource setup for Node 22 LTS
        curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash -
        $apt nodejs
    fi

    info "Installing global npm packages..."
    command -v cline &>/dev/null || sudo npm install -g cline
    command -v markdownlint-cli2 &>/dev/null || sudo npm install -g markdownlint-cli2
    command -v copilot &>/dev/null || sudo npm install -g @github/copilot
    command -v codex &>/dev/null || sudo npm install -g @openai/codex
    command -v pi &>/dev/null || sudo npm install -g --ignore-scripts @earendil-works/pi-coding-agent

    # Add more global npm packages below as needed:
    # sudo npm install -g <package>
}

###############################################################
# => Python
###############################################################

python_install() {
    info "Installing Python..."

    # python3-dev provides Python.h, which YouCompleteMe's ycm_core build needs;
    # python3-pynvim is the Python provider Neovim needs to load YouCompleteMe.
    $apt python3 \
        python3-dev \
        python3-pip \
        python3-pynvim \
        python3-venv \
        pipx

    # Linter for vimrc
    command -v vint &>/dev/null || pipx install vim-vint
    # vim-vint imports pkg_resources without declaring setuptools.
    vint --version &>/dev/null || pipx inject --force vim-vint 'setuptools<81'

    # Aider (AI pair programming)
    command -v aider &>/dev/null || pipx install aider-chat

    # Add pip/pipx packages below as needed:
    # pipx install <package>
}

###############################################################
# => Vim/Neovim plugins
###############################################################

## Install the Vim/Neovim plugins and compile YouCompleteMe's native core.
##
## Must follow dev_tools_install (Neovim, cmake, build-essential) and
## python_install (Python headers and the Neovim Python provider). Also run by
## `make repair REPAIR=vim PROFILE=work`.
vim_install() {
    info "Installing vim/neovim plugins..."
    vim_plugins_install
}

###############################################################
# => Docker CE (official repo)
###############################################################

docker_install() {
    info "Installing Docker..."

    if command -v docker &>/dev/null; then
        info "Docker already installed ($(docker --version)), skipping."
        return
    fi

    # Prerequisites
    $apt ca-certificates
    $apt gnupg

    # Add Docker GPG key
    sudo install -m 0755 -d /etc/apt/keyrings
    if [ ! -f /etc/apt/keyrings/docker.gpg ]; then
        curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
            | sudo gpg --dearmor -o /etc/apt/keyrings/docker.gpg
        sudo chmod a+r /etc/apt/keyrings/docker.gpg
    fi

    # Add Docker apt repo
    if [ ! -f /etc/apt/sources.list.d/docker.list ]; then
        echo \
            "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
            https://download.docker.com/linux/ubuntu \
            $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
            | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
        sudo apt-get update
    fi

    $apt docker-ce \
        docker-ce-cli \
        containerd.io \
        docker-buildx-plugin \
        docker-compose-plugin

    # Allow running docker without sudo
    sudo usermod -aG docker "$USER"

    info "Docker installed. Log out and back in for group changes to take effect."
}

###############################################################
# => Google Cloud SDK
###############################################################

gcloud_install() {
    info "Installing Google Cloud SDK..."

    if command -v gcloud &>/dev/null; then
        info "gcloud already installed ($(gcloud version 2>/dev/null | head -1)), skipping."
        return
    fi

    local tmp_dir
    tmp_dir="$(mktemp -d)"
    local tarball="$tmp_dir/google-cloud-cli-linux-x86_64.tar.gz"
    info "Downloading Google Cloud CLI..."
    curl -fsSL "https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-linux-x86_64.tar.gz" \
        -o "$tarball"
    tar -xf "$tarball" -C "$HOME"
    rm -rf "$tmp_dir"
    "$HOME/google-cloud-sdk/install.sh" --quiet

    info "Google Cloud SDK installed. Run 'gcloud init' to configure."
}

###############################################################
# => GUI applications
###############################################################

# The IDE helpers (cursor_is_installed, ide_apt_sources_ensure) are in base_functions.

gui_apps_install() {
    info "Installing GUI applications..."

    $apt firefox \
        thunderbird \
        vlc \
        libfuse2 \
        libreoffice \
        obs-studio \
        caffeine                # Prevent screen from going to sleep

    # ── Google Chrome (.deb download) ────────────────────────────
    if ! command -v google-chrome-stable &>/dev/null; then
        local tmp_dir
        tmp_dir="$(mktemp -d)"
        local chrome_deb="$tmp_dir/google-chrome-stable_current_amd64.deb"
        info "Installing Google Chrome..."
        if wget -qO "$chrome_deb" https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb; then
            sudo apt-get install -y "$chrome_deb"
        else
            warn "Failed to download Google Chrome"
        fi
        rm -rf "$tmp_dir"
    fi

    # ── Apt-repo-based installs ──────────────────────────────────
    # VS Code, Cursor and Antigravity install from their vendor apt repositories,
    # so the weekly full-upgrade keeps them current.  The sources are re-asserted
    # on every run because Ubuntu release upgrades disable them.
    ide_apt_sources_ensure vscode cursor antigravity ||
        warn "Some IDE apt sources are not configured; fix the cause, then run 'make repair REPAIR=ide-repos'."

    # VS Code
    if ! command -v code &>/dev/null; then
        info "Installing VS Code..."
        $apt code
    else
        info "VS Code already installed, skipping."
    fi

    # Obsidian
    if ! command -v obsidian &>/dev/null; then
        info "Installing Obsidian..."
        sudo snap install obsidian --classic
    else
        info "Obsidian already installed, skipping."
    fi

    # Cursor (AI IDE — apt repo; an existing AppImage install is kept as is)
    if ! cursor_is_installed; then
        info "Installing Cursor..."
        $apt cursor
    else
        info "Cursor already installed, skipping."
    fi

    # Antigravity (Google AI IDE — apt repo)
    if ! command -v antigravity &>/dev/null; then
        info "Installing Antigravity..."
        $apt antigravity
    else
        info "Antigravity already installed, skipping."
    fi

    # ── curl|sh installers ───────────────────────────────────────
    # Ollama (local LLM serving)
    ollama_install

    # Claude Code (Anthropic CLI)
    if ! command -v claude &>/dev/null; then
        info "Installing Claude Code..."
        local claude_installer
        claude_installer=$(curl -fsSL https://claude.ai/install.sh)
        CI=1 bash -c "$claude_installer" </dev/null
    else
        info "Claude Code already installed, skipping."
    fi

    # OpenCode (AI coding agent)
    opencode_install

    # Cursor CLI (`agent`; Cursor's own installer, because the IDE package does not include it)
    cursor_cli_install ||
        warn "Cursor CLI setup failed; rerun it with: bash -c 'source ~/.local/scripts/bootstrap/base_functions; cursor_cli_install'"

    # Pi (AI coding agent)
    pi_cli_install

    # GitHub Copilot CLI (AI coding assistant)
    copilot_cli_install

    # Aider (AI pair programming)
    aider_cli_install

    # GNOME advanced settings
    $apt dconf-editor

    # Sublime Text
    snap list sublime-text &>/dev/null 2>&1 || sudo snap install sublime-text --classic

    # Spotify, Discord and Telegram (snap)
    snap list spotify &>/dev/null 2>&1 || sudo snap install spotify
    snap list discord &>/dev/null 2>&1 || sudo snap install discord
    snap list telegram-desktop &>/dev/null 2>&1 || sudo snap install telegram-desktop

    # Video: the official OpenShot snap is newer than the Ubuntu archive and has no PPA
    # dependency stack; Blender's official classic snap is the upstream build (the archive
    # one is a distro build).
    snap list openshot-qt &>/dev/null 2>&1 || sudo snap install openshot-qt
    snap list blender &>/dev/null 2>&1 || sudo snap install blender --classic
}
