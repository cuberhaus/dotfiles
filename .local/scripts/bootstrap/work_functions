        cmake
        curl
        ddcutil                 # External monitor DDC brightness control
        default-jre-headless    # Java runtime (LanguageTool needs 17 or newer)
        git
        git-lfs                 # Large file storage for Git
        jq
        tree
        wget

        # Shell & terminal
        zsh
        stow

        # Editors
        vim-gtk3
        neovim

        # Modern CLI tools
        bat                     # Better cat
        eza                     # Better ls (exa replacement)
        fzf                     # Fuzzy finder
        gh                      # GitHub CLI
        htop                    # System monitor
        ncdu                    # Disk usage analyzer
        ranger                  # File manager
        ripgrep                 # Better grep
        fd-find                 # Better find
        silversearcher-ag       # ag (another grep alternative)
        w3m                     # Terminal browser (ranger image previews)
        shellcheck              # Shell script linter
        unzip
        unrar

        # Utilities
        eog                     # Image viewer
        flameshot               # Screenshot tool
        rclone                  # Sync files to/from cloud storage
        sshfs                   # Mount remote filesystems over SSH
