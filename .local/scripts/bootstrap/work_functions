###############################################################
# => Node.js (LTS via NodeSource)
###############################################################

node_install() {
    info "Installing Node.js LTS..."

    if command -v node &>/dev/null; then
        info "Node.js already installed ($(node --version)), skipping repo setup."
    else
        # NodeSource setup for Node 22 LTS
        curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash -
        $apt nodejs
    fi

    info "Installing global npm packages..."
    command -v cline &>/dev/null || sudo npm install -g cline
    command -v markdownlint-cli2 &>/dev/null || sudo npm install -g markdownlint-cli2
    command -v copilot &>/dev/null || sudo npm install -g @github/copilot

    # Add more global npm packages below as needed:
    # sudo npm install -g <package>
}

###############################################################
# => Python
###############################################################

python_install() {
    info "Installing Python..."

    $apt python3 \
        python3-pip \
        python3-venv \
        pipx

    # Linter for vimrc
    command -v vint &>/dev/null || pipx install vim-vint
    # vim-vint imports pkg_resources without declaring setuptools.
    vint --version &>/dev/null || pipx inject --force vim-vint 'setuptools<81'

    # Add pip/pipx packages below as needed:
    # pipx install <package>
}

###############################################################
# => Docker CE (official repo)
###############################################################

docker_install() {
    info "Installing Docker..."

    if command -v docker &>/dev/null; then
        info "Docker already installed ($(docker --version)), skipping."
        return
    fi

    # Prerequisites
    $apt ca-certificates
    $apt gnupg

    # Add Docker GPG key
    sudo install -m 0755 -d /etc/apt/keyrings
    if [ ! -f /etc/apt/keyrings/docker.gpg ]; then
        curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
            | sudo gpg --dearmor -o /etc/apt/keyrings/docker.gpg
        sudo chmod a+r /etc/apt/keyrings/docker.gpg
    fi

    # Add Docker apt repo
    if [ ! -f /etc/apt/sources.list.d/docker.list ]; then
        echo \
            "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
            https://download.docker.com/linux/ubuntu \
            $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
            | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
        sudo apt-get update
    fi

    $apt docker-ce \
        docker-ce-cli \
        containerd.io \
        docker-buildx-plugin \
        docker-compose-plugin

    # Allow running docker without sudo
    sudo usermod -aG docker "$USER"

    info "Docker installed. Log out and back in for group changes to take effect."
}

###############################################################
# => Google Cloud SDK
###############################################################

gcloud_install() {
    info "Installing Google Cloud SDK..."

    if command -v gcloud &>/dev/null; then
        info "gcloud already installed ($(gcloud version 2>/dev/null | head -1)), skipping."
        return
    fi

    local tarball="/tmp/google-cloud-cli-linux-x86_64.tar.gz"
    info "Downloading Google Cloud CLI..."
    curl -fsSL "https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-linux-x86_64.tar.gz" \
        -o "$tarball"
    tar -xf "$tarball" -C "$HOME"
    rm -f "$tarball"
    "$HOME/google-cloud-sdk/install.sh" --quiet

    info "Google Cloud SDK installed. Run 'gcloud init' to configure."
}

###############################################################
# => GUI applications
###############################################################

cursor_is_installed() {
    local app_image="$HOME/Applications/cursor.AppImage"
    local app_image_size=0

    command -v cursor &>/dev/null && return 0
    if [ -f "$app_image" ]; then
        app_image_size=$(stat -c%s "$app_image" 2>/dev/null || printf '0\n')
    fi
    [ "$app_image_size" -ge 1048576 ]
}

gui_apps_install() {
    info "Installing GUI applications..."

    $apt firefox \
        vlc \
        libfuse2 \
        libreoffice \
        obs-studio \
        caffeine                # Prevent screen from going to sleep

    # ── Phase 1: parallel downloads ──────────────────────────────
    # Download all .deb/.AppImage/.run files in parallel, then install sequentially
    # (apt/dpkg needs exclusive lock so installs can't overlap).
    local pids=() names=()
    local chrome_deb="/tmp/google-chrome-stable_current_amd64.deb"
    local warp_deb="/tmp/warp-terminal.deb"
    local lms_ver="0.4.4-1"
    local lms_deb="/tmp/LM-Studio-${lms_ver}-x64.deb"
    local cursor_deb="/tmp/cursor.deb"
    local gpt4all_run="/tmp/gpt4all-installer.run"

    # Google Chrome
    if ! command -v google-chrome-stable &>/dev/null; then
        info "Downloading Google Chrome..."
        wget -qO "$chrome_deb" https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb &
        pids+=($!); names+=("Chrome")
    fi

    # Warp (AI terminal)
    if ! command -v warp-terminal &>/dev/null; then
        info "Downloading Warp terminal..."
        wget -qO "$warp_deb" "https://app.warp.dev/download?package=deb" &
        pids+=($!); names+=("Warp")
    fi

    # LM Studio (local LLM runner — update version at https://lmstudio.ai/changelog)
    if ! dpkg -l lm-studio &>/dev/null 2>&1; then
        info "Downloading LM Studio..."
        wget -qO "$lms_deb" "https://installers.lmstudio.ai/linux/x64/${lms_ver}/LM-Studio-${lms_ver}-x64.deb" &
        pids+=($!); names+=("LM Studio")
    fi

    # Cursor (AI IDE — .deb)
    if ! cursor_is_installed; then
        info "Downloading Cursor..."
        wget -qO "$cursor_deb" "https://api2.cursor.sh/updates/download/golden/linux-x64-deb/cursor/stable" &
        pids+=($!); names+=("Cursor")
    fi

    # GPT4All (local LLM chat)
    if command -v gpt4all &>/dev/null || [ -d "$HOME/gpt4all" ] || [ -d /opt/gpt4all ]; then
        info "GPT4All already installed, skipping."
    else
        info "Downloading GPT4All..."
        (
            local ver
            ver=$(curl -sI https://github.com/nomic-ai/gpt4all/releases/latest | grep -i location | sed 's|.*/v||;s/\r//')
            wget -qO "$gpt4all_run" "https://github.com/nomic-ai/gpt4all/releases/download/v${ver}/gpt4all-installer-linux-v${ver}.run"
        ) &
        pids+=($!); names+=("GPT4All")
    fi

    # Wait for all downloads to finish
    local failures=0
    for i in "${!pids[@]}"; do
        if ! wait "${pids[$i]}"; then
            warn "Failed to download ${names[$i]}"
            ((failures++)) || true
        else
            info "${names[$i]} download complete."
        fi
    done
    if [ "$failures" -gt 0 ]; then
        warn "$failures download(s) failed — some apps may not install."
    fi

    # ── Phase 2: install from downloaded files ───────────────────
    if [ -f "$chrome_deb" ]; then
        info "Installing Google Chrome..."
        sudo apt-get install -y "$chrome_deb"
        rm -f "$chrome_deb"
    fi

    if [ -f "$warp_deb" ]; then
        info "Installing Warp terminal..."
        sudo apt-get install -y "$warp_deb"
        rm -f "$warp_deb"
    fi

    if [ -f "$lms_deb" ]; then
        info "Installing LM Studio..."
        sudo apt-get install -y "$lms_deb"
        rm -f "$lms_deb"
    fi

    if [ -f "$cursor_deb" ]; then
        info "Installing Cursor..."
        sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "$cursor_deb"
        rm -f "$cursor_deb"
    fi

    if [ -f "$gpt4all_run" ] && ! command -v gpt4all &>/dev/null && [ ! -d "$HOME/gpt4all" ] && [ ! -d /opt/gpt4all ]; then
        info "Installing GPT4All..."
        chmod +x "$gpt4all_run"
        "$gpt4all_run" --root "$HOME/gpt4all" --accept-licenses --default-answer --confirm-command install
        rm -f "$gpt4all_run"
        cat > "$HOME/.local/share/applications/gpt4all.desktop" <<EOF
[Desktop Entry]
Name=GPT4All
Exec=$HOME/gpt4all/bin/chat
Icon=$HOME/gpt4all/logo-48.png
Type=Application
Categories=Development;Science;
Comment=Run LLMs locally
EOF
    fi

    # ── Phase 3: apt-repo-based installs ─────────────────────────
    # VS Code
    if ! command -v code &>/dev/null; then
        info "Installing VS Code..."
        if [ ! -f /etc/apt/keyrings/packages.microsoft.gpg ]; then
            curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
                | sudo gpg --dearmor -o /etc/apt/keyrings/packages.microsoft.gpg
            sudo chmod a+r /etc/apt/keyrings/packages.microsoft.gpg
        fi
        if [ ! -f /etc/apt/sources.list.d/vscode.list ]; then
            echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/packages.microsoft.gpg] \
                https://packages.microsoft.com/repos/code stable main" \
                | sudo tee /etc/apt/sources.list.d/vscode.list > /dev/null
            sudo apt-get update
        fi
        $apt code
    else
        info "VS Code already installed, skipping."
    fi

    # Obsidian
    if ! command -v obsidian &>/dev/null; then
        info "Installing Obsidian..."
        sudo snap install obsidian --classic
    else
        info "Obsidian already installed, skipping."
    fi

    # Cursor (AI IDE — AppImage)
    if ! cursor_is_installed; then
        info "Installing Cursor..."
        $apt libfuse2
        mkdir -p "$HOME/Applications"
        local cursor_url
        cursor_url=$(curl -fsSL "https://www.cursor.com/api/download?platform=linux-x64&releaseTrack=stable" | jq -r '.downloadUrl')
        curl -fsSL "$cursor_url" -o "$HOME/Applications/cursor.AppImage"
        chmod +x "$HOME/Applications/cursor.AppImage"
        # Desktop entry
        cat > "$HOME/.local/share/applications/cursor.desktop" <<EOF
[Desktop Entry]
Name=Cursor
Exec=$HOME/Applications/cursor.AppImage --no-sandbox %U
Icon=cursor
Type=Application
Categories=Development;IDE;
StartupWMClass=Cursor
EOF
    else
        info "Cursor already installed, skipping."
    fi


    # Antigravity (Google AI IDE — apt repo)
    if ! command -v antigravity &>/dev/null; then
        info "Installing Antigravity..."
        sudo mkdir -p /etc/apt/keyrings
        curl -fsSL https://us-central1-apt.pkg.dev/doc/repo-signing-key.gpg \
            | sudo gpg --dearmor --yes -o /etc/apt/keyrings/antigravity-repo-key.gpg
        echo "deb [signed-by=/etc/apt/keyrings/antigravity-repo-key.gpg] https://us-central1-apt.pkg.dev/projects/antigravity-auto-updater-dev/ antigravity-debian main" \
            | sudo tee /etc/apt/sources.list.d/antigravity.list > /dev/null
        sudo apt-get update
        $apt antigravity
    else
        info "Antigravity already installed, skipping."
    fi

    # ── Phase 4: curl|sh installers ──────────────────────────────
    # Ollama (local LLM serving)
    if ! command -v ollama &>/dev/null; then
        info "Installing Ollama..."
        curl -fsSL https://ollama.com/install.sh | sh
    else
        info "Ollama already installed, skipping."
    fi

    # Zed (fast AI-powered editor)
    if ! command -v zed &>/dev/null; then
        info "Installing Zed..."
        curl -f https://zed.dev/install.sh | sh
    else
        info "Zed already installed, skipping."
    fi

    # Claude Code (Anthropic CLI)
    if ! command -v claude &>/dev/null; then
        info "Installing Claude Code..."
        local claude_installer
        claude_installer=$(curl -fsSL https://claude.ai/install.sh)
        CI=1 bash -c "$claude_installer" </dev/null
    else
        info "Claude Code already installed, skipping."
    fi

    # LibreOffice (full office suite)
    $apt libreoffice

    # Caffeine (prevent screen from going to sleep)
    $apt caffeine

    # GNOME advanced settings
    $apt dconf-editor

    # Sublime Text
    snap list sublime-text &>/dev/null 2>&1 || sudo snap install sublime-text --classic

    # Sublime Merge
    snap list sublime-merge &>/dev/null 2>&1 || sudo snap install sublime-merge --classic

    # Walc (WhatsApp Linux client)
    snap list walc &>/dev/null 2>&1 || sudo snap install walc

    # Spotify and Discord (snap)
    snap list spotify &>/dev/null 2>&1 || sudo snap install spotify
    snap list discord &>/dev/null 2>&1 || sudo snap install discord
}

###############################################################
# => High DPI screen tweaks (GNOME)
###############################################################

# This has some problems with some apps that are seen very tiny, it is definitely not the perfect solution
high_dpi_screen() {
    # To fix high dpi screens, two options, go to 200% scaling, or fractional scaling, fractional scaling causes blurry text, more power usage, lower speed.

    # We instead increase text scaling
    gsettings set org.gnome.desktop.interface text-scaling-factor 1.3

    # Increase cursor size Settings-> Accesibility -> Cursor size -> Medium
    gsettings set org.gnome.desktop.interface cursor-size 35
    # Set icons to Large 'small' to set it smaller
    gsettings set org.gnome.shell.extensions.ding icon-size 'large'
}
