#! /usr/bin/env bash
# Work machine bootstrap functions (Asus ROG Strix / Ubuntu + NVIDIA)
# Author: https://github.com/cuberhaus

apt="sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y"

###############################################################
# => ROG Strix shutdown fix (GRUB power-management params)
###############################################################

shutdown_fix() {
    sudo bash "${DOTFILES_ROOT:-$HOME}/.local/scripts/permanent_shutdown_fix.sh"
}

###############################################################
# => ROG Strix brightness fix (acpi_backlight=native)
###############################################################

brightness_fix() {
    sudo bash "${DOTFILES_ROOT:-$HOME}/.local/scripts/brightness_fix.sh"
}

###############################################################
# => NVIDIA drivers
###############################################################

nvidia_install() {
    info "Installing NVIDIA drivers..."

    $apt ubuntu-drivers-common

    if ! nvidia-smi &>/dev/null; then
        sudo ubuntu-drivers install
        info "NVIDIA drivers installed. A reboot is required to load them."
    else
        info "NVIDIA driver already loaded ($(nvidia-smi --query-gpu=driver_version --format=csv,noheader | head -1)), skipping."
    fi

    $apt nvidia-settings \
        nvidia-prime            # Optimus GPU switching (prime-select nvidia|intel|on-demand)
}

