#! /usr/bin/env bash
# Work machine bootstrap UNINSTALL functions
# Author: https://github.com/cuberhaus

apt_remove="sudo apt-get remove --purge -y"
apt_autoremove="sudo apt-get autoremove -y"

###############################################################
# => NVIDIA drivers uninstall
###############################################################
nvidia_uninstall() {
    info "Uninstalling NVIDIA tools..."
    $apt_remove ubuntu-drivers-common nvidia-settings nvidia-prime || true
}

###############################################################
# => Core dev tools uninstall
###############################################################
dev_tools_uninstall() {
    info "Uninstalling dev tools..."
    rclone_drive_mount_uninstall || true
    ubuntu_cli_base_uninstall
    $apt_remove flameshot hardinfo cpu-x || true
}

###############################################################
# => Node.js uninstall
###############################################################
node_uninstall() {
    info "Uninstalling Node.js and global packages..."
    sudo npm uninstall -g cline markdownlint-cli2 @openai/codex || true
    $apt_remove nodejs || true
    
    # Remove NodeSource repo
    sudo rm -f /etc/apt/sources.list.d/nodesource.list
    sudo rm -f /etc/apt/keyrings/nodesource.gpg
}

###############################################################
# => Python uninstall
###############################################################
python_uninstall() {
    info "Uninstalling Python and pipx packages..."

    # Uninstall pipx packages (including vim-vint) before removing pip and pipx
    if command -v pipx &>/dev/null; then
        pipx uninstall-all || true
    fi

    ubuntu_python_uninstall
}

###############################################################
# => Docker CE uninstall
###############################################################
docker_uninstall() {
    info "Uninstalling Docker..."
    $apt_remove docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin || true
    
    # Remove Docker apt repo and key
    sudo rm -f /etc/apt/sources.list.d/docker.list
    sudo rm -f /etc/apt/keyrings/docker.gpg
    
    # Remove user from docker group
    sudo gpasswd -d "$USER" docker || true
}

###############################################################
# => GUI applications uninstall
###############################################################
gui_apps_uninstall() {
    info "Uninstalling GUI applications..."
    
    # apt packages
    ubuntu_desktop_base_uninstall
    $apt_remove firefox code cursor antigravity warp-terminal libreoffice || true
    chrome_uninstall
    
    # Snaps
    common_snaps_uninstall
    sudo snap remove sublime-merge || true
    
    # Remove the IDE apt sources, signing keys, and Cursor AppImage artifacts
    ide_apt_sources_uninstall vscode cursor antigravity

    ubuntu_gnome_desktop_uninstall

    common_ai_tools_uninstall
    
    # Clean up apt caches
    sudo apt-get update
    $apt_autoremove
}
