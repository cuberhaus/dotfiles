#!/usr/bin/env bash
# macOS bootstrap UNINSTALL
# Author: https://github.com/cuberhaus
set -euo pipefail

### VARIABLES
scripts="$HOME/.local/scripts"
source "$scripts/bootstrap/base_functions"
source "$scripts/bootstrap/uninstall_mac_functions"

### UNINSTALLATION
info "Preparing to uninstall macOS bootstrap dependencies..."

read -r -p "This will remove CLI tools, fonts, GUI apps, and vim/neovim via Homebrew. Are you sure? [y/N] " response
if [[ "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
    vim_uninstall
    gui_apps_uninstall
    fonts_uninstall
    cli_uninstall
    brew_cleanup

    info "Uninstallation complete."
    info "To fully remove Homebrew itself, run:"
    info "  /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/uninstall.sh)\""
else
    info "Uninstallation aborted."
fi
