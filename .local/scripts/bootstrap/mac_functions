brew_install() {
    if command -v brew &>/dev/null; then
        info "Homebrew already installed, skipping."
        return
    fi
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install.sh)"
}

mac_install () {
    info "Installing mac packages..."
    touch "$HOME/.hushlogin"
    touch ~/.bash_sessions_disable
    sudo chown -R "$USER" "$HOME/.cache/zsh"

    ### CLI tools
    local cli_tools=(
        ack
        astyle
        bat                     # Cat on steroids
        bison
        cmake
        eza                     # ls on steroids (exa replacement)
        flex
        fzf                     # Fuzzy finder
        gh                      # GitHub CLI
        git
        go
        gpg
        htop                    # Resource viewer
        llvm                    # Compiler
        mono
        ncdu                    # Storage manager
        neofetch                # System info
        p7zip                   # Extract function
        pinentry-mac            # Git password prompts
        pkg-config
        ranger w3m              # Ranger and previews
        rclone                  # Push/pull from cloud storage
        ripgrep
        smimesign               # Git with gpg
        sox
        stow                    # Stow dotfiles
        swig
        the_silver_searcher     # Grep on steroids
