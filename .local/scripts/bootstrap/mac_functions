vim_install () {
    info "Installing vim/neovim plugins..."
    brew install macvim                         # Vim
    brew install neovim                         # NeoVim
    cd "$HOME" || exit
    vim +PlugInstall +qall
    # Vim YouCompleteMe plugin install
    bash "$HOME/.local/scripts/ycm.sh"
    sudo npm install -g neovim
    python3 -m pip install --user --upgrade pynvim
    sudo gem install neovim
    sudo chown -R "$USER" "$XDG_DATA_HOME/"
}

doom_emacs_install() {
    #chemacs
    if [ ! -d ~/.emacs.d ] || [ ! -f ~/.emacs.d/chemacs.el ]; then
        git clone https://github.com/plexus/chemacs2.git ~/.emacs.d
    else
        info "Chemacs2 already installed, skipping."
    fi
    # required dependencies
    brew install git ripgrep
    # optional dependencies
    brew install coreutils fd
    # Installs clang
    xcode-select --install
    # brew tap railwaycat/emacsmacport
    # brew install emacs-mac --with-modules
    # ln -s /usr/local/opt/emacs-mac/Emacs.app /Applications/Emacs.app

    brew tap d12frosted/emacs-plus
    brew install emacs-plus --with-native-comp
    if [ ! -d ~/.config/doom-emacs ]; then
        git clone --depth 1 https://github.com/doomemacs/doomemacs ~/.config/doom-emacs
        ~/.config/doom-emacs/bin/doom install
    else
        info "Doom Emacs already installed, skipping."
    fi
    # ghcup installer for the general purpose language Haskell
    curl --proto '=https' --tlsv1.2 -sSf https://get-ghcup.haskell.org | sh
    local doom_deps=(
        gnuplot                 # Doom org
        jq
        black                   # Python code formatting
        pipenv                  # Python
        shellcheck              # Shell script linting
        hlint                   # Flycheck for Haskell
        cabal                   # Haskell-mode
        aspell                  # Spell checker
        editorconfig
        glslang
        cabal-install           # Haskell
        dante
        haskell-language-server
    )
    brew install "${doom_deps[@]}"
    echo "doom" | tee "$HOME/.config/chemacs/profile"
}

