davinci_resolve_install() {
    local -a arguments=()
    if [ "${UNATTENDED:-false}" = true ]; then
        arguments+=(--unattended)
    fi
    DAVINCI_RESOLVE_SUDO="${SUDO_COMMAND:-sudo}" \
        bash "${DOTFILES_ROOT:-$HOME}/.local/scripts/davinci_resolve_install.sh" ${arguments[@]+"${arguments[@]}"}
}

## Remove DaVinci Resolve and the launchers, menu entries, and udev rules that belong to
## it; projects and settings in the home folder stay.
davinci_uninstall() {
    bash "${DOTFILES_ROOT:-$HOME}/.local/scripts/davinci_resolve_install.sh" --uninstall || true
}

###############################################################
# => IDE installs (vendor apt repositories and Cursor)
###############################################################

# VS Code, Cursor and Antigravity ship as .deb packages and only receive updates
# while their vendor apt source is enabled.  Ubuntu release upgrades disable
# third-party sources, and the weekly `apt-get full-upgrade`
# (cuberhaus-system-maintenance) then skips those packages without any error.
# So the sources are re-asserted on every bootstrap run and by
# `make repair REPAIR=ide-repos`, not written once behind a `command -v` guard.

# Succeed when Cursor is installed, either as the .deb (a `cursor` command) or
# as a complete AppImage.  The 1 MiB floor rejects a failed download or an API
# reply that was saved as the AppImage.
cursor_is_installed() {
    local app_image="$HOME/Applications/cursor.AppImage"
    local app_image_size=0

    command -v cursor &>/dev/null && return 0
    if [ -f "$app_image" ]; then
        app_image_size=$(stat -c%s "$app_image" 2>/dev/null || printf '0\n')
    fi
    [ "$app_image_size" -ge 1048576 ]
}

# Download the latest stable Cursor AppImage to $1 (used where no apt repository
# is available, such as Arch).  The download API replies with JSON naming the
# file, so the URL is resolved first.  The file is fetched under a .part name and
# size-checked, so an interrupted download is never mistaken for an install.
cursor_appimage_download() {
    local destination="$1"
    local partial="$destination.part"
    local api_url="https://cursor.com/api/download?platform=linux-x64&releaseTrack=stable"
    local download_url

    if ! download_url=$(curl -fsSL "$api_url" | jq -er '.downloadUrl'); then
        error "Could not resolve the Cursor AppImage download URL from $api_url"
        return 1
    fi
    if ! curl -fsSL "$download_url" -o "$partial"; then
        rm -f "$partial"
        error "Could not download the Cursor AppImage from $download_url"
        return 1
    fi
    if [ "$(stat -c%s "$partial")" -lt 1048576 ]; then
        rm -f "$partial"
        error "The downloaded Cursor AppImage is incomplete."
        return 1
    fi
    mv -f "$partial" "$destination"
}

# Extract the Cursor icon from the AppImage $1 into the user's icon theme and print
# its path.  A launcher cannot say `Icon=cursor`: that icon exists only inside the
# AppImage's temporary mount, which the AppImage adds to the XDG_DATA_DIRS of its own
# children, so GNOME Shell never finds it and shows the generic executable icon.
# $1 must be an absolute path to an executable AppImage.  Prints nothing and
# returns 1 when the icon cannot be extracted.
cursor_appimage_icon_install() {
    local app_image="$1"
    local member="usr/share/icons/hicolor/512x512/apps/cursor.png"
    local icon_dir="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/512x512/apps"
    local scratch

    scratch=$(mktemp -d) || return 1
    if (cd "$scratch" && "$app_image" --appimage-extract "$member" &>/dev/null) &&
        [ -s "$scratch/squashfs-root/$member" ] &&
        mkdir -p "$icon_dir" &&
        install -m 0644 "$scratch/squashfs-root/$member" "$icon_dir/cursor.png"; then
        rm -rf "$scratch"
        printf '%s\n' "$icon_dir/cursor.png"
        return 0
    fi
    rm -rf "$scratch"
    return 1
}

# Install the Cursor CLI (`agent`, also linked as `cursor-agent`) for the current user.
# Cursor ships it through its own installer only: neither the .deb nor the AppImage of
# the IDE contains it, and there is no apt, pacman or brew package.  The installer puts
# the program in ~/.local/share/cursor-agent and links it from ~/.local/bin.  The script
# is downloaded in full before bash runs it, so a dropped connection cannot run half of
# it, and an existing install is left alone (`agent update` updates it).  It does not
# sign in: run `agent login`.  Call it as `cursor_cli_install ||`: the shell ignores
# `set -e` there, so a failure warns and returns 1 instead of relying on it.
cursor_cli_install() {
    local installer

    if command -v cursor-agent &>/dev/null || [ -x "$HOME/.local/bin/cursor-agent" ]; then
        info "Cursor CLI already installed, skipping (update it with: agent update)."
        return 0
    fi

    info "Installing Cursor CLI..."
    if ! installer=$(curl -fsSL https://cursor.com/install); then
        warn "Could not download the Cursor CLI installer"
        return 1
    fi
    if ! NO_COLOR=1 bash -c "$installer" </dev/null; then
        warn "The Cursor CLI installer failed"
        return 1
    fi
    if [ ! -x "$HOME/.local/bin/cursor-agent" ]; then
        warn "The Cursor CLI installer did not create $HOME/.local/bin/cursor-agent"
        return 1
    fi
    info "Cursor CLI installed; sign in with: agent login"
}

# Remove what cursor_cli_install put in place: the program folder, and each of the two
# links in ~/.local/bin only while it still points into that folder, so an `agent` that
# something else put there stays.  The sign-in and settings in ~/.cursor are the user's
# and stay too.
cursor_cli_uninstall() {
    local cli_home="$HOME/.local/share/cursor-agent"
    local link

    for link in "$HOME/.local/bin/agent" "$HOME/.local/bin/cursor-agent"; do
        case "$(readlink "$link" 2>/dev/null)" in
            "$cli_home"/*) rm -f "$link" ;;
        esac
    done
    rm -rf "$cli_home"
}

###############################################################
# => LanguageTool (grammar checker for Emacs and TeXstudio)
###############################################################

# LanguageTool 6.x is built for Java 17.  Succeeds when the `java` on PATH is that version or
# newer; otherwise it warns what the machine has and how to get a runtime, and returns 1.  The
# version is read from the output of `java -version` (which goes to stderr, may follow a
# "Picked up _JAVA_OPTIONS" line, and reads 1.8 for Java 8), not from the command's status:
# /usr/bin/java on a Mac without a JDK exists but exits with an error.
languagetool_java_check() {
    local minimum=17 output="" major="" found="no working Java"
    local pattern='version "([0-9]+)(\.([0-9]+))?'

    if command -v java &>/dev/null; then
        output="$(java -version 2>&1)" || true
        if [[ $output =~ $pattern ]]; then
            major="${BASH_REMATCH[1]}"
            if [ "$major" = 1 ]; then
                major="${BASH_REMATCH[3]}"
            fi
        fi
    fi
    if [ -n "$major" ]; then
        found="Java $major"
        if [ "$major" -ge "$minimum" ]; then
            return 0
        fi
    fi
    warn "LanguageTool needs Java $minimum or newer, but this machine has $found. Install a runtime: Arch jre-openjdk-headless, Ubuntu default-jre-headless (openjdk-17-jre-headless on 22.04), macOS brew install --cask temurin."
    return 1
}

# Emacs (flycheck-languagetool, see .config/emacs.org) and TeXstudio run LanguageTool's server jar.
# The distribution is a 240 MB zip, so git does not track it: this downloads it into
# ~/.config/texstudio/dictionaries/LanguageTool-<version>/ (the folder .gitignore keeps out of git).
# languagetool.org keeps only its recent releases, so the version is one it still hosts, and the
# SHA-256 below was checked against the Internet Archive's copies of the same file.  Change the
# version and the digest together, with the copies in tests/test_languagetool_install.sh and the
# path in .config/emacs.org and .config/my_emacs/init.el.  It needs Java 17 or newer: every
# profile installs a runtime in its package stage, and languagetool_java_check below makes the
# step fail, with the reason, when the machine still has none that is new enough.
# Call it as `languagetool_install ||`: the shell ignores `set -e` there, so every step is chained
# and a failure warns and returns 1.
languagetool_install() {
    local version="6.6"
    local digest="53600506b399bb5ffe1e4c8dec794fd378212f14aaf38ccef9b6f89314d11631"
    local asset="LanguageTool-${version}.zip"
    local dest="$HOME/.config/texstudio/dictionaries/LanguageTool-${version}"
    local -a fetch=(curl --proto '=https' --proto-redir '=https' --tlsv1.2 --fail --location
        --silent --show-error --retry 3 --retry-connrefused)
    local -a sha256=(sha256sum)
    local work tool

    if [ -f "$dest/languagetool-server.jar" ]; then
        info "LanguageTool ${version} already installed, skipping."
        languagetool_java_check
        return
    fi
    for tool in curl unzip; do
        if ! command -v "$tool" &>/dev/null; then
            warn "LanguageTool needs $tool to install; install it and rerun."
            return 1
        fi
    done
    # macOS has no sha256sum.
    command -v sha256sum &>/dev/null || sha256=(shasum -a 256)

    # The work folder sits next to the destination so the final move is a rename, and a run that
    # was killed halfway leaves only a LanguageTool-*.partial folder, which the next run removes.
    work="${dest}.partial"
    rm -rf "$work"
    info "Installing LanguageTool ${version} (240 MB)..."
    if mkdir -p "$work" &&
        "${fetch[@]}" --output "$work/$asset" "https://languagetool.org/download/$asset" &&
        printf '%s  %s\n' "$digest" "$asset" > "$work/$asset.sha256" &&
        (cd "$work" && "${sha256[@]}" --check "$asset.sha256") &&
        unzip -q "$work/$asset" -d "$work/unpacked" &&
        [ -f "$work/unpacked/LanguageTool-${version}/languagetool-server.jar" ] &&
        rm -rf "$dest" &&
        mv "$work/unpacked/LanguageTool-${version}" "$dest"; then
        rm -rf "$work"
    else
        rm -rf "$work"
        warn "LanguageTool ${version} was not installed: the download, its checksum, or the unpacking failed."
        return 1
    fi
    info "LanguageTool ${version} installed in $dest"
    languagetool_java_check
}

# Remove every LanguageTool version languagetool_install put in place.  The dictionaries tracked
# in git (the .oxt files) and the rest of ~/.config/texstudio stay.
langtool_uninstall() {
    local dictionaries="$HOME/.config/texstudio/dictionaries"
    local folder

    for folder in "$dictionaries"/LanguageTool-*; do
        [ -d "$folder" ] && rm -rf "$folder"
    done
    return 0
}

# Run a command that changes the apt configuration, or only describe it when
# APT_SOURCES_DRY_RUN=true (`make repair REPAIR=ide-repos DRY_RUN=true`).
apt_sources_apply() {
    if [ "${APT_SOURCES_DRY_RUN:-false}" = true ]; then
        info "[dry-run] would run: $*"
        return 0
    fi
    "$@"
}

# Download the apt signing key of the vendor named $1 from $2 and install it,
# dearmored, as the keyring $3.  Fails unless the keyring ends up non-empty.
apt_vendor_key_install() {
    local name="$1" key_url="$2" keyring="$3"
    local key_file

    key_file=$(mktemp)
    if ! curl -fsSL "$key_url" -o "$key_file"; then
        rm -f "$key_file"
        error "Could not download the $name apt signing key from $key_url"
        return 1
    fi
    if ! { sudo install -d -m 0755 "$(dirname "$keyring")" &&
        sudo gpg --dearmor --yes -o "$keyring" "$key_file" &&
        sudo chmod a+r "$keyring" &&
        [ -s "$keyring" ]; }; then
        rm -f "$key_file"
        error "Could not install the $name apt signing key at $keyring"
        return 1
    fi
    rm -f "$key_file"
}

# Write one vendor apt source in deb822 format and install its signing key.
#   apt_vendor_source_ensure NAME URI SUITE COMPONENTS ARCHITECTURES KEY_URL KEYRING
# ARCHITECTURES may be empty.  COMPONENTS may be empty for a flat repository (a
# SUITE that ends in /, like NVIDIA's), which takes no Components line.
# Idempotent: a matching source is left alone, one disabled by a release upgrade
# (`Enabled: no`) is rewritten, and a legacy one-line NAME.list moves to
# NAME.list.bak, which apt ignores.  Sets APT_SOURCES_CHANGED=true when anything
# changed so the caller refreshes apt once.  APT_SOURCES_DRY_RUN=true only reports
# the changes.  APT_SOURCES_DIR overrides /etc/apt/sources.list.d (the tests use it).
# The file layout matches what the vendors' own postinst scripts write, so their
# refresh of the file on package upgrade is a no-op.  (Old apt without
# `modernize-sources` makes the Cursor postinst add a legacy cursor.list; run the
# bootstrap or the repair step again to retire it.)
apt_vendor_source_ensure() {
    local name="$1" uri="$2" suite="$3" components="$4" architectures="$5"
    local key_url="$6" keyring="$7"
    local sources_dir="${APT_SOURCES_DIR:-/etc/apt/sources.list.d}"
    local dry_run="${APT_SOURCES_DRY_RUN:-false}"
    local target="$sources_dir/$name.sources"
    local legacy="$sources_dir/$name.list"
    local desired

    # Every step is checked explicitly: callers may run this inside `|| warn`,
    # where errexit is off.  A source must never be written without a usable key,
    # because apt-get update would then fail and, with it, the weekly full-upgrade.
    if [ ! -s "$keyring" ]; then
        if [ "$dry_run" = true ]; then
            info "[dry-run] would download $key_url and install it as $keyring"
        else
            info "Installing the $name apt signing key..."
            apt_vendor_key_install "$name" "$key_url" "$keyring" || return 1
        fi
        APT_SOURCES_CHANGED=true
    fi

    desired="### THIS FILE IS AUTOMATICALLY CONFIGURED ###
# You may comment out this entry, but any other modifications may be lost.
Types: deb
URIs: $uri
Suites: $suite"
    if [ -n "$components" ]; then
        desired+=$'\n'"Components: $components"
    fi
    if [ -n "$architectures" ]; then
        desired+=$'\n'"Architectures: $architectures"
    fi
    desired+=$'\n'"Signed-By: $keyring"

    if [ "$(cat "$target" 2>/dev/null)" != "$desired" ]; then
        if [ "$dry_run" = true ]; then
            info "[dry-run] would write $target:"
            printf '%s\n' "$desired" | sed 's/^/    /'
        else
            info "Configuring the $name apt source..."
            if ! printf '%s\n' "$desired" | sudo tee "$target" >/dev/null; then
                error "Could not write $target"
                return 1
            fi
        fi
        APT_SOURCES_CHANGED=true
    fi

    if [ -e "$legacy" ]; then
        info "Retiring the legacy $name.list (kept as $name.list.bak)..."
        if ! apt_sources_apply sudo mv -f "$legacy" "$legacy.bak"; then
            error "Could not retire $legacy"
            return 1
        fi
        APT_SOURCES_CHANGED=true
    fi
}

# Configure the apt source of every IDE named in the arguments (vscode, cursor,
# antigravity), then refresh apt once if any source changed.  From there the
# weekly full-upgrade keeps the packages current.  A vendor that fails (for
# example, its key host is unreachable) does not stop the others; the function
# returns non-zero after processing all of them.
ide_apt_sources_ensure() {
    local ide status=0

    APT_SOURCES_CHANGED=false
    for ide in "$@"; do
        case "$ide" in
            vscode)
                apt_vendor_source_ensure vscode \
                    https://packages.microsoft.com/repos/code stable main \
                    "$(dpkg --print-architecture)" \
                    https://packages.microsoft.com/keys/microsoft.asc \
                    /usr/share/keyrings/microsoft.gpg || status=1
                ;;
            cursor)
                apt_vendor_source_ensure cursor \
                    https://downloads.cursor.com/aptrepo stable main \
                    amd64,arm64 \
                    https://downloads.cursor.com/keys/anysphere.asc \
                    /usr/share/keyrings/anysphere.gpg || status=1
                ;;
            antigravity)
                # The antigravity package never registers its own repository
                # (its postinst skips that step), so this source is the only
                # way apt can update it.
                apt_vendor_source_ensure antigravity \
                    https://us-central1-apt.pkg.dev/projects/antigravity-auto-updater-dev/ \
                    antigravity-debian main "" \
                    https://us-central1-apt.pkg.dev/doc/repo-signing-key.gpg \
                    /etc/apt/keyrings/antigravity-repo-key.gpg || status=1
                ;;
            *)
                error "Unknown IDE apt source: $ide"
                return 2
                ;;
        esac
    done
    if [ "$APT_SOURCES_CHANGED" = true ]; then
        apt_sources_apply sudo apt-get update || status=1
    fi
    return "$status"
}

# Repair the apt sources of the IDE .deb packages installed on this machine
# (`make repair REPAIR=ide-repos`).  IDEs installed another way (snap, AppImage)
# are left alone.
ide_apt_sources_repair() {
    local pair package
    local -a installed=()

    for pair in vscode:code cursor:cursor antigravity:antigravity; do
        package="${pair#*:}"
        if dpkg -s "$package" 2>/dev/null | grep -q '^Status: install ok installed'; then
            installed+=("${pair%%:*}")
        fi
    done

    if [ "${#installed[@]}" -eq 0 ]; then
        info "No IDE .deb package is installed; nothing to repair."
        return 0
    fi
    info "Repairing the apt sources of: ${installed[*]}"
    ide_apt_sources_ensure "${installed[@]}" || return
    if [ "$APT_SOURCES_CHANGED" != true ]; then
        # The sources were already right, so the package lists may be the stale
        # part; a repair must not end without refreshing them.
        apt_sources_apply sudo apt-get update
    fi
}

###############################################################
# => Caffeine indicator autostart
###############################################################

# Start the Caffeine tray indicator at every login.  The apt package `caffeine`
# autostarts only its headless daemon (/etc/xdg/autostart/caffeine.desktop runs
# /usr/bin/caffeine, which suspends the screensaver while a window is full screen).
# The indicator that toggles it by hand is a separate program,
# /usr/bin/caffeine-indicator, and the package gives it no autostart entry.
#
# The entry goes into the user's autostart folder instead of being tracked in the
# checkout: that folder belongs to every app that starts at login, so Stow would
# link the whole folder into the repository, and each of those apps would then write
# its entry there.  TryExec makes the session skip the entry once the package is gone.
# An entry that differs is kept as caffeine-indicator.desktop.bak before it is replaced.
caffeine_indicator_autostart_install() {
    local autostart_dir="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"
    local entry="$autostart_dir/caffeine-indicator.desktop"
    local wanted

    wanted=$(cat <<'EOF'
[Desktop Entry]
Type=Application
Name=Caffeine Indicator
Comment=Manually control activation of the screensaver/screen lock and sleep mode
Exec=/usr/bin/caffeine-indicator
TryExec=/usr/bin/caffeine-indicator
Icon=caffeine
Terminal=false
StartupNotify=false
X-GNOME-Autostart-enabled=true
EOF
)

    mkdir -p "$autostart_dir" || return 1
    if [ -f "$entry" ]; then
        if [ "$(cat "$entry")" = "$wanted" ]; then
            info "Caffeine indicator already starts at login, skipping."
            return 0
        fi
        cp -f "$entry" "$entry.bak" || return 1
        info "Replacing $entry (the previous one is kept as $entry.bak)..."
    fi
    printf '%s\n' "$wanted" > "$entry" || return 1
    info "Caffeine indicator will start at login."
}

###############################################################
# => smb:// links open in GNOME Files
###############################################################

# Let a browser click on an smb:// link (the pol-server Service Launcher's Files tile)
# open the share in GNOME Files.  A stock GNOME desktop lacks two things, and a default set
# with `xdg-mime` alone fixes neither:
#   - GNOME's "Open With" chooser lists only applications whose desktop entry names the
#     scheme, and Nautilus's declares just inode/directory.  `gio mime x-scheme-handler/smb`
#     then finds no registered application and the click ends in "No Apps Available", even
#     with Nautilus set as the default.
#   - A browser starts its handlers with GIO_USE_VFS=local in the environment, which makes GIO
#     ignore GVFS, so a Nautilus started that way answers "smb locations are not supported".
#     The entry's Exec clears the variable.
# The entry goes into the user's applications folder instead of being tracked in the checkout,
# for the reason given at caffeine_indicator_autostart_install: that folder belongs to every
# app that installs a launcher, so Stow would link the whole folder into the repository.
# An entry that differs is kept as smb-nautilus.desktop.bak, and the previous mimeapps.list as
# mimeapps.list.bak, before they change.  A machine without Nautilus is skipped.
smb_scheme_handler_install() {
    local apps_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    local mime_config="${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list"
    local entry="$apps_dir/smb-nautilus.desktop"
    local wanted changed=0

    if ! command -v nautilus >/dev/null 2>&1; then
        info "GNOME Files is not installed, skipping the smb:// link handler."
        return 0
    fi
    if ! command -v update-desktop-database >/dev/null 2>&1 || ! command -v xdg-mime >/dev/null 2>&1; then
        warn "The smb:// link handler needs update-desktop-database (desktop-file-utils) and xdg-mime (xdg-utils)."
        return 1
    fi

    wanted=$(cat <<'EOF'
[Desktop Entry]
Type=Application
Name=Files (SMB shares)
Comment=Open smb:// links from the browser in GNOME Files
Exec=env -u GIO_USE_VFS nautilus %U
Icon=org.gnome.Nautilus
Terminal=false
NoDisplay=true
MimeType=x-scheme-handler/smb;
Categories=GTK;GNOME;Utility;
EOF
)

    mkdir -p "$apps_dir" || return 1
    if [ ! -f "$entry" ] || [ "$(cat "$entry")" != "$wanted" ]; then
        if [ -f "$entry" ]; then
            cp -f "$entry" "$entry.bak" || return 1
            info "Replacing $entry (the previous one is kept as $entry.bak)..."
        fi
        printf '%s\n' "$wanted" > "$entry" || return 1
        changed=1
    fi
    # GIO lists the applications for a scheme from this database, not from the entry itself.
    if [ "$changed" = 1 ] || ! grep -Fxqs 'x-scheme-handler/smb=smb-nautilus.desktop;' "$apps_dir/mimeinfo.cache"; then
        update-desktop-database "$apps_dir" || return 1
        changed=1
    fi
    # Not `xdg-mime query default`: with no default set it already names the one registered
    # handler, so it would hide a missing setting that registration order alone then decides.
    if ! grep -Fxqs 'x-scheme-handler/smb=smb-nautilus.desktop' "$mime_config"; then
        # xdg-mime does nothing, yet exits 0, when the folder is missing; so make the folder
        # and read the result back instead of trusting its exit status.
        mkdir -p "$(dirname "$mime_config")" || return 1
        if [ -f "$mime_config" ]; then
            cp -f "$mime_config" "$mime_config.bak" || return 1
        fi
        xdg-mime default smb-nautilus.desktop x-scheme-handler/smb || return 1
        if ! grep -Fxqs 'x-scheme-handler/smb=smb-nautilus.desktop' "$mime_config"; then
            warn "xdg-mime did not set the default application for smb:// links in $mime_config."
            return 1
        fi
        changed=1
    fi

    if [ "$changed" = 1 ]; then
        info "smb:// links now open in GNOME Files."
    else
        info "smb:// links already open in GNOME Files, skipping."
    fi
}

# Undo smb_scheme_handler_install: the entry, its registration, and the default, but only when
# the default is the one the install set.  Anything else in mimeapps.list stays.
smb_scheme_handler_uninstall() {
    local apps_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    local mime_config="${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list"

    rm -f "$apps_dir/smb-nautilus.desktop"
    if [ -f "$mime_config" ] && grep -Fxq 'x-scheme-handler/smb=smb-nautilus.desktop' "$mime_config"; then
        sed -i '/^x-scheme-handler\/smb=smb-nautilus\.desktop$/d' "$mime_config" || return 1
    fi
    if [ -f "$apps_dir/mimeinfo.cache" ] && command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database "$apps_dir" || return 1
    fi
    return 0
}

###############################################################
# => GNOME screenshot shortcut (<Super><Shift>s)
###############################################################

# Bind <Super><Shift>s alongside Print for GNOME Shell's interactive screenshot UI
# (org.gnome.shell.keybindings show-screenshot-ui), so 75% and compact keyboards without
# a dedicated Print Screen key (such as the Keychron V1 Max) can open it directly.
# Existing bindings in the array are kept.  After `gsettings set`, the value is read back
# in a fresh process: without a session D-Bus bus, gsettings falls back to its in-memory
# backend and exits 0 without persisting anything.  Machines without gsettings or without
# the GNOME Shell keybindings schema are skipped.
gnome_screenshot_shortcut_install() {
    local schema="org.gnome.shell.keybindings"
    local key="show-screenshot-ui"
    local shortcut="'<Super><Shift>s'"
    local pattern="'(<Super><Shift>|<Shift><Super>)[sS]'"
    local current wanted updated

    if ! current="$(gsettings get "$schema" "$key" 2>/dev/null)"; then
        info "GNOME Shell keybindings schema is not available, skipping the screenshot shortcut."
        return 0
    fi

    if [[ "$current" =~ $pattern ]]; then
        info "GNOME screenshot shortcut (<Super><Shift>s) is already set, skipping."
        return 0
    fi

    if [[ "$current" == "@as []" || "$current" == "[]" ]]; then
        wanted="[$shortcut]"
    elif [[ "$current" == \[*\] ]]; then
        wanted="${current%]*}, $shortcut]"
    else
        warn "Unexpected $schema $key value: $current"
        return 1
    fi

    gsettings set "$schema" "$key" "$wanted" || return 1
    updated="$(gsettings get "$schema" "$key" 2>/dev/null)" || return 1
    if ! [[ "$updated" =~ $pattern ]]; then
        warn "gsettings did not persist $shortcut for $schema $key (run from a graphical GNOME session)."
        return 1
    fi
    info "GNOME screenshot shortcut set to $updated."
}

# Undo gnome_screenshot_shortcut_install: remove '<Super><Shift>s' (or '<Shift><Super>s')
# from show-screenshot-ui while keeping any other bindings in the array.
gnome_screenshot_shortcut_uninstall() {
    local schema="org.gnome.shell.keybindings"
    local key="show-screenshot-ui"
    local pattern="'(<Super><Shift>|<Shift><Super>)[sS]'"
    local current updated

    current="$(gsettings get "$schema" "$key" 2>/dev/null)" || return 0
    [[ "$current" =~ $pattern ]] || return 0

    updated="$(printf '%s\n' "$current" | sed -E "s/, *${pattern}//g; s/${pattern}, *//g; s/${pattern}//g")"
    if [[ "$updated" == "[]" ]]; then
        updated="@as []"
    fi
    gsettings set "$schema" "$key" "$updated" || return 1
}

###############################################################
# => GNOME and XWayland keyboard layout (es + caps:swapescape)
###############################################################

# Set the Spanish ('es') keyboard layout and Caps Lock <-> Escape ('caps:swapescape') in
# GNOME (org.gnome.desktop.input-sources) and in the active X11/XWayland server.  On GNOME
# Wayland, Xwayland initializes _XKB_RULES_NAMES on the root window to 'us' even when Mutter
# uses 'es', so a bare `setxkbmap -option ...` without `-layout es` overwrites the XWayland
# keymap with 'us'.  Setting both gsettings and `setxkbmap -layout es -option caps:swapescape`
# keeps native Wayland and XWayland apps aligned.
gnome_keyboard_layout_install() {
    local schema="org.gnome.desktop.input-sources"
    local source_tuple="('xkb', 'es')"
    local option="'caps:swapescape'"
    local sources options stripped wanted_sources wanted_options updated_sources updated_options
    local changed=0

    if sources="$(gsettings get "$schema" sources 2>/dev/null)" &&
        options="$(gsettings get "$schema" xkb-options 2>/dev/null)"; then
        if [[ "$sources" == "[$source_tuple"* ]]; then
            wanted_sources="$sources"
        elif [[ "$sources" == "@a(ss) []" || "$sources" == "[]" ]]; then
            wanted_sources="[$source_tuple]"
        elif [[ "$sources" == *"$source_tuple"* && "$sources" == \[*\] ]]; then
            stripped="$(printf '%s\n' "$sources" | sed -E "s/, *\\('xkb', 'es'\\)//g; s/\\('xkb', 'es'\\), *//g")"
            wanted_sources="[$source_tuple, ${stripped#[}"
        elif [[ "$sources" == \[*\] ]]; then
            wanted_sources="[$source_tuple, ${sources#[}"
        else
            warn "Unexpected $schema sources value: $sources"
            return 1
        fi

        if [[ "$wanted_sources" != "$sources" ]]; then
            gsettings set "$schema" sources "$wanted_sources" || return 1
            updated_sources="$(gsettings get "$schema" sources 2>/dev/null)" || return 1
            if [[ "$updated_sources" != "[$source_tuple"* ]]; then
                warn "gsettings did not persist $source_tuple for $schema sources (run from a graphical GNOME session)."
                return 1
            fi
            changed=1
        fi

        if [[ "$options" == *"$option"* ]]; then
            wanted_options="$options"
        elif [[ "$options" == "@as []" || "$options" == "[]" ]]; then
            wanted_options="[$option]"
        elif [[ "$options" == \[*\] ]]; then
            wanted_options="${options%]*}, $option]"
        else
            warn "Unexpected $schema xkb-options value: $options"
            return 1
        fi

        if [[ "$wanted_options" != "$options" ]]; then
            gsettings set "$schema" xkb-options "$wanted_options" || return 1
            updated_options="$(gsettings get "$schema" xkb-options 2>/dev/null)" || return 1
            if [[ "$updated_options" != *"$option"* ]]; then
                warn "gsettings did not persist $option for $schema xkb-options (run from a graphical GNOME session)."
                return 1
            fi
            changed=1
        fi
    else
        info "GNOME input-sources schema is not available, skipping the GNOME keyboard settings."
    fi

    if [ -n "${DISPLAY:-}" ] && command -v setxkbmap >/dev/null 2>&1; then
        setxkbmap -layout es -option caps:swapescape >/dev/null 2>&1 || return 1
        changed=1
    fi

    if [ "$changed" -eq 1 ]; then
        info "Keyboard layout set to Spanish (es) with caps:swapescape."
    else
        info "Keyboard layout (es, caps:swapescape) is already set, skipping."
    fi
}

# Undo the xkb-options part of gnome_keyboard_layout_install: remove 'caps:swapescape'
# while keeping any other options and leaving the user's input-sources layout untouched.
gnome_keyboard_layout_uninstall() {
    local schema="org.gnome.desktop.input-sources"
    local option="'caps:swapescape'"
    local current updated

    current="$(gsettings get "$schema" xkb-options 2>/dev/null)" || return 0
    [[ "$current" == *"$option"* ]] || return 0

    updated="$(printf '%s\n' "$current" | sed -E "s/, *'caps:swapescape'//g; s/'caps:swapescape', *//g; s/'caps:swapescape'//g")"
    if [[ "$updated" == "[]" ]]; then
        updated="@as []"
    fi
    gsettings set "$schema" xkb-options "$updated" || return 1
}

###############################################################
# => Volatile file handling
###############################################################

# Files that are tracked in the repo for their initial settings but are
# rewritten by their apps on every launch.  skip-worktree keeps the committed
# version visible in the repo while silencing constant runtime noise.
###############################################################
# => NVIDIA display config (anti-tearing & FreeSync)
###############################################################

nvidia_display_config() {
    info "Configuring NVIDIA display settings..."

    if ! command -v nvidia-smi &>/dev/null; then
        info "No NVIDIA driver detected, skipping display config."
        return
    fi

    local xorg_conf="/etc/X11/xorg.conf.d/20-nvidia.conf"

    # ── ForceFullCompositionPipeline ─────────────────────────────
    # Eliminates screen tearing by compositing every frame before
    # scanout. Adds ~1 frame of input lag — negligible outside
    # competitive FPS games.
    #
    # ── FreeSync / G-Sync Compatible ────────────────────────────
    # AllowGSYNCCompatible lets NVIDIA use your monitor's FreeSync
    # for variable refresh rate (VRR), eliminating tearing WITHOUT
    # the extra input lag of the composition pipeline.
    #
    # ⚠ REQUIREMENT: FreeSync over NVIDIA on Linux requires a
    # DisplayPort connection. HDMI is NOT supported.
    # If you switch to DisplayPort and want FreeSync, set
    # ENABLE_FREESYNC=true below and disable ForceFullCompositionPipeline
    # (they conflict — FreeSync is the better solution when available).

    local ENABLE_FREESYNC=false          # Set to true when using DisplayPort

    sudo mkdir -p /etc/X11/xorg.conf.d

    if [ "$ENABLE_FREESYNC" = true ]; then
        info "Enabling FreeSync (G-Sync Compatible) — requires DisplayPort."
        sudo tee "$xorg_conf" > /dev/null <<'EOF'
# NVIDIA anti-tearing & FreeSync — managed by bootstrap
# FreeSync/G-Sync Compatible mode (requires DisplayPort, not HDMI)
Section "Device"
    Identifier "NVIDIA"
    Driver     "nvidia"
    Option     "AllowGSYNCCompatible" "true"
EndSection
EOF
    else
        info "Enabling ForceFullCompositionPipeline (HDMI — no FreeSync)."
        sudo tee "$xorg_conf" > /dev/null <<'EOF'
# NVIDIA anti-tearing — managed by bootstrap
# ForceFullCompositionPipeline: composites every frame to prevent tearing.
# Adds ~1 frame of input lag. If you switch to DisplayPort, enable
# FreeSync instead (set ENABLE_FREESYNC=true in base_functions).
Section "Screen"
    Identifier "Screen0"
    Option     "metamodes" "nvidia-auto-select +0+0 { ForceFullCompositionPipeline = On }"
EndSection
EOF
    fi

    info "NVIDIA display config written to $xorg_conf (takes effect after reboot/re-login)."
}

# This file is <checkout>/.local/scripts/bootstrap/base_functions, so the checkout is three levels
# up.  `cd -P` resolves the Stow link first: sourced as ~/.local/scripts/bootstrap/base_functions
# (the uninstallers do), a plain `..` walks up the link's own path and ends in $HOME.  A script
# that is not there is reported, because a silent skip is how a wrong path went unnoticed.
apply_skip_worktree() {
    local dotfiles_root script
    dotfiles_root="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
    script="$dotfiles_root/.local/scripts/apply-skip-worktree"

    info "Applying skip-worktree to volatile config files..."
    if [ -x "$script" ]; then
        "$script" --verbose "$dotfiles_root"
    else
        warn "apply-skip-worktree not found at $script; the volatile config files are not masked."
    fi
}

###############################################################
# => NVIDIA Container Toolkit (GPU access for containers)
###############################################################

# The toolkit comes from NVIDIA's own apt repository (a flat repository, so its
# source has no Components line) and only receives updates while that source is
# enabled.  Ubuntu release upgrades disable third-party sources, after which the
# weekly full-upgrade skips the package without any error (see the IDE installs
# above).  So the source is re-asserted on every bootstrap run and by
# `make repair REPAIR=nvidia-container-toolkit`.
# The package list is a global array on purpose: audit_installation.py reads it
# (STANDALONE_INSTALLERS), so the audit counts the package as declared by the
# bootstrap without expecting it on machines that have no NVIDIA GPU.
NVIDIA_CONTAINER_TOOLKIT_PACKAGES=(
    nvidia-container-toolkit
)

## Succeed when this machine has an NVIDIA display adapter: a PCI device from NVIDIA
## (vendor 0x10de) of a display class (0x03xxxx: VGA, 3D or other display controller).
## The card's HDMI audio function has the same vendor but class 0x0403, so it does not
## count.  This reads sysfs, so it needs neither pciutils nor a loaded driver (a driver
## installed this run may still be waiting for a reboot).  PCI_DEVICES_DIR overrides
## /sys/bus/pci/devices (the tests use it).
nvidia_gpu_present() {
    local devices_dir="${PCI_DEVICES_DIR:-/sys/bus/pci/devices}"
    local device vendor class

    for device in "$devices_dir"/*; do
        { [ -r "$device/vendor" ] && [ -r "$device/class" ]; } || continue
        vendor=$(<"$device/vendor")
        class=$(<"$device/class")
        if [ "$vendor" = 0x10de ] && [[ "$class" == 0x03* ]]; then
            return 0
        fi
    done
    return 1
}

## Register the NVIDIA Container Toolkit apt source (a deb822 .sources file, written
## only after NVIDIA's signing key is installed) and refresh apt once when it changed.
## A source that a release upgrade disabled is rewritten.  NVIDIA_CONTAINER_TOOLKIT_KEYRING
## overrides the keyring path (the tests use it).
nvidia_container_toolkit_source_ensure() {
    local keyring="${NVIDIA_CONTAINER_TOOLKIT_KEYRING:-/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg}"
    local architecture

    architecture=$(dpkg --print-architecture) || return 1
    APT_SOURCES_CHANGED=false
    apt_vendor_source_ensure nvidia-container-toolkit \
        "https://nvidia.github.io/libnvidia-container/stable/deb/$architecture" / "" "" \
        https://nvidia.github.io/libnvidia-container/gpgkey "$keyring" || return 1
    if [ "$APT_SOURCES_CHANGED" = true ]; then
        apt_sources_apply sudo apt-get update || return 1
    fi
}

## Install the NVIDIA Container Toolkit on a machine with an NVIDIA GPU.  Every other
## machine is skipped, so profiles can call this unconditionally.  It needs the network
## (NVIDIA's apt repository), so profiles only warn when it fails.  It installs the
## package and nothing more: pointing Docker at the NVIDIA runtime edits
## /etc/docker/daemon.json and restarts the daemon, which stays the user's decision, so
## a first install prints the command instead.  APT_SOURCES_DRY_RUN=true
## (`make repair REPAIR=nvidia-container-toolkit DRY_RUN=true`) only reports the changes.
nvidia_container_toolkit_install() {
    local package was_installed=true

    if ! nvidia_gpu_present; then
        info "No NVIDIA GPU detected, skipping the NVIDIA Container Toolkit."
        return 0
    fi

    info "Installing the NVIDIA Container Toolkit..."
    for package in "${NVIDIA_CONTAINER_TOOLKIT_PACKAGES[@]}"; do
        dpkg -s "$package" 2>/dev/null | grep -q '^Status: install ok installed' || was_installed=false
    done

    nvidia_container_toolkit_source_ensure || return 1
    apt_sources_apply sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y \
        "${NVIDIA_CONTAINER_TOOLKIT_PACKAGES[@]}" || return 1

    if [ "$was_installed" = false ] && [ "${APT_SOURCES_DRY_RUN:-false}" != true ] &&
        command -v docker &>/dev/null; then
        info "To give Docker GPU access, run: sudo nvidia-ctk runtime configure --runtime=docker && sudo systemctl restart docker"
    fi
}

## Remove the NVIDIA Container Toolkit, its apt source (including the one-line files
## older setups wrote) and its signing key.  Docker's daemon.json is left alone, so
## delete the nvidia runtime from it by hand if you configured one.
## The name is short on purpose ("ctk" is NVIDIA's own abbreviation, as in nvidia-ctk):
## the uninstall checklists show the function name as a tag column as wide as the
## longest tag, and the full name clipped the description of every other row.
nvidia_ctk_uninstall() {
    local sources_dir="${APT_SOURCES_DIR:-/etc/apt/sources.list.d}"
    local keyring="${NVIDIA_CONTAINER_TOOLKIT_KEYRING:-/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg}"

    info "Uninstalling the NVIDIA Container Toolkit..."
    sudo apt-get remove --purge -y "${NVIDIA_CONTAINER_TOOLKIT_PACKAGES[@]}" || true
    sudo rm -f "$sources_dir/nvidia-container-toolkit.sources" \
        "$sources_dir/nvidia-container-toolkit.list" \
        "$sources_dir/nvidia-container-toolkit.list.bak" \
        "$keyring"
}

