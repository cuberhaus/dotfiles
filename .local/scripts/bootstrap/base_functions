#! /usr/bin/env bash

###############################################################
# => Logging helpers (sourced by all bootstrap scripts)
###############################################################

info()  { printf '\033[1;34m[INFO]\033[0m  %s\n' "$*"; }
warn()  { printf '\033[1;33m[WARN]\033[0m  %s\n' "$*"; }
error() { printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2; }

configure_brightness_access() {
    local brightness_user
    brightness_user="$(id -un)"
    sudo usermod -a -G video "$brightness_user"
    if getent group i2c >/dev/null 2>&1; then
        sudo usermod -a -G i2c "$brightness_user"
    fi
}

## Report whether bootstrap stdout was interactive before logging redirection.
bootstrap_stdout_is_interactive() {
    [ "${BOOTSTRAP_STDOUT_WAS_TTY:-false}" = true ] || [ -t 1 ]
}

## Mirror bootstrap output to the terminal and a persistent per-run log.
bootstrap_enable_logging() {
    local profile="$1"
    local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/cuberhaus/bootstrap"
    local timestamp

    timestamp="$(date -u '+%Y%m%dT%H%M%SZ')"
    mkdir -p "$state_dir"
    BOOTSTRAP_LOG_FILE="$state_dir/${profile}-${timestamp}-$$.log"
    if [ -t 1 ]; then
        BOOTSTRAP_STDOUT_WAS_TTY=true
    else
        BOOTSTRAP_STDOUT_WAS_TTY=false
    fi
    export BOOTSTRAP_LOG_FILE BOOTSTRAP_STDOUT_WAS_TTY

    exec > >(tee -a "$BOOTSTRAP_LOG_FILE") 2>&1
    BOOTSTRAP_LOG_TEE_PID=$!
    export BOOTSTRAP_LOG_TEE_PID
    info "Logging bootstrap output to $BOOTSTRAP_LOG_FILE"
}

parse_bootstrap_args() {
    DUAL_BOOT_UTC=false
    UNATTENDED=false
    SKIP_STOW=false
    HIGH_DPI_CHOICE=""

    while (( $# > 0 )); do
        case "$1" in
            --dual-boot-utc)
                DUAL_BOOT_UTC=true
                ;;
            --unattended)
                UNATTENDED=true
                ;;
            --no-stow)
                SKIP_STOW=true
                ;;
            --high-dpi=yes|--high-dpi=no)
                HIGH_DPI_CHOICE="${1#*=}"
                ;;
            *)
                error "Unknown bootstrap option: $1"
                return 2
                ;;
        esac
        shift
    done

    export DUAL_BOOT_UTC UNATTENDED SKIP_STOW HIGH_DPI_CHOICE
}

## Return the dotfiles checkout root used by this bootstrap invocation.
bootstrap_repository_root() {
    if [ -n "${DOTFILES_ROOT:-}" ] && [ -d "$DOTFILES_ROOT" ]; then
        printf '%s\n' "$DOTFILES_ROOT"
        return 0
    fi

    cd -P "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd
}

## Report whether this bootstrap invocation can obtain a confirmation response.
bootstrap_stdin_is_interactive() {
    [ -t 0 ] && bootstrap_stdout_is_interactive
}

## Ask whether to apply the displayed Stow and conflict-backup plan.
bootstrap_confirm_stow() {
    local answer
    read -r -p "Apply the displayed Stow plan? [y/N] " answer
    [[ "$answer" =~ ^([yY][eE][sS]|[yY])$ ]]
}

## Return whether GNU Stow is available on the current PATH.
bootstrap_stow_is_available() {
    command -v stow >/dev/null 2>&1
}

## Install GNU Stow through the package manager for the selected profile.
bootstrap_install_stow() {
    local profile="$1"

    info "GNU Stow is required to link this checkout; installing it for $profile..."
    case "$profile" in
        ubuntu|ubuntu-windows|work)
            sudo apt-get install -y stow
            ;;
        arch|manjaro)
            sudo pacman -S --noconfirm --needed stow
            ;;
        gentoo)
            sudo emerge --ask=n --noreplace --select app-admin/stow
            ;;
        mac)
            if ! command -v brew >/dev/null 2>&1; then
                if declare -F brew_install >/dev/null 2>&1; then
                    brew_install
                else
                    error "Homebrew is required to install GNU Stow on macOS."
                    return 1
                fi
            fi
            brew install stow
            ;;
        *)
            error "No GNU Stow installer is configured for bootstrap profile: $profile"
            return 2
            ;;
    esac

    if ! bootstrap_stow_is_available; then
        error "GNU Stow installation did not make the stow command available."
        return 1
    fi
}

## Preview and, with confirmation, link the current checkout through GNU Stow.
bootstrap_stow_checkout() {
    local profile="$1"
    local dotfiles_root parent_dir package_name preview

    if [ "${SKIP_STOW:-false}" = true ]; then
        info "Skipping Stow linking (--no-stow); continuing from the checkout paths."
        return 0
    fi

    if [ "${UNATTENDED:-false}" = true ] || ! bootstrap_stdin_is_interactive; then
        warn "Stow linking was not applied because confirmation is unavailable. Continuing from checkout paths; rerun interactively or pass --no-stow."
        return 0
    fi

    if ! bootstrap_stow_is_available; then
        bootstrap_install_stow "$profile"
    fi

    dotfiles_root="$(bootstrap_repository_root)"
    parent_dir="$(dirname "$dotfiles_root")"
    package_name="$(basename "$dotfiles_root")"
    preview="$(stow -v -n -t "$HOME" -d "$parent_dir" "$package_name" 2>&1 || true)"

    info "Stow dry run for $dotfiles_root:"
    if [ -n "$preview" ]; then
        printf '%s\n' "$preview"
    else
        info "No Stow changes are needed."
        return 0
    fi

    info "Conflict backup plan:"
    bash "$dotfiles_root/.local/scripts/stow-backup-conflicts" --dry-run

    if ! bootstrap_confirm_stow; then
        info "Stow linking declined; continuing from checkout paths."
        return 0
    fi

    bash "$dotfiles_root/.local/scripts/stow-backup-conflicts"
    stow -v -t "$HOME" -d "$parent_dir" "$package_name"
}

## Tell whether a Git credential helper saves passwords in plain text.
##
## That is the built-in 'store' helper in every spelling Git accepts: 'store',
## 'store --file=PATH', and an external 'git credential-store' or
## '.../git-credential-store' command.
git_credential_helper_is_plaintext() {
    case "$1" in
        store | store\ * | *credential-store | *credential-store\ * | *credential\ store | *credential\ store\ *)
            return 0
            ;;
    esac
    return 1
}

## Keep Git from saving HTTPS passwords unencrypted in ~/.git-credentials.
##
## The 'store' helper writes every password and token it is given to that file as
## plain text, readable by anyone who can read the home folder, root included. This
## replaces it, in place, with the in-memory 'cache' helper, which forgets after eight
## hours and never touches the disk. A helper that is not 'store' (libsecret,
## osxkeychain, ...) is left alone, so rerunning never downgrades a better choice, and
## helpers for one host, such as the 'gh' ones, are never touched. A leftover
## ~/.git-credentials is reported, never deleted or printed. Every failure warns and
## returns 0, so it cannot stop a bootstrap. Keep the helper in step with
## SECURE_CREDENTIAL_HELPER in audit_installation.py and .local/Mini/.gitconfig.
git_credential_helper_configure() {
    local secure_helper='cache --timeout=28800'
    local listing first_line helper status=0 plaintext=0 others=0 first=true failed=false

    if ! command -v git >/dev/null 2>&1; then
        warn "git is not installed, so its credential helper was not checked."
        return 0
    fi

    listing="$(git config --global --get-all credential.helper 2>&1)" || status=$?
    if [ "$status" -gt 1 ]; then
        first_line=${listing%%$'\n'*}
        warn "The global Git config could not be read, so its credential helper was left alone: $first_line"
        return 0
    fi

    while IFS= read -r helper; do
        [ -n "$helper" ] || continue
        if git_credential_helper_is_plaintext "$helper"; then
            plaintext=$((plaintext + 1))
        else
            others=$((others + 1))
        fi
    done <<< "$listing"

    if [ "$plaintext" -eq 0 ]; then
        if [ "$others" -gt 0 ]; then
            info "Git credential helper left as is: it does not save passwords in plain text."
        elif git config --global --add credential.helper "$secure_helper"; then
            info "Git credential helper set to '$secure_helper' (kept in memory, never on disk)."
        else
            failed=true
        fi
    else
        # The first plain-text helper becomes the secure one where it stands, unless another
        # helper already covers it; the other plain-text spellings are removed.
        while IFS= read -r helper; do
            git_credential_helper_is_plaintext "$helper" || continue
            if [ "$first" = true ] && [ "$others" -eq 0 ]; then
                first=false
                # --replace-all, because a plain replace refuses a value that is listed twice.
                git config --global --fixed-value --replace-all credential.helper "$secure_helper" "$helper" || failed=true
            else
                # A repeated value is already gone after its first removal, which is not an error.
                git config --global --fixed-value --unset-all credential.helper "$helper" || true
            fi
        done <<< "$listing"
        info "Git credential helper: the 'store' helper kept passwords in plain text; replaced it with '$secure_helper'."
    fi

    # Judge by what is in the config now, not by the commands that ran.
    listing="$(git config --global --get-all credential.helper 2>/dev/null)" || true
    while IFS= read -r helper; do
        if [ -n "$helper" ] && git_credential_helper_is_plaintext "$helper"; then
            failed=true
        fi
    done <<< "$listing"
    if [ "$failed" = true ]; then
        warn "Git still has a credential helper that saves passwords in plain text; see: git config --global --show-origin --get-all credential.helper"
    fi

    if [ -e "$HOME/.git-credentials" ]; then
        # The tilde is meant literally: it is only displayed.
        # shellcheck disable=SC2088
        warn "~/.git-credentials still holds saved passwords in plain text; delete it once nothing needs them."
    fi
    return 0
}

obsidian_vault_install() {
    local vault_root="${OBSIDIAN_VAULT_ROOT:-$HOME/cuberhaus/obsidian_vault}"
    local vault_parent

    vault_parent="$(dirname "$vault_root")"
    if [ -e "$vault_root" ] && [ ! -d "$vault_root/.git" ]; then
        error "Obsidian vault path exists but is not a Git checkout: $vault_root"
        return 1
    fi

    if [ ! -d "$vault_root/.git" ]; then
        info "Cloning Obsidian vault into $vault_root..."
        mkdir -p "$vault_parent"
        git clone https://github.com/cuberhaus/obsidian_vault.git "$vault_root"
    else
        info "Obsidian vault already exists, skipping clone."
    fi

    info "Installing Obsidian community plugins..."
    make -C "$vault_root" plugin-install
}

## Install the Vim/Neovim plugins and make sure YouCompleteMe can start.
##
## Neovim runs headless, so this needs no terminal and is safe inside the logged,
## unattended bootstraps. vim-plug's 'do' hook in .vim/vimrc builds YouCompleteMe
## for a new install; ycm.sh then verifies the result and repairs what the hook
## missed (an interrupted earlier install, an outdated core). Both steps are
## idempotent, so rerunning is safe. The profile supplies Neovim, the build tools
## and the Python provider as packages.
vim_plugins_install() {
    local vimrc="$HOME/.vim/vimrc"
    local ycm="${DOTFILES_ROOT:-$HOME}/.local/scripts/ycm.sh"
    local status=0

    if [ ! -r "$vimrc" ]; then
        error "$vimrc not found; link the dotfiles first so the plugin list exists."
        return 1
    fi
    if ! command -v nvim >/dev/null 2>&1; then
        error "Neovim is not installed, so the Vim plugins cannot be installed."
        return 1
    fi

    # vim-plug reports failures in its own window, not in the exit status; the
    # ycm.sh run below verifies the part that matters. Stdin and credential
    # prompts are closed so a plugin hook can fail but never hang the bootstrap.
    GIT_TERMINAL_PROMPT=0 nvim --headless '+PlugInstall --sync' '+qa!' </dev/null ||
        {
            warn "Neovim exited with an error while installing the plugins."
            status=1
        }
    bash "$ycm" || status=1
    return "$status"
}

resolve_high_dpi_choice() {
    case "${HIGH_DPI_CHOICE:-}" in
        yes) HIGH_DPI=true ;;
        no) HIGH_DPI=false ;;
        "")
            if [ "${UNATTENDED:-false}" = true ]; then
                HIGH_DPI=false
            else
                local answer
                read -r -p "Do you have a high DPI screen? [y/N] " answer
                [[ "$answer" =~ ^([yY][eE][sS]|[yY])$ ]] && HIGH_DPI=true || HIGH_DPI=false
            fi
            ;;
        *)
            error "Invalid high-DPI choice: $HIGH_DPI_CHOICE"
            return 2
            ;;
    esac
    export HIGH_DPI
}

# This has some problems with some apps that are seen very tiny, it is definitely not the perfect solution
high_dpi_screen() {
    # To fix high dpi screens, two options, go to 200% scaling, or fractional scaling, fractional scaling causes blurry text, more power usage, lower speed.

    # We instead increase text scaling
    gsettings set org.gnome.desktop.interface text-scaling-factor 1.3

    # Increase cursor size Settings-> Accesibility -> Cursor size -> Medium
    gsettings set org.gnome.desktop.interface cursor-size 35
    # Set icons to Large 'small' to set it smaller
    gsettings set org.gnome.shell.extensions.ding icon-size 'large'
}

is_wsl() {
    grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null ||
        grep -qi microsoft /proc/version 2>/dev/null
}

is_systemd_booted() {
    [ -d /run/systemd/system ] && command -v timedatectl >/dev/null 2>&1
}

configure_dual_boot_utc_rtc() {
    [ "${DUAL_BOOT_UTC:-false}" = true ] || return 0

    if is_wsl; then
        error "--dual-boot-utc is only valid on physical Linux installations, not WSL."
        return 1
    fi
    if ! is_systemd_booted; then
        error "--dual-boot-utc requires a Linux system booted with systemd and timedatectl."
        return 1
    fi

    info "Enabling network time synchronization before changing the hardware clock..."
    sudo timedatectl set-ntp true

    local attempts="${DUAL_BOOT_NTP_ATTEMPTS:-12}"
    local interval="${DUAL_BOOT_NTP_INTERVAL_SECONDS:-5}"
    local synchronized=false
    local attempt
    for (( attempt = 1; attempt <= attempts; attempt++ )); do
        if [ "$(timedatectl show --property=NTPSynchronized --value 2>/dev/null)" = yes ]; then
            synchronized=true
            break
        fi
        if (( attempt < attempts )); then
            sleep "$interval"
        fi
    done

    if [ "$synchronized" != true ]; then
        error "Network time did not synchronize; refusing to write an untrusted time to the hardware clock."
        return 1
    fi

    info "Configuring the hardware clock to use UTC..."
    sudo timedatectl set-local-rtc 0

    if [ "$(timedatectl show --property=LocalRTC --value 2>/dev/null)" != no ]; then
        error "Failed to verify LocalRTC=no after configuring the hardware clock."
        return 1
    fi

    info "Hardware clock now uses UTC (LocalRTC=no)."
}

## Print the running kernel's per-user inotify watch limit.
running_inotify_watch_limit() {
    cat /proc/sys/fs/inotify/max_user_watches
}

## Raise the per-user inotify watch limit so editors, Obsidian, and file syncers
## can watch large workspaces at the same time.
##
## Every program shares one pool of watches per user. Some distributions cap it
## low (Ubuntu's localsearch ships 65536), and a full pool makes Obsidian fail
## with "ENOSPC: System limit for number of file watchers reached". The limit is
## persisted in a drop-in whose 99- prefix sorts after those distro defaults,
## then applied to the running kernel. Existing higher limits are never lowered.
## Override the value with INOTIFY_MAX_USER_WATCHES (the drop-in path with
## INOTIFY_SYSCTL_CONF, which exists so tests can avoid touching /etc).
configure_inotify_watches() {
    [ "$(uname -s)" = Linux ] || return 0

    local limit="${INOTIFY_MAX_USER_WATCHES:-524288}"
    local conf="${INOTIFY_SYSCTL_CONF:-/etc/sysctl.d/99-inotify.conf}"
    local persisted running

    if [[ ! "$limit" =~ ^[1-9][0-9]*$ ]]; then
        error "INOTIFY_MAX_USER_WATCHES must be a positive integer, got: $limit"
        return 2
    fi

    # sysctl applies the last assignment in a file, so the last one is the
    # effective value; both "key=value" and "key = value" are valid syntax.
    persisted="$(awk -F= '
        /^[[:space:]]*fs\.inotify\.max_user_watches[[:space:]]*=/ {
            gsub(/[[:space:]]/, "", $2)
            value = $2
        }
        END { print value }' "$conf" 2>/dev/null || true)"

    if [[ "$persisted" =~ ^[0-9]+$ ]] && (( persisted >= limit )); then
        info "inotify watch limit is already persisted at $persisted, skipping."
    else
        info "Persisting fs.inotify.max_user_watches=$limit in $conf..."
        printf '%s\n' \
            '# Managed by dotfiles bootstrap.' \
            '# Editors, Obsidian, and file syncers share one per-user inotify watch pool.' \
            "fs.inotify.max_user_watches=$limit" | sudo tee -a "$conf" > /dev/null
    fi

    running="$(running_inotify_watch_limit 2>/dev/null || echo 0)"
    if ! [[ "$running" =~ ^[0-9]+$ ]] || (( running < limit )); then
        info "Raising the running inotify watch limit to $limit..."
        sudo sysctl -w "fs.inotify.max_user_watches=$limit" > /dev/null ||
            warn "Could not raise the running inotify watch limit; the persisted value applies after the next reboot."
    fi
}

