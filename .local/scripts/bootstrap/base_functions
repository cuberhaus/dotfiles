#! /usr/bin/env bash

###############################################################
# => Logging helpers (sourced by all bootstrap scripts)
###############################################################

info()  { printf '\033[1;34m[INFO]\033[0m  %s\n' "$*"; }
warn()  { printf '\033[1;33m[WARN]\033[0m  %s\n' "$*"; }
error() { printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2; }

###############################################################
# => XDG defaults (in case .zshenv hasn't been sourced)
###############################################################

: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_CACHE_HOME:=$HOME/.cache}"

###############################################################
# => Common functions
###############################################################

install_preparation() {
    info "Preparing environment..."

    echo "colorscheme onedark
    set background=dark" > "$HOME/.vim/theme"

    # Fix some errors and cleanup
    # mkdir always before touch
    sudo mkdir -p "$XDG_DATA_HOME"/vim/{undo,swap,backup} # Fixes vim
    sudo chown -R "$USER":"$USER" "$XDG_DATA_HOME/vim/"
    mkdir -p "$HOME/.cache/zsh"
    sudo chown -R "$USER":"$USER" "$HOME/.cache/zsh/"
    mkdir -p "$HOME/.cache/vlc"
    sudo chown -R "$USER":"$USER" "$HOME/.cache/vlc/"
    mkdir -p "$HOME/.vim/cache"
    sudo chown -R "$USER":"$USER" "$HOME/.vim/cache"

    touch "$HOME/.vim/cache/viminfo" # viminfo
    touch "$XDG_DATA_HOME/vim/viminfo" # viminfo

    sudo mkdir -p /var/lib/samba/usershares
}

###############################################################
# => Volatile file handling
###############################################################

# Files that are tracked in the repo for their initial settings but are
# rewritten by their apps on every launch.  skip-worktree keeps the committed
# version visible in the repo while silencing constant runtime noise.
apply_skip_worktree() {
    local dotfiles_root
    dotfiles_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

    local files=(
        .config/warp-terminal/user_preferences.json
        .config/libreoffice/4/user/config/javasettings_Linux_X86_64.xml
    )

    info "Applying skip-worktree to volatile config files..."
    for f in "${files[@]}"; do
        if [ -f "$dotfiles_root/$f" ]; then
            git -C "$dotfiles_root" update-index --skip-worktree "$f" \
                && info "  skip-worktree: $f" \
                || warn "  Could not apply skip-worktree to $f"
        else
            info "  Skipping (not yet present): $f"
        fi
    done
}

