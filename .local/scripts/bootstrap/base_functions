#! /usr/bin/env bash

###############################################################
# => Logging helpers (sourced by all bootstrap scripts)
###############################################################

info()  { printf '\033[1;34m[INFO]\033[0m  %s\n' "$*"; }
warn()  { printf '\033[1;33m[WARN]\033[0m  %s\n' "$*"; }
error() { printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2; }

## Report whether bootstrap stdout was interactive before logging redirection.
bootstrap_stdout_is_interactive() {
    [ "${BOOTSTRAP_STDOUT_WAS_TTY:-false}" = true ] || [ -t 1 ]
}

## Mirror bootstrap output to the terminal and a persistent per-run log.
bootstrap_enable_logging() {
    local profile="$1"
    local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/cuberhaus/bootstrap"
    local timestamp

    timestamp="$(date -u '+%Y%m%dT%H%M%SZ')"
    mkdir -p "$state_dir"
    BOOTSTRAP_LOG_FILE="$state_dir/${profile}-${timestamp}-$$.log"
    if [ -t 1 ]; then
        BOOTSTRAP_STDOUT_WAS_TTY=true
    else
        BOOTSTRAP_STDOUT_WAS_TTY=false
    fi
    export BOOTSTRAP_LOG_FILE BOOTSTRAP_STDOUT_WAS_TTY

    exec > >(tee -a "$BOOTSTRAP_LOG_FILE") 2>&1
    BOOTSTRAP_LOG_TEE_PID=$!
    export BOOTSTRAP_LOG_TEE_PID
    info "Logging bootstrap output to $BOOTSTRAP_LOG_FILE"
}

parse_bootstrap_args() {
    DUAL_BOOT_UTC=false
    UNATTENDED=false
    SKIP_STOW=false
    FIRST_RUN_CHOICE=""
    HIGH_DPI_CHOICE=""

    while (( $# > 0 )); do
        case "$1" in
            --dual-boot-utc)
                DUAL_BOOT_UTC=true
                ;;
            --unattended)
                UNATTENDED=true
                ;;
            --no-stow)
                SKIP_STOW=true
                ;;
            --first-run=yes|--first-run=no)
                FIRST_RUN_CHOICE="${1#*=}"
                ;;
            --high-dpi=yes|--high-dpi=no)
                HIGH_DPI_CHOICE="${1#*=}"
                ;;
            *)
                error "Unknown bootstrap option: $1"
                return 2
                ;;
        esac
        shift
    done

    export DUAL_BOOT_UTC UNATTENDED SKIP_STOW FIRST_RUN_CHOICE HIGH_DPI_CHOICE
}

## Return the dotfiles checkout root used by this bootstrap invocation.
bootstrap_repository_root() {
    if [ -n "${DOTFILES_ROOT:-}" ] && [ -d "$DOTFILES_ROOT" ]; then
        printf '%s\n' "$DOTFILES_ROOT"
        return 0
    fi

    cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd
}

## Report whether this bootstrap invocation can obtain a confirmation response.
bootstrap_stdin_is_interactive() {
    [ -t 0 ] && bootstrap_stdout_is_interactive
}

## Ask whether to apply the displayed Stow and conflict-backup plan.
bootstrap_confirm_stow() {
    local answer
    read -r -p "Apply the displayed Stow plan? [y/N] " answer
    [[ "$answer" =~ ^([yY][eE][sS]|[yY])$ ]]
}

## Return whether GNU Stow is available on the current PATH.
bootstrap_stow_is_available() {
    command -v stow >/dev/null 2>&1
}

## Install GNU Stow through the package manager for the selected profile.
bootstrap_install_stow() {
    local profile="$1"

    info "GNU Stow is required to link this checkout; installing it for $profile..."
    case "$profile" in
        ubuntu|ubuntu-windows|work)
            sudo apt-get install -y stow
            ;;
        arch|manjaro)
            sudo pacman -S --noconfirm --needed stow
            ;;
        mac)
            if ! command -v brew >/dev/null 2>&1; then
                if declare -F brew_install >/dev/null 2>&1; then
                    brew_install
                else
                    error "Homebrew is required to install GNU Stow on macOS."
                    return 1
                fi
            fi
            brew install stow
            ;;
        *)
            error "No GNU Stow installer is configured for bootstrap profile: $profile"
            return 2
            ;;
    esac

    if ! bootstrap_stow_is_available; then
        error "GNU Stow installation did not make the stow command available."
        return 1
    fi
}

## Preview and, with confirmation, link the current checkout through GNU Stow.
bootstrap_stow_checkout() {
    local profile="$1"
    local dotfiles_root parent_dir package_name preview

    if [ "${SKIP_STOW:-false}" = true ]; then
        info "Skipping Stow linking (--no-stow); continuing from the checkout paths."
        return 0
    fi

    if [ "${UNATTENDED:-false}" = true ] || ! bootstrap_stdin_is_interactive; then
        warn "Stow linking was not applied because confirmation is unavailable. Continuing from checkout paths; rerun interactively or pass --no-stow."
        return 0
    fi

    if ! bootstrap_stow_is_available; then
        bootstrap_install_stow "$profile"
    fi

    dotfiles_root="$(bootstrap_repository_root)"
    parent_dir="$(dirname "$dotfiles_root")"
    package_name="$(basename "$dotfiles_root")"
    preview="$(stow -v -n -t "$HOME" -d "$parent_dir" "$package_name" 2>&1 || true)"

    info "Stow dry run for $dotfiles_root:"
    if [ -n "$preview" ]; then
        printf '%s\n' "$preview"
    else
        info "No Stow changes are needed."
        return 0
    fi

    info "Conflict backup plan:"
    bash "$dotfiles_root/.local/scripts/stow-backup-conflicts" --dry-run

    if ! bootstrap_confirm_stow; then
        info "Stow linking declined; continuing from checkout paths."
        return 0
    fi

    bash "$dotfiles_root/.local/scripts/stow-backup-conflicts"
    stow -v -t "$HOME" -d "$parent_dir" "$package_name"
}

resolve_first_run_choice() {
    case "${FIRST_RUN_CHOICE:-}" in
        yes) FirstRun=y ;;
        no) FirstRun=n ;;
        "")
            if [ "${UNATTENDED:-false}" = true ]; then
                FirstRun=n
            else
                read -rp "Is this a first-time install? (y/n): " FirstRun
            fi
            ;;
        *)
            error "Invalid first-run choice: $FIRST_RUN_CHOICE"
            return 2
            ;;
    esac
    export FirstRun
}

resolve_high_dpi_choice() {
    case "${HIGH_DPI_CHOICE:-}" in
        yes) HIGH_DPI=true ;;
        no) HIGH_DPI=false ;;
        "")
            if [ "${UNATTENDED:-false}" = true ]; then
                HIGH_DPI=false
            else
                local answer
                read -r -p "Do you have a high DPI screen? [y/N] " answer
                [[ "$answer" =~ ^([yY][eE][sS]|[yY])$ ]] && HIGH_DPI=true || HIGH_DPI=false
            fi
            ;;
        *)
            error "Invalid high-DPI choice: $HIGH_DPI_CHOICE"
            return 2
            ;;
    esac
    export HIGH_DPI
}

is_wsl() {
    grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null ||
        grep -qi microsoft /proc/version 2>/dev/null
}

is_systemd_booted() {
    [ -d /run/systemd/system ] && command -v timedatectl >/dev/null 2>&1
}

configure_dual_boot_utc_rtc() {
    [ "${DUAL_BOOT_UTC:-false}" = true ] || return 0

    if is_wsl; then
        error "--dual-boot-utc is only valid on physical Linux installations, not WSL."
        return 1
    fi
    if ! is_systemd_booted; then
        error "--dual-boot-utc requires a Linux system booted with systemd and timedatectl."
        return 1
    fi

    info "Enabling network time synchronization before changing the hardware clock..."
    sudo timedatectl set-ntp true

    local attempts="${DUAL_BOOT_NTP_ATTEMPTS:-12}"
    local interval="${DUAL_BOOT_NTP_INTERVAL_SECONDS:-5}"
    local synchronized=false
    local attempt
    for (( attempt = 1; attempt <= attempts; attempt++ )); do
        if [ "$(timedatectl show --property=NTPSynchronized --value 2>/dev/null)" = yes ]; then
            synchronized=true
            break
        fi
        if (( attempt < attempts )); then
            sleep "$interval"
        fi
    done

    if [ "$synchronized" != true ]; then
        error "Network time did not synchronize; refusing to write an untrusted time to the hardware clock."
        return 1
    fi

    info "Configuring the hardware clock to use UTC..."
    sudo timedatectl set-local-rtc 0

    if [ "$(timedatectl show --property=LocalRTC --value 2>/dev/null)" != no ]; then
        error "Failed to verify LocalRTC=no after configuring the hardware clock."
        return 1
    fi

    info "Hardware clock now uses UTC (LocalRTC=no)."
}

###############################################################
# => XDG defaults (in case .zshenv hasn't been sourced)
###############################################################

: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_CACHE_HOME:=$HOME/.cache}"

###############################################################
# => Common functions
###############################################################

install_preparation() {
    info "Preparing environment..."

    mkdir -p "$HOME/.vim"
    echo "colorscheme onedark
    set background=dark" > "$HOME/.vim/theme"

    # Fix some errors and cleanup
    # mkdir always before touch
    sudo mkdir -p "$XDG_DATA_HOME"/vim/{undo,swap,backup} # Fixes vim
    sudo chown -R "$USER":"$USER" "$XDG_DATA_HOME/vim/"
    mkdir -p "$HOME/.cache/zsh"
    sudo chown -R "$USER":"$USER" "$HOME/.cache/zsh/"
    mkdir -p "$HOME/.cache/vlc"
    sudo chown -R "$USER":"$USER" "$HOME/.cache/vlc/"
    mkdir -p "$HOME/.vim/cache"
    sudo chown -R "$USER":"$USER" "$HOME/.vim/cache"

    touch "$HOME/.vim/cache/viminfo" # viminfo
    touch "$XDG_DATA_HOME/vim/viminfo" # viminfo

    sudo mkdir -p /var/lib/samba/usershares
}

sops_install() {
    if command -v sops &>/dev/null; then
        info "SOPS already installed ($(sops --version | head -n 1)), skipping."
        return
    fi

    local version="${SOPS_VERSION:-3.13.2}"
    local architecture
    case "$(uname -m)" in
        x86_64) architecture="amd64" ;;
        aarch64|arm64) architecture="arm64" ;;
        *)
            error "SOPS does not provide a configured binary for $(uname -m)."
            return 1
            ;;
    esac

    local asset="sops-v${version}.linux.${architecture}"
    local release_url="https://github.com/getsops/sops/releases/download/v${version}"

    info "Installing SOPS ${version}..."
    (
        set -e
        local temp_dir
        temp_dir="$(mktemp -d)"
        trap 'rm -rf "$temp_dir"' EXIT

        curl -fsSL "${release_url}/${asset}" -o "${temp_dir}/${asset}"
        curl -fsSL "${release_url}/sops-v${version}.checksums.txt" -o "${temp_dir}/checksums.txt"
        awk -v asset="$asset" '$2 == asset { print; found = 1 } END { exit !found }' \
            "${temp_dir}/checksums.txt" > "${temp_dir}/${asset}.sha256"
        (cd "$temp_dir" && sha256sum -c "${asset}.sha256")
        sudo install -m 0755 "${temp_dir}/${asset}" /usr/local/bin/sops
    )
    info "SOPS installed successfully."
}

###############################################################
# => Volatile file handling
###############################################################

# Files that are tracked in the repo for their initial settings but are
# rewritten by their apps on every launch.  skip-worktree keeps the committed
# version visible in the repo while silencing constant runtime noise.
###############################################################
# => NVIDIA display config (anti-tearing & FreeSync)
###############################################################

nvidia_display_config() {
    info "Configuring NVIDIA display settings..."

    if ! command -v nvidia-smi &>/dev/null; then
        info "No NVIDIA driver detected, skipping display config."
        return
    fi

    local xorg_conf="/etc/X11/xorg.conf.d/20-nvidia.conf"

    # ── ForceFullCompositionPipeline ─────────────────────────────
    # Eliminates screen tearing by compositing every frame before
    # scanout. Adds ~1 frame of input lag — negligible outside
    # competitive FPS games.
    #
    # ── FreeSync / G-Sync Compatible ────────────────────────────
    # AllowGSYNCCompatible lets NVIDIA use your monitor's FreeSync
    # for variable refresh rate (VRR), eliminating tearing WITHOUT
    # the extra input lag of the composition pipeline.
    #
    # ⚠ REQUIREMENT: FreeSync over NVIDIA on Linux requires a
    # DisplayPort connection. HDMI is NOT supported.
    # If you switch to DisplayPort and want FreeSync, set
    # ENABLE_FREESYNC=true below and disable ForceFullCompositionPipeline
    # (they conflict — FreeSync is the better solution when available).

    local ENABLE_FREESYNC=false          # Set to true when using DisplayPort

    sudo mkdir -p /etc/X11/xorg.conf.d

    if [ "$ENABLE_FREESYNC" = true ]; then
        info "Enabling FreeSync (G-Sync Compatible) — requires DisplayPort."
        sudo tee "$xorg_conf" > /dev/null <<'EOF'
# NVIDIA anti-tearing & FreeSync — managed by bootstrap
# FreeSync/G-Sync Compatible mode (requires DisplayPort, not HDMI)
Section "Device"
    Identifier "NVIDIA"
    Driver     "nvidia"
    Option     "AllowGSYNCCompatible" "true"
EndSection
EOF
    else
        info "Enabling ForceFullCompositionPipeline (HDMI — no FreeSync)."
        sudo tee "$xorg_conf" > /dev/null <<'EOF'
# NVIDIA anti-tearing — managed by bootstrap
# ForceFullCompositionPipeline: composites every frame to prevent tearing.
# Adds ~1 frame of input lag. If you switch to DisplayPort, enable
# FreeSync instead (set ENABLE_FREESYNC=true in base_functions).
Section "Screen"
    Identifier "Screen0"
    Option     "metamodes" "nvidia-auto-select +0+0 { ForceFullCompositionPipeline = On }"
EndSection
EOF
    fi

    info "NVIDIA display config written to $xorg_conf (takes effect after reboot/re-login)."
}

apply_skip_worktree() {
    local dotfiles_root
    dotfiles_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

    local files=(
        .config/warp-terminal/user_preferences.json
        .config/libreoffice/4/user/config/javasettings_Linux_X86_64.xml
    )

    info "Applying skip-worktree to volatile config files..."
    for f in "${files[@]}"; do
        if [ -f "$dotfiles_root/$f" ]; then
            if git -C "$dotfiles_root" update-index --skip-worktree "$f"; then
                info "  skip-worktree: $f"
            else
                warn "  Could not apply skip-worktree to $f"
            fi
        else
            info "  Skipping (not yet present): $f"
        fi
    done
}

