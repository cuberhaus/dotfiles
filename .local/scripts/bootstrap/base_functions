install_preparation() {
    info "Preparing environment..."

    mkdir -p "$HOME/.vim"
    echo "colorscheme onedark
    set background=dark" > "$HOME/.vim/theme"

    # Fix some errors and cleanup
    # mkdir always before touch
    sudo mkdir -p "$XDG_DATA_HOME"/vim/{undo,swap,backup} # Fixes vim
    sudo chown -R "$USER":"$USER" "$XDG_DATA_HOME/vim/"
    mkdir -p "$HOME/.cache/zsh"
    sudo chown -R "$USER":"$USER" "$HOME/.cache/zsh/"
    mkdir -p "$HOME/.cache/vlc"
    sudo chown -R "$USER":"$USER" "$HOME/.cache/vlc/"
    mkdir -p "$HOME/.vim/cache"
    sudo chown -R "$USER":"$USER" "$HOME/.vim/cache"

    touch "$HOME/.vim/cache/viminfo" # viminfo
    touch "$XDG_DATA_HOME/vim/viminfo" # viminfo

    sudo mkdir -p /var/lib/samba/usershares
}

sops_install() {
    if command -v sops &>/dev/null; then
        info "SOPS already installed ($(sops --version | head -n 1)), skipping."
        return
    fi

    local version="${SOPS_VERSION:-3.13.2}"
    local architecture
    case "$(uname -m)" in
        x86_64) architecture="amd64" ;;
        aarch64|arm64) architecture="arm64" ;;
        *)
            error "SOPS does not provide a configured binary for $(uname -m)."
            return 1
            ;;
    esac

    local asset="sops-v${version}.linux.${architecture}"
    local release_url="https://github.com/getsops/sops/releases/download/v${version}"

    info "Installing SOPS ${version}..."
    (
        set -e
        local temp_dir
        temp_dir="$(mktemp -d)"
        trap 'rm -rf "$temp_dir"' EXIT

        curl -fsSL "${release_url}/${asset}" -o "${temp_dir}/${asset}"
        curl -fsSL "${release_url}/sops-v${version}.checksums.txt" -o "${temp_dir}/checksums.txt"
        awk -v asset="$asset" '$2 == asset { print; found = 1 } END { exit !found }' \
            "${temp_dir}/checksums.txt" > "${temp_dir}/${asset}.sha256"
        (cd "$temp_dir" && sha256sum -c "${asset}.sha256")
        sudo install -m 0755 "${temp_dir}/${asset}" /usr/local/bin/sops
    )
    info "SOPS installed successfully."
}

## Install asusctl and its daemon on ASUS laptops. The installer checks the hardware
## itself and skips every other machine, so profiles can call this unconditionally.
## It builds the pinned release as the current user and needs sudo only to install;
## see docs/ASUSCTL.md.
asusctl_install() {
    local -a arguments=()
    if [ "${UNATTENDED:-false}" = true ]; then
        arguments+=(--unattended)
    fi
    ASUSCTL_INSTALL_SUDO="${SUDO_COMMAND:-sudo}" \
        bash "${DOTFILES_ROOT:-$HOME}/.local/scripts/asusctl_install.sh" ${arguments[@]+"${arguments[@]}"}
}

## Remove the files asusctl_install added; the daemon settings in /etc/asusd stay.
asusctl_uninstall() {
    bash "${DOTFILES_ROOT:-$HOME}/.local/scripts/asusctl_install.sh" --uninstall || true
}

## Set the keyboard backlight to a rainbow through asusctl. The script skips machines
## without asusctl, without a lighting device, or whose keyboard lacks the effect, so
## profiles can call this unconditionally; asusctl without an answering asusd is a
## failure, which the profiles only warn about. It needs no sudo; see docs/ASUSCTL.md.
asusctl_lighting() {
    bash "${DOTFILES_ROOT:-$HOME}/.local/scripts/asusctl_lighting.sh"
}

## Install the free DaVinci Resolve from the ZIP that Blackmagic Design offers behind a
## registration form (the script cannot fetch it). The script skips machines without an
## NVIDIA GPU and ones that already have Resolve, so profiles can call this unconditionally.
## With no ZIP in the download folders, or unattended (Blackmagic's installer asks
## questions), it fails with instructions, which the profiles only warn about. Before
## Blackmagic's installer runs, the script limits its udev rule for control panels to
## Blackmagic's USB devices (the vendor's file makes every /dev/hidraw* device writable
