#!/usr/bin/env bash
# Work machine bootstrap UNINSTALL (Asus ROG Strix / Ubuntu + NVIDIA)
# Author: https://github.com/cuberhaus
set -euo pipefail

### VARIABLES
bootstrap_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
scripts="$(cd -P "$bootstrap_dir/.." && pwd)"
source "$scripts/bootstrap/base_functions"
source "$scripts/bootstrap/uninstall_tui"
source "$scripts/bootstrap/uninstall_work_functions"

### UNINSTALLATION
run_selected_uninstalls "Work Machine Uninstaller" \
    nvidia_uninstall        "NVIDIA drivers & tools"                           OFF \
    dev_tools_uninstall     "Development tools (build-essential, git, ...)"    OFF \
    node_uninstall          "Node.js & global npm packages"                   OFF \
    python_uninstall        "Python, pip & pipx packages"                     OFF \
    docker_uninstall        "Docker CE & compose"                             OFF \
    nvidia_ctk_uninstall    "NVIDIA Container Toolkit (+ apt source)"         OFF \
    asusctl_uninstall       "asusctl & asusd (ASUS laptops; keeps /etc/asusd)" OFF \
    davinci_uninstall       "DaVinci Resolve (keeps projects and settings)"    OFF \
    langtool_uninstall  "LanguageTool (grammar checker; keeps the .oxt dictionaries)" OFF \
    gui_apps_uninstall      "GUI apps (Chrome, VS Code, Cursor, Spotify, ...)" OFF

if [ "$(basename "$SHELL")" == "zsh" ]; then
    info "Currently using zsh. To revert to bash, run: chsh -s \$(which bash)"
fi

info "Uninstallation complete. A system reboot is recommended."
