#!/usr/bin/env bash
# Work machine bootstrap (Asus ROG Strix / Ubuntu + NVIDIA)
# Author: https://github.com/cuberhaus
set -euo pipefail

### VARIABLES
scripts="$HOME/.local/scripts"
source "$scripts/bootstrap/base_functions"
source "$scripts/bootstrap/work_functions"
parse_bootstrap_args "$@"
configure_dual_boot_utc_rtc

### INSTALLATION
info "Updating system..."
sudo apt-get update && sudo apt-get full-upgrade -y

install_preparation

echo "#! /bin/sh
export DISTRO=ubuntu" > "$HOME/.config/distro"


shutdown_fix
nvidia_install
nvidia_display_config
dev_tools_install
node_install
python_install
docker_install
gcloud_install
gui_apps_install

current_scale=$(gsettings get org.gnome.desktop.interface text-scaling-factor 2>/dev/null || echo "1.0")
if [[ "$current_scale" != "1.3" ]]; then
    read -r -p "Do you have a high DPI screen? [y/N] " hidpi
    if [[ "$hidpi" =~ ^([yY][eE][sS]|[yY])$ ]]; then
        high_dpi_screen
    fi
fi

if [ "$(basename "$SHELL")" != "zsh" ]; then
    chsh -s "$(which zsh)"
fi

apply_skip_worktree
info "Bootstrap complete! Reboot to load NVIDIA drivers."
