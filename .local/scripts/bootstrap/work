#!/usr/bin/env bash
# Work machine bootstrap (Asus ROG Strix / Ubuntu + NVIDIA)
# Author: https://github.com/cuberhaus
set -euo pipefail

### VARIABLES
bootstrap_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_ROOT="$(cd "$bootstrap_dir/../../.." && pwd)"
export DOTFILES_ROOT
source "$bootstrap_dir/base_functions"
source "$bootstrap_dir/work_functions"

work_prepare_environment() {
    [ "${UNATTENDED:-false}" = true ] || return 0

    export DEBIAN_FRONTEND=noninteractive
    SUDO_COMMAND="${SUDO_COMMAND:-sudo}"
    export SUDO_COMMAND
    if ! command "$SUDO_COMMAND" -n true; then
        error "Unattended mode requires cached sudo credentials. Run 'sudo -v' in this terminal, then retry."
        return 1
    fi

    sudo() {
        command "$SUDO_COMMAND" -n "$@"
    }
}

work_update_system() {
    info "Updating system..."
    sudo env DEBIAN_FRONTEND=noninteractive apt-get update
    sudo env DEBIAN_FRONTEND=noninteractive apt-get full-upgrade -y
}

work_configure_default_shell() {
    local zsh_path

    [ "$(basename "${SHELL:-}")" = zsh ] && return 0
    if ! zsh_path=$(command -v zsh); then
        error "Cannot set the default shell because zsh is not available."
        return 1
    fi

    if [ "${UNATTENDED:-false}" = true ]; then
        sudo chsh -s "$zsh_path" "$USER"
    else
        chsh -s "$zsh_path"
    fi
}

work_main() {
    bootstrap_enable_logging work
    parse_bootstrap_args "$@"
    work_prepare_environment
    configure_dual_boot_utc_rtc

    ### INSTALLATION
    work_update_system

    bootstrap_stow_checkout work

    install_preparation

    mkdir -p "$XDG_CONFIG_HOME"
    # DISTRO stays ubuntu: the shell config branches on it (apt aliases, update, cleanup).
    # DOTFILES_PROFILE records the profile itself for audit-installation and repair.
    printf '%s\n' '#! /bin/sh' 'export DISTRO=ubuntu' 'export DOTFILES_PROFILE=work' > "$XDG_CONFIG_HOME/distro"

    configure_inotify_watches
    shutdown_fix
    # Must follow shutdown_fix: on a fresh install that step rewrites the whole GRUB
    # command line, so this one appends its parameter afterwards. Cosmetic, so a
    # failure must not abort provisioning.
    brightness_fix ||
        warn "Brightness fix failed; inspect it with: $DOTFILES_ROOT/.local/scripts/brightness_fix.sh --status"
    # The installer skips machines that are not supported ASUS laptops. It needs the
    # network and a few minutes of compiling, so a failure must not abort provisioning.
    asusctl_install ||
        warn "asusctl setup failed; rerun it with: make repair REPAIR=asusctl PROFILE=work"
    # Skipped unless asusctl is installed and the keyboard supports the effect.
    asusctl_lighting ||
        warn "Keyboard lighting failed; rerun it with: make repair REPAIR=asusctl-lighting"
    nvidia_install
    nvidia_display_config
    dev_tools_install
    sops_install
    work_configure_default_shell

    node_install
    python_install
    # Needs the network and a long compile; a failure must not abort provisioning.
    vim_install ||
        warn "Vim plugin setup failed; rerun it with: make repair REPAIR=vim PROFILE=work"
    docker_install
    # Skipped without an NVIDIA GPU. It needs the network (NVIDIA's apt repository), so
    # a failure must not abort provisioning.
    nvidia_container_toolkit_install ||
        warn "NVIDIA Container Toolkit setup failed; rerun it with: make repair REPAIR=nvidia-container-toolkit"
    gcloud_install
    gui_apps_install
    # Only writes one file under ~/.config/autostart; the package itself comes from gui_apps_install.
    caffeine_indicator_autostart_install ||
        warn "Caffeine indicator autostart failed; rerun it with: bash -c 'source ~/.local/scripts/bootstrap/base_functions; caffeine_indicator_autostart_install'"
    # The free DaVinci Resolve needs a ZIP that only you can download (Blackmagic asks for a
    # registration), and its installer asks questions, so a missing ZIP or an unattended
    # run must not abort provisioning.
    davinci_resolve_install ||
        warn "DaVinci Resolve setup failed; rerun it with: make repair REPAIR=davinci-resolve"
    obsidian_vault_install

    local current_scale
    current_scale=$(gsettings get org.gnome.desktop.interface text-scaling-factor 2>/dev/null || echo "1.0")
    if [[ "$current_scale" != "1.3" ]]; then
        resolve_high_dpi_choice
        if [[ "$HIGH_DPI" == true ]]; then
            high_dpi_screen
        fi
    fi

    apply_skip_worktree
    info "Bootstrap complete! Reboot to load NVIDIA drivers."
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    work_main "$@"
fi
