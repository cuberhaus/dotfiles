#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
step="${1:-}"
profile="${2:-auto}"

usage() {
    printf 'Usage: make repair REPAIR=config|aliases|environment|vim|automations|keyboard|ide-repos|asusctl|asusctl-lighting [PROFILE=auto|arch|manjaro|ubuntu|ubuntu-windows|mac|work] [DRY_RUN=true (ide-repos, asusctl, and asusctl-lighting only)]\n' >&2
}

detect_profile() {
    if [[ "$OSTYPE" == darwin* ]]; then
        printf 'mac\n'
        return
    fi
    if grep -qi microsoft /proc/version 2>/dev/null; then
        printf 'ubuntu-windows\n'
        return
    fi
    if [[ -r "$HOME/.config/distro" ]]; then
        local detected
        detected="$(sed -n 's/^export DISTRO=//p; s/^DISTRO=//p' "$HOME/.config/distro" | head -n 1)"
        case "$detected" in
            arch|manjaro|ubuntu|work)
                printf '%s\n' "$detected"
                return
                ;;
        esac
    fi
    if [[ -r /etc/os-release ]]; then
        local detected
        detected="$(. /etc/os-release; printf '%s' "${ID:-}")"
        case "$detected" in
            arch|manjaro|ubuntu)
                printf '%s\n' "$detected"
                return
                ;;
        esac
    fi
    printf 'Unable to detect a supported profile; pass PROFILE explicitly.\n' >&2
    return 2
}

restow_config() {
    command -v stow >/dev/null 2>&1 || {
        printf 'GNU Stow is required for the %s repair.\n' "$step" >&2
        return 127
    }
    bash "$repo_root/.local/scripts/stow-backup-conflicts"
    stow -v -R -t "$HOME" -d "$(dirname "$repo_root")" "$(basename "$repo_root")"
}

repair_vim() {
    [[ "$profile" == auto ]] && profile="$(detect_profile)"
    local functions_file
    case "$profile" in
        arch|manjaro) functions_file=arch_functions ;;
        ubuntu|ubuntu-windows) functions_file=ubuntu_functions ;;
        mac) functions_file=mac_functions ;;
        work) functions_file=work_functions ;;
        *) printf 'Unsupported profile: %s\n' "$profile" >&2; return 2 ;;
    esac

    # shellcheck source=/dev/null
    source "$repo_root/.local/scripts/bootstrap/base_functions"
    # shellcheck source=/dev/null
    source "$repo_root/.local/scripts/bootstrap/$functions_file"
    if ! declare -F vim_install >/dev/null; then
        printf 'The %s profile does not define vim_install().\n' "$profile" >&2
        return 2
    fi
    vim_install
}

# Re-enable the apt sources of the installed IDE packages (VS Code, Cursor,
# Antigravity).  Ubuntu release upgrades disable third-party sources, after which
# the weekly full-upgrade skips those packages silently.  DRY_RUN=true previews
# the changes without root.
repair_ide_repos() {
    command -v apt-get >/dev/null 2>&1 || {
        printf 'The %s repair needs apt-get (Debian and Ubuntu profiles only).\n' "$step" >&2
        return 2
    }
    case "${DRY_RUN:-false}" in
        true|1) APT_SOURCES_DRY_RUN=true ;;
    esac

    # shellcheck source=/dev/null
    source "$repo_root/.local/scripts/bootstrap/base_functions"
    ide_apt_sources_repair
}

# Install or repair asusctl on an ASUS laptop; the installer skips every other
# machine, so PROFILE does not matter.  DRY_RUN=true previews the steps without sudo.
repair_asusctl() {
    local -a arguments=()
    case "${DRY_RUN:-false}" in
        true|1) arguments+=(--dry-run) ;;
    esac
    bash "$repo_root/.local/scripts/asusctl_install.sh" ${arguments[@]+"${arguments[@]}"}
}

# Set the keyboard backlight to a rainbow when asusctl is installed and the keyboard
# supports it; every other machine is skipped, so PROFILE does not matter. This is not
# the "keyboard" step below, which deploys the X11 key layout. It needs no sudo, and
# DRY_RUN=true shows the asusctl command without running it.
repair_asusctl_lighting() {
    local -a arguments=()
    case "${DRY_RUN:-false}" in
        true|1) arguments+=(--dry-run) ;;
    esac
    bash "$repo_root/.local/scripts/asusctl_lighting.sh" ${arguments[@]+"${arguments[@]}"}
}

case "$step" in
    config|aliases|environment)
        restow_config
        ;;
    vim)
        repair_vim
        ;;
    ide-repos)
        repair_ide_repos
        ;;
    asusctl)
        repair_asusctl
        ;;
    asusctl-lighting)
        repair_asusctl_lighting
        ;;
    automations)
        bash "$repo_root/.local/scripts/automation/install"
        ;;
    keyboard)
        restow_config
        if command -v xmodmap >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" && -f "$HOME/.Xmodmap" ]]; then
            xmodmap "$HOME/.Xmodmap"
        else
            printf 'Keyboard files deployed; no active X11 session found, so xmodmap was not run.\n'
        fi
        ;;
    *)
        usage
        exit 2
        ;;
esac