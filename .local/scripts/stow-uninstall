#!/usr/bin/env bash
# stow-uninstall — remove stow symlinks and restore original files
#
# 1. Detect unstow conflicts (apps that overwrote symlinks with real files)
# 2. Temporarily move those aside so stow -D can succeed
# 3. Run stow -D to remove all symlinks
# 4. Put the overwritten files back (they're the user's current data)
# 5. Restore remaining backed-up files from ~/.dotfiles-backup/
# 6. Clean up the backup directory
set -euo pipefail

# ---------------------------------------------------------------------------
# Colours
# ---------------------------------------------------------------------------
info()  { printf '\033[1;34m[INFO]\033[0m  %s\n' "$*"; }
warn()  { printf '\033[1;33m[WARN]\033[0m  %s\n' "$*"; }
ok()    { printf '\033[1;32m[OK]\033[0m    %s\n' "$*"; }

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
STOW_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
PARENT_DIR="$(dirname "$STOW_DIR")"
PKG_NAME="$(basename "$STOW_DIR")"
TARGET="${HOME}"
BACKUP_ROOT="${1:-$HOME/.dotfiles-backup}"
TMP_DIR="$(mktemp -d)"

trap 'rm -rf "$TMP_DIR"' EXIT

# ---------------------------------------------------------------------------
# Step 1 — Detect unstow conflicts (real files where symlinks should be)
# ---------------------------------------------------------------------------
conflicts=()

while IFS= read -r line; do
    if [[ "$line" =~ ^\*\ existing\ target\ is\ neither\ a\ link\ nor\ a\ directory:\ (.+)$ ]]; then
        conflicts+=("${BASH_REMATCH[1]}")
    fi
done < <(stow -D -n -t "$TARGET" -d "$PARENT_DIR" "$PKG_NAME" 2>&1 | sed 's/^[[:space:]]*//')

# ---------------------------------------------------------------------------
# Step 2 — Temporarily move conflicts aside
# ---------------------------------------------------------------------------
if (( ${#conflicts[@]} > 0 )); then
    info "Moving ${#conflicts[@]} conflict(s) aside for unstow..."
    for rel in "${conflicts[@]}"; do
        src="$TARGET/$rel"
        tmp="$TMP_DIR/$rel"
        if [ -e "$src" ]; then
            mkdir -p "$(dirname "$tmp")"
            mv "$src" "$tmp"
        fi
    done
fi

# ---------------------------------------------------------------------------
# Step 3 — Unstow (remove symlinks)
# ---------------------------------------------------------------------------
info "Removing stow symlinks..."
stow -v -D -t "$TARGET" -d "$PARENT_DIR" "$PKG_NAME"

# ---------------------------------------------------------------------------
# Step 4 — Put overwritten files back (these are the user's current data)
# ---------------------------------------------------------------------------
if (( ${#conflicts[@]} > 0 )); then
    info "Restoring ${#conflicts[@]} overwritten file(s)..."
    for rel in "${conflicts[@]}"; do
        tmp="$TMP_DIR/$rel"
        dest="$TARGET/$rel"
        if [ -e "$tmp" ]; then
            mkdir -p "$(dirname "$dest")"
            mv -v "$tmp" "$dest"
        fi
    done
fi

# ---------------------------------------------------------------------------
# Step 5 — Restore original files from backup
# ---------------------------------------------------------------------------
if [ ! -d "$BACKUP_ROOT" ]; then
    ok "Uninstall complete. No backup to restore."
    exit 0
fi

LATEST="$(find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d | sort | tail -1)"

if [ -z "$LATEST" ]; then
    ok "Uninstall complete. Backup directory is empty."
    exit 0
fi

restored=0

while IFS= read -r file; do
    rel="${file#"$LATEST"/}"
    dest="$TARGET/$rel"

    if [ -e "$dest" ] && [ ! -L "$dest" ]; then
        # A real file already exists (e.g. dconf overwrote the symlink) — keep it
        continue
    fi

    # Remove stale symlink if one remains
    [ -L "$dest" ] && rm -f "$dest"

    mkdir -p "$(dirname "$dest")"
    mv -v "$file" "$dest"
    (( restored++ )) || true
done < <(find "$LATEST" -type f)

# ---------------------------------------------------------------------------
# Step 6 — Clean up empty backup
# ---------------------------------------------------------------------------
find "$LATEST" -type d -empty -delete 2>/dev/null || true
rmdir "$LATEST" 2>/dev/null || true
rmdir "$BACKUP_ROOT" 2>/dev/null || true

ok "Uninstall complete. Restored $restored file(s) from backup."
