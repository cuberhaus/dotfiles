#!/usr/bin/env bash
# This script has moved to the obsidian_vault repo so the vault is
# self-contained on a fresh clone. This wrapper exists so existing call sites
# (and muscle memory) keep working.
#
# Canonical copy:
#   <vault>/scripts/obsidian-reinstall-plugins
# Invoked via:
#   make plugin-reinstall   (from inside the vault)
#
# This wrapper just locates the vault and re-execs the canonical script.

set -euo pipefail

candidates=(
    "$HOME/cuberhaus/obsidian_vault/scripts/obsidian-reinstall-plugins"
    "$HOME/obsidian_vault/scripts/obsidian-reinstall-plugins"
)

for c in "${candidates[@]}"; do
    if [[ -x "$c" ]]; then
        exec "$c" "$@"
    fi
done

cat >&2 <<EOF
obsidian-reinstall-plugins has moved to the obsidian_vault repo, but a copy
could not be found at any of:
$(printf '  %s\n' "${candidates[@]}")

Clone the vault first:
  git clone https://github.com/cuberhaus/obsidian_vault ~/cuberhaus/obsidian_vault

Then re-run this command, or use 'make plugin-reinstall' from inside the vault.
EOF
exit 1
