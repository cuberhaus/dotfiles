#!/bin/bash
# Description: Run a git command in all repositories under the current directory.
# Author: Pol Casacuberta
# Date: 19/3/2023

DEFAULT_DEPTH=3
DEFAULT_JOBS=0
DEFAULT_RETRIES=2
DEFAULT_TIMEOUT=12

TIMEOUT_BIN=""
if command -v timeout >/dev/null 2>&1; then
    TIMEOUT_BIN="timeout"
elif command -v gtimeout >/dev/null 2>&1; then
    TIMEOUT_BIN="gtimeout"
fi

function mac_key() {
    eval "$(ssh-agent -s)"
    ssh-add -K ~/.ssh/imac
}

function is_transient_error() {
    local file="$1"
    local status="${2:-0}"

    if [[ "$status" -eq 124 || "$status" -eq 137 ]]; then
        return 0
    fi

    grep -qiE "gnutls|handshake failed|connection.*terminated|connection.*reset|connection.*refused|could not resolve|timed out|operation timed out|unable to access|index\.lock|\.lock|the remote end hung up unexpectedly|rpc failed|502 bad gateway|503 service|504 gateway|429 too many" "$file" 2>/dev/null
}

function run_repo_with_retry() {
    local dir="$1"
    local outfile="$2"
    local cmd="$3"
    local max_retries="$4"
    local timeout_sec="$5"
    local track_head="${6:-false}"
    local attempt=0
    local status=0
    local head_before=""
    local head_after=""

    if [[ "$track_head" == true ]]; then
        head_before=$(git -C "$dir" rev-parse HEAD 2>/dev/null || true)
    fi

    while true; do
        ((attempt++))
        local temp_attempt="${outfile}.attempt"

        if [[ -n "$TIMEOUT_BIN" && "$timeout_sec" -gt 0 ]]; then
            (
                cd "$dir" 2>/dev/null || exit 1
                "$TIMEOUT_BIN" -k 3s "${timeout_sec}s" bash -c "$cmd"
            ) > "$temp_attempt" 2>&1
            status=$?
        else
            (
                cd "$dir" 2>/dev/null || exit 1
                eval "$cmd"
            ) > "$temp_attempt" 2>&1
            status=$?
        fi

        if [[ $status -eq 0 ]]; then
            if [[ "$track_head" == true && -n "$head_before" ]]; then
                head_after=$(git -C "$dir" rev-parse HEAD 2>/dev/null || true)
                if [[ -n "$head_after" && "$head_before" != "$head_after" ]]; then
                    printf "%s\n%s\n" "$head_before" "$head_after" > "${outfile}.head"
                fi
            fi
            if (( attempt > 1 )); then
                printf "[retry %d/%d succeeded]\n" "$((attempt - 1))" "$max_retries" > "$outfile"
                cat "$temp_attempt" >> "$outfile"
            else
                mv "$temp_attempt" "$outfile"
            fi
            rm -f "$temp_attempt"
            return 0
        fi

        if [[ $status -eq 124 || $status -eq 137 ]]; then
            printf "Operation timed out after %ds (stalled connection killed)\n" "$timeout_sec" >> "$temp_attempt"
        fi

        if (( attempt > max_retries )) || ! is_transient_error "$temp_attempt" "$status"; then
            if (( attempt > 1 )); then
                printf "[failed after %d retries]\n" "$((attempt - 1))" > "$outfile"
                cat "$temp_attempt" >> "$outfile"
            else
                mv "$temp_attempt" "$outfile"
            fi
            rm -f "$temp_attempt"
            return "$status"
        fi

        sleep "$attempt"
        rm -f "$temp_attempt"
    done
}

function extract_pull_summary() {
    local dir="$1"
    local outfile="$2"
    local head_file="${outfile}.head"
    local summary=""

    summary=$(grep -E '^[[:space:]]*[0-9]+ files? changed' "$outfile" 2>/dev/null | tail -n 1 | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    if [[ -n "$summary" ]]; then
        printf "%s\n" "$summary"
        return 0
    fi

    if [[ -f "$head_file" ]]; then
        local hb ha shortstat
        hb=$(sed -n '1p' "$head_file")
        ha=$(sed -n '2p' "$head_file")
        if [[ -n "$hb" && -n "$ha" && "$hb" != "$ha" ]]; then
            shortstat=$(git -C "$dir" diff --shortstat "$hb" "$ha" 2>/dev/null | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            if [[ -n "$shortstat" ]]; then
                printf "%s\n" "$shortstat"
            else
                printf "updated (%s..%s)\n" "${hb:0:7}" "${ha:0:7}"
            fi
            return 0
        fi
    fi

    if grep -qiE 'already up[- ]to[- ]date|current branch .* is up to date' "$outfile" 2>/dev/null; then
        return 1
    fi

    local update_line
    update_line=$(grep -E 'Updating [0-9a-f]+\.\.[0-9a-f]+|Fast-forward|Successfully rebased and updated|Merge made by' "$outfile" 2>/dev/null | head -n 1 | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    if [[ -n "$update_line" ]]; then
        printf "%s\n" "$update_line"
        return 0
    fi

    return 1
}

function git_recursive() {
    local cmd="$1"
    local depth="${2:-$DEFAULT_DEPTH}"
    local parallel="${3:-true}"
    local max_jobs="${4:-$DEFAULT_JOBS}"
    local max_retries="${5:-$DEFAULT_RETRIES}"
    local timeout_sec="${6:-$DEFAULT_TIMEOUT}"
    local show_summary="${7:-false}"

    local blue green red normal dim
    blue=$(tput setaf 4)
    green=$(tput setaf 2)
    red=$(tput setaf 1)
    normal=$(tput sgr0)
    dim=$(tput dim 2>/dev/null || true)

    echo "${blue}depth: $depth ${normal}"
    if [[ $depth -eq 1 ]]; then
        printf "${blue}Executing \"%s\" in %s ${normal}\n" "$cmd" "$(pwd)"
        eval "$cmd"
        return
    fi

    local dirs=()
    while IFS= read -r -d $'\0' dir; do
        dirs+=("${dir%.git}")
    done < <(find . -maxdepth "$depth" -type d -name .git -print0 2>/dev/null)

    if [[ ${#dirs[@]} -eq 0 ]]; then
        echo "${red}No git repositories found${normal}"
        return
    fi

    local total=${#dirs[@]}
    local width=${#total}
    local failures=0
    local updated_repos=()
    local updated_summaries=()
    local failed_repos=()
    local failed_statuses=()

    if [[ "$parallel" == true ]]; then
        local tmpdir
        tmpdir=$(mktemp -d)
        local pipe="$tmpdir/completion.fifo"
        mkfifo "$pipe"
        exec 3<>"$pipe"
        rm -f "$pipe"

        cleanup() {
            exec 3>&- 2>/dev/null
            exec 3<&- 2>/dev/null
            rm -rf "$tmpdir" 2>/dev/null
            local pids
            pids=$(jobs -p 2>/dev/null)
            if [[ -n "$pids" ]]; then
                local pid_list=()
                read -r -a pid_list <<< "$pids"
                kill "${pid_list[@]}" 2>/dev/null
            fi
        }
        trap cleanup EXIT INT TERM

        local jobs=$max_jobs
        if (( jobs <= 0 || jobs > total )); then
            jobs=$total
            printf "${blue}Launching \"%s\" in %d repo(s) in parallel...${normal}\n" "$cmd" "$total"
        else
            printf "${blue}Launching \"%s\" in %d repo(s) in parallel (concurrency: %d)...${normal}\n" "$cmd" "$total" "$jobs"
        fi

        launch_job() {
            local i="$1"
            local dir="${dirs[$i]}"
            local outfile="$tmpdir/$i.out"
            local statusfile="$tmpdir/$i.status"

            (
                trap 'echo "$i" >&3 2>/dev/null' EXIT
                run_repo_with_retry "$dir" "$outfile" "$cmd" "$max_retries" "$timeout_sec" "$show_summary"
                echo $? > "$statusfile"
            ) &
        }

        local next_to_launch=0
        local running=0
        local completed=0

        while (( next_to_launch < total && running < jobs )); do
            launch_job "$next_to_launch"
            ((next_to_launch++))
            ((running++))
        done

        while (( completed < total )); do
            local idx
            if ! read -r idx <&3; then
                break
            fi
            ((completed++))
            ((running--))

            local dir="${dirs[$idx]}"
            local outfile="$tmpdir/$idx.out"
            local statusfile="$tmpdir/$idx.status"
            local status=1

            if [[ -f "$statusfile" ]]; then
                status=$(cat "$statusfile")
            fi

            if [[ $status -eq 0 ]]; then
                printf "[%*d/%d] ${green}✓ %s${normal}\n" "$width" "$completed" "$total" "$dir"
                if [[ "$show_summary" == true ]]; then
                    local summary
                    if summary=$(extract_pull_summary "$dir" "$outfile"); then
                        printf "%s\n" "$summary" > "$tmpdir/$idx.updated"
                    fi
                fi
            else
                printf "[%*d/%d] ${red}✗ %s (exit %d)${normal}\n" "$width" "$completed" "$total" "$dir" "$status"
                ((failures++)) || true
            fi

            # Print captured logs indented under the status line so
            # output is grouped per-repo instead of arriving asynchronously.
            if [[ -s "$outfile" ]]; then
                sed 's/^/    /' "$outfile"
            else
                printf "    %s(no output)%s\n" "$dim" "$normal"
            fi

            if (( next_to_launch < total )); then
                launch_job "$next_to_launch"
                ((next_to_launch++))
                ((running++))
            fi
        done

        wait
        exec 3>&- 2>/dev/null
        exec 3<&- 2>/dev/null

        local i
        for (( i=0; i < total; i++ )); do
            local r_dir="${dirs[$i]}"
            local r_statusfile="$tmpdir/$i.status"
            local r_updatedfile="$tmpdir/$i.updated"
            local r_status=0
            [[ -f "$r_statusfile" ]] && r_status=$(cat "$r_statusfile")

            if [[ -f "$r_updatedfile" ]]; then
                updated_repos+=("$r_dir")
                updated_summaries+=("$(cat "$r_updatedfile")")
            fi
            if [[ "$r_status" -ne 0 ]]; then
                failed_repos+=("$r_dir")
                failed_statuses+=("$r_status")
            fi
        done

        rm -rf "$tmpdir"
        trap - EXIT INT TERM
    else
        local completed=0
        for dir in "${dirs[@]}"; do
            ((completed++))
            local tmp_out
            tmp_out=$(mktemp)
            run_repo_with_retry "$dir" "$tmp_out" "$cmd" "$max_retries" "$timeout_sec" "$show_summary"
            local seq_status=$?

            if [[ $seq_status -eq 0 ]]; then
                printf "[%*d/%d] ${green}✓ %s${normal}\n" "$width" "$completed" "$total" "$dir"
                if [[ "$show_summary" == true ]]; then
                    local summary
                    if summary=$(extract_pull_summary "$dir" "$tmp_out"); then
                        updated_repos+=("$dir")
                        updated_summaries+=("$summary")
                    fi
                fi
            else
                printf "[%*d/%d] ${red}✗ %s (exit %d)${normal}\n" "$width" "$completed" "$total" "$dir" "$seq_status"
                ((failures++)) || true
                failed_repos+=("$dir")
                failed_statuses+=("$seq_status")
            fi

            if [[ -s "$tmp_out" ]]; then
                sed 's/^/    /' "$tmp_out"
            else
                printf "    %s(no output)%s\n" "$dim" "$normal"
            fi
            rm -f "$tmp_out" "${tmp_out}.head"
        done
    fi

    printf "\n${blue}Done: %d ok, %d failed (of %d)${normal}\n" \
        "$(( total - failures ))" "$failures" "$total"

    if [[ "$show_summary" == true ]]; then
        if (( ${#updated_repos[@]} > 0 )); then
            printf "\n${green}Updated repositories (%d):${normal}\n" "${#updated_repos[@]}"
            local j
            for (( j=0; j < ${#updated_repos[@]}; j++ )); do
                printf "  ${green}%s${normal}: %s\n" "${updated_repos[j]}" "${updated_summaries[j]}"
            done
        elif (( failures == 0 )); then
            printf '\n%sAll repositories up to date.%s\n' "$dim" "$normal"
        else
            printf '\n%sNo repositories updated.%s\n' "$dim" "$normal"
        fi
    fi

    if (( failures > 0 )); then
        printf "\n${red}Failed repositories (%d):${normal}\n" "$failures"
        local k
        for (( k=0; k < ${#failed_repos[@]}; k++ )); do
            printf "  ${red}%s${normal} (exit %d)\n" "${failed_repos[k]}" "${failed_statuses[k]}"
        done
        return 1
    fi
}

usage() {
    echo "git-recurse - Run a git command in all repositories under the current directory"
    echo ""
    echo "Usage: $0 [options] <command> [args...]"
    echo ""
    echo "The command and its args are passed as positional arguments. Examples:"
    echo "  $0 git status"
    echo "  $0 git pull"
    echo "  $0 -j 6 git fetch"
    echo "  $0 -s git status"
    echo ""
    echo "Options:"
    echo "  -h              Show this help"
    echo "  -k              Add ssh key (macOS)"
    echo "  -p              Run in parallel (default)"
    echo "  -s              Run sequentially"
    echo "  -j <jobs>       Max concurrent jobs in parallel mode (0 = all at once, default: $DEFAULT_JOBS, env: GIT_RECURSE_JOBS)"
    echo "  -r <retries>    Max retries on transient network/TLS failures (default: $DEFAULT_RETRIES, env: GIT_RECURSE_RETRIES)"
    echo "  -t <seconds>    Timeout per repository in seconds (0 = disabled, default: $DEFAULT_TIMEOUT, env: GIT_RECURSE_TIMEOUT)"
    echo "  -d <depth>      Max depth to search for .git dirs (default: $DEFAULT_DEPTH)"
    echo "  -S              Show summary of updated repositories (automatic for pull commands)"
}

function exit_abnormal() {
    usage
    exit 1
}

flag_key=false
flag_parallel=true
flag_summary=""
depth=$DEFAULT_DEPTH
max_jobs="${GIT_RECURSE_JOBS:-$DEFAULT_JOBS}"
max_retries="${GIT_RECURSE_RETRIES:-$DEFAULT_RETRIES}"
timeout_sec="${GIT_RECURSE_TIMEOUT:-$DEFAULT_TIMEOUT}"

while getopts "hpksj:r:d:t:S" options; do
    case "${options}" in
    h)
        usage
        exit 0
        ;;
    k)
        flag_key=true
        ;;
    p)
        flag_parallel=true
        ;;
    s)
        flag_parallel=false
        ;;
    S)
        flag_summary=true
        ;;
    j)
        max_jobs="${OPTARG}"
        ;;
    r)
        max_retries="${OPTARG}"
        ;;
    d)
        depth="${OPTARG}"
        ;;
    t)
        timeout_sec="${OPTARG}"
        ;;
    :)
        echo "Error: -${OPTARG} requires an argument."
        exit_abnormal
        ;;
    *)
        exit_abnormal
        ;;
    esac
done

shift $((OPTIND - 1)) || true
cmd="$*"

if $flag_key; then
    mac_key
fi

if [[ -z "${cmd// }" ]]; then
    echo "Error: missing command. Pass a command after the options, e.g. git status"
    echo ""
    usage
    exit 1
fi

if ! [[ "$max_jobs" =~ ^[0-9]+$ ]]; then
    echo "Error: -j requires a non-negative integer (0 for unlimited)."
    exit 1
fi

if ! [[ "$max_retries" =~ ^[0-9]+$ ]]; then
    echo "Error: -r requires a non-negative integer."
    exit 1
fi

if ! [[ "$timeout_sec" =~ ^[0-9]+$ ]]; then
    echo "Error: -t requires a non-negative integer (0 for disabled)."
    exit 1
fi

if ! [[ "$depth" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: -d requires a positive integer."
    exit 1
fi

show_summary=false
if [[ "$flag_summary" == true ]]; then
    show_summary=true
elif [[ "$flag_summary" != false && "${GIT_RECURSE_SUMMARY:-auto}" != "0" ]]; then
    if [[ "$cmd" =~ (^|[[:space:]])pull([[:space:]]|$) || "${GIT_RECURSE_SUMMARY:-auto}" == "1" ]]; then
        show_summary=true
    fi
fi

git_recursive "$cmd" "${depth}" "$flag_parallel" "${max_jobs}" "${max_retries}" "${timeout_sec}" "$show_summary"
