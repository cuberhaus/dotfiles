#!/bin/bash
# Description: Focus the window of a program when one is already open, otherwise launch it.
# Group: Desktop & hardware
# Author: Serg Kolo modified by Pol Casacuberta
# A launcher script that checks whether
#       or not a window of a particular program already exists
#       If a window of such program is open, bring it to focus
#       Otherwise - launch a new window
#       Written for https://askubuntu.com/q/440142/295286
# Date: April 6 , 2015
# Date modified: April, 5 2021
#
# command to run
# name of the class $2

case ${1:-} in
    -h | --help)
        cat <<'EOF'
Usage: program COMMAND [WINDOW_CLASS]

Focus the window of a program when one is already open, otherwise launch it.
COMMAND is the command to run. WINDOW_CLASS is the window class to look for in
the output of wmctrl -lx, and defaults to COMMAND. It needs wmctrl.

Example: program firefox
EOF
        exit 0
        ;;
esac

if ! command -v wmctrl &>/dev/null; then
    echo "error: wmctrl is not installed" >&2
    exit 1
fi

COMMAND="${1:-}"
if [ -z "$COMMAND" ]; then
    echo "Usage: program COMMAND [WINDOW_CLASS]" >&2
    exit 1
fi
MYPROG="${2:-${COMMAND%% *}}"

echo "$COMMAND"

if wmctrl -lx | awk -v p="${MYPROG,,}" '{split(tolower($3), a, "."); if (a[1] == p || a[2] == p || tolower($3) == p) found = 1} END {exit !found}'; then
    wmctrl -xa "$MYPROG"
    exit 0
else
    sh -c "$COMMAND" &
    exit 0
fi
