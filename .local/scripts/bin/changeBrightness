#!/usr/bin/env bash
# Description: Raise or lower the screen backlight by a number of percent points (changeBrightness -5) and show a notification.
# Group: Desktop & hardware
set -euo pipefail

usage() {
    printf 'Usage: changeBrightness STEP\n'
    printf '\n'
    printf 'Raise (positive) or lower (negative) the screen backlight by STEP percent points\n'
    printf 'and show a notification when dunstify is installed.\n'
    printf 'Example: changeBrightness -5\n'
}

get_brightness() {
    if command -v brightnessctl >/dev/null 2>&1; then
        brightnessctl -m | awk -F, 'NR == 1 { gsub(/%/, "", $5); print $5; exit }'
    elif command -v light >/dev/null 2>&1; then
        light -G
    fi
}

case ${1:-} in
    -h | --help)
        usage
        exit 0
        ;;
esac

if [ "$#" -ne 1 ]; then
    usage >&2
    exit 2
fi

step="$1"
if ! [[ "$step" =~ ^[+-]?[0-9]+$ ]]; then
    printf 'error: step must be an integer\n' >&2
    usage >&2
    exit 2
fi

amount="$((step < 0 ? -step : step))"
if command -v brightnessctl >/dev/null 2>&1; then
    if (( step >= 0 )); then
        brightnessctl set "${amount}%+"
    else
        brightnessctl set "${amount}%-"
    fi
elif command -v light >/dev/null 2>&1; then
    if (( step >= 0 )); then
        light -A "$amount"
    else
        light -U "$amount"
    fi
else
    printf 'error: brightnessctl is not installed\n' >&2
    exit 1
fi

if command -v dunstify >/dev/null 2>&1; then
    brightness="$(get_brightness)"
    if [ -n "$brightness" ]; then
        dunstify -r 5555 -u low \
            -h "int:value:$brightness" "Brightness: ${brightness}%"
    fi
fi
