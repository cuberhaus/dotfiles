#!/usr/bin/env bash
# Description: Sign out of browsers, editors and CLIs and delete stored login tokens; --audit lists the credentials left on this machine.
#
# Usage: logout-all [-n|--dry-run] [-y|--yes] [--only GROUPS] [--skip GROUPS]
#        logout-all --audit
#
# Linux only. It shows a plan and asks before it changes anything. It never prints a secret,
# never follows a symbolic link and never stops a process (an app that is running is skipped).
# It does not delete SSH or GPG keys, API-key files, kubeconfig or .env files either: --audit
# lists those for you to decide. See `logout-all --help`.

# No `set -e`: one failing step must not stop the steps after it. step() records the failure
# and the summary at the end reports it.
set -uo pipefail

dry_run=false
assume_yes=false
audit_only=false
only_groups=''
skip_groups=''
selected_groups=''
group_order='cli files browsers apps history agents'
default_groups='cli files browsers apps agents'

actions=0 # targets with something to do in the current pass
failures=''
skipped=''
current_label=''
header_printed=false
rows=0 # findings printed in the current section of --audit
warned_python=false
blue='' green='' yellow='' reset=''

# What a sign-out deletes inside a profile or an app directory. A "?" matches any one character,
# so it stands for a space. Bookmarks, history, extensions and preferences are on none of them.
chromium_items=(
    'Cookies*' 'Network/Cookies*' 'Extension?Cookies*'
    'Login?Data*' 'Web?Data*' 'Account?Web?Data*'
    'Local?Storage' 'Session?Storage' 'IndexedDB' 'Service?Worker' 'File?System' 'databases'
    'Sync?Data' 'Sync?App?Settings' 'Trust?Tokens*' 'Network/Trust?Tokens*'
)
# key4.db stays: it also holds the private keys of client certificates you imported, and
# without logins.json it protects nothing.
gecko_items=(
    'cookies.sqlite*' 'logins.json' 'logins-backup.json' 'signons.sqlite' 'signedInUser.json'
    'storage/default/http*' 'storage/ls-archive.sqlite*' 'webappsstore.sqlite*'
)
# Slack, Discord, Teams and Obsidian keep their whole login in web storage.
electron_items=(
    'Cookies*' 'Network/Cookies*' 'Trust?Tokens*' 'Network/Trust?Tokens*'
    'Local?Storage' 'Session?Storage' 'IndexedDB' 'Service?Worker' 'WebStorage'
)
# The editors keep their login in User/globalStorage/state.vscdb, which also holds chat history
# and other state, so its sign-in rows are removed one by one (clean_editor_state) rather than
# the file.
editor_items=(
    'Cookies*' 'Network/Cookies*' 'Trust?Tokens*' 'Network/Trust?Tokens*'
    'User/globalStorage/state.vscdb.backup'
)
history_items=(
    '.zsh_history' '.bash_history' '.python_history' '.psql_history' '.mysql_history'
    '.sqlite_history' '.node_repl_history' '.lesshst' '.viminfo'
    '.local/share/zsh/history' '.local/share/bash/.bash_history' '.config/zsh/.zsh_history'
    '.local/state/nvim/shada' '.local/share/nvim/shada' '.local/share/recently-used.xbel'
)

usage() {
    cat <<'EOF'
Usage: logout-all [-n|--dry-run] [-y|--yes] [--only GROUPS] [--skip GROUPS]
       logout-all --audit
       logout-all -h|--help

Sign out of everything for this account and delete the login tokens stored on disk. It shows
a plan first and asks before it changes anything; the default answer is No.

Close browsers and editors first. One that is running is skipped, because it would write its
session back when it quits. Run this from a plain terminal, not from the terminal inside an
editor that you want signed out.

Groups (for --only and --skip, comma separated):
  cli       Sign out of gh, gcloud, docker, az and aws.
  files     Delete token files left by Git, AI tools and other CLIs, such as ~/.git-credentials.
  browsers  Delete cookies, saved passwords, autofill and site storage of Chrome, Chromium,
            Brave, Edge, Vivaldi, Firefox and Thunderbird. Bookmarks, history and extensions
            stay.
  apps      Remove the sign-ins of VS Code, Cursor, Antigravity and similar editors, and the
            web sessions of Slack, Discord, Teams and Obsidian.
  agents    Forget sudo's cached password, ssh-agent keys, gpg-agent passphrases and Kerberos
            tickets, then lock the login keyring.
  history   Delete shell and REPL history. Off by default: open shells write theirs back.

Options:
  -n, --dry-run   Show the plan and change nothing.
  -y, --yes       Change without asking (for scripts and hotkeys).
      --audit     Report every credential on this machine, read-only, including the ones this
                  command never deletes: SSH and API keys, .env files and kubeconfig.
  -h, --help      Show this help.

A local sign-out cannot take back a token that someone already copied, and anyone with sudo
can read your files. Revoke tokens on the provider's site too; --audit says where.
EOF
}

have() {
    command -v "$1" >/dev/null 2>&1
}

# ~/... for a path under $HOME. The tilde is meant literally: it is only displayed.
tilde() {
    # shellcheck disable=SC2088
    case "$1" in
        "$HOME") printf '~' ;;
        "$HOME"/*) printf '~/%s' "${1#"$HOME"/}" ;;
        *) printf '%s' "$1" ;;
    esac
}

# in_list WORD "a b c": succeeds when WORD is one of the words.
in_list() {
    case " $2 " in
        *" $1 "*) return 0 ;;
    esac
    return 1
}

join_lines() {
    awk '{ printf "%s%s", (NR > 1 ? ", " : ""), $0 } END { if (NR) printf "\n" }'
}

bytes_of() {
    du -sb -- "$@" 2>/dev/null | awk '{ total += $1 } END { print total + 0 }'
}

human_size() {
    awk -v bytes="$1" 'BEGIN {
        if (bytes >= 1073741824) printf "%.1f GiB", bytes / 1073741824
        else if (bytes >= 1048576) printf "%.1f MiB", bytes / 1048576
        else if (bytes >= 1024) printf "%.1f KiB", bytes / 1024
        else printf "%d B", bytes
    }'
}

###############################################################
# => Running apps
###############################################################

# is_running NAME...: succeeds when this user runs a process with one of the names. Process
# names are cut to 15 characters by the kernel, so the names are cut the same way. Without
# pgrep nothing can be checked, and a wipe under a live app is the worse mistake: say "running".
is_running() {
    local name
    have pgrep || return 0
    for name in "$@"; do
        if pgrep -u "$UID" -x "${name:0:15}" >/dev/null 2>&1; then
            return 0
        fi
    done
    return 1
}

# app_is_busy LABEL NAME,NAME: say so and succeed when the app runs, so that its data stays put.
app_is_busy() {
    local label=$1 process_names
    local IFS=,
    read -r -a process_names <<<"$2"
    is_running "${process_names[@]}" || return 1
    printf '%s!! %s is running: close it first (skipped)%s\n' "$yellow" "$label" "$reset"
    skipped="${skipped:+$skipped, }$label"
    return 0
}

###############################################################
# => Output of a pass (the plan, then the real run)
###############################################################

# target LABEL: the next say prints a heading for LABEL, once.
target() {
    if [ "$1" != "$current_label" ]; then
        current_label=$1
        header_printed=false
    fi
}

say() {
    if [ "$header_printed" = false ]; then
        printf '%s==> %s%s\n' "$blue" "$current_label" "$reset"
        header_printed=true
        actions=$((actions + 1))
    fi
    printf '    %s\n' "$1"
}

record_failure() {
    failures="${failures:+$failures, }$1"
}

# step [--soft] LABEL COMMAND...: run one command, or only print it under --dry-run. A soft
# step is a courtesy whose failure is no problem (an agent that cannot unload its keys).
step() {
    local soft=false label output status=0 command_line
    if [ "$1" = --soft ]; then
        soft=true
        shift
    fi
    label=$1
    shift
    target "$label"
    if [ "$dry_run" = true ]; then
        command_line=$(printf '%q ' "$@")
        say "would run: ${command_line% }"
        return 0
    fi
    output=$("$@" </dev/null 2>&1) || status=$?
    if [ "$status" -eq 0 ]; then
        say "${green}done${reset}"
    elif [ "$soft" = true ]; then
        say "${yellow}not possible here (exit $status)${reset}"
    else
        say "${yellow}FAILED (exit $status)${reset}"
        if [ -n "$output" ]; then
            printf '%s\n' "$output" | head -n 5 | sed 's/^/        /'
        fi
        record_failure "$label"
        return 1
    fi
}

note_python() {
    if [ "$warned_python" = false ]; then
        printf '%s-- python3 is not installed; skipping what needs it (editor sign-ins, Docker registries)%s\n' \
            "$yellow" "$reset"
        warned_python=true
    fi
}

###############################################################
# => Deleting
###############################################################

# Delete one path under $HOME. A symbolic link is left alone, because it may point at a vault
# or a repository. A file of up to 64 MiB is overwritten first. That is best effort: SSDs,
# journals and copy-on-write file systems can keep the old blocks, so revoke tokens as well.
wipe_path() {
    local path=$1
    case "$path" in
        "$HOME"/?*) ;;
        *) return 1 ;;
    esac
    case "/$path/" in
        */../*) return 1 ;;
    esac
    # remove_items already reports links; this is the last line of defence.
    if [ -L "$path" ]; then
        return 0
    fi
    if [ -d "$path" ]; then
        rm -rf -- "$path"
    elif have shred && [ "$(bytes_of "$path")" -le 67108864 ]; then
        shred -n 1 -u -- "$path" 2>/dev/null || rm -f -- "$path"
    else
        rm -f -- "$path"
    fi
}

# expand_patterns BASE PATTERN...: print, NUL separated, the paths inside BASE that exist and
# match a pattern. The patterns are literals from the lists above; the shell expands them.
expand_patterns() {
    local base=$1 pattern path
    shift
    [ -d "$base" ] || return 0
    (
        cd "$base" 2>/dev/null || exit 0
        for pattern in "$@"; do
            for path in $pattern; do
                if [ -e "$path" ] || [ -L "$path" ]; then
                    printf '%s\0' "$base/$path"
                fi
            done
        done
    )
}

# remove_items LABEL BASE PATTERN...: delete what the patterns match inside BASE, or only say
# what would go under --dry-run.
remove_items() {
    local label=$1 base=$2 found=() path rel listing='' shown=0 hidden=0 size problems=0
    shift 2
    while IFS= read -r -d '' path; do
        if [ -L "$path" ]; then
            printf '%s-- left alone (symbolic link): %s%s\n' "$yellow" "$(tilde "$path")" "$reset"
        else
            found+=("$path")
        fi
    done < <(expand_patterns "$base" "$@")
    [ "${#found[@]}" -gt 0 ] || return 0

    for path in "${found[@]}"; do
        rel=${path#"$base"/}
        case "$rel" in
            *-journal | *-wal | *-shm) continue ;;
        esac
        if [ "$shown" -lt 6 ]; then
            listing="${listing:+$listing, }$rel"
            shown=$((shown + 1))
        else
            hidden=$((hidden + 1))
        fi
    done
    if [ "$hidden" -gt 0 ]; then
        listing="$listing, and $hidden more"
    fi
    size=$(human_size "$(bytes_of "${found[@]}")")

    target "$label"
    if [ "$dry_run" = true ]; then
        say "would delete $listing ($size)"
        return 0
    fi
    for path in "${found[@]}"; do
        wipe_path "$path" || problems=$((problems + 1))
    done
    if [ "$problems" -eq 0 ]; then
        say "${green}deleted${reset} $listing ($size)"
    else
        say "${yellow}could not delete $problems item(s) of: $listing${reset}"
        record_failure "$label"
        return 1
    fi
}

