#!/bin/bash
# Author: Pol Casacuberta
# Date: 19/3/2023

DEFAULT_DEPTH=3

function mac_key() {
    eval "$(ssh-agent -s)"
    ssh-add -K ~/.ssh/imac
}

function git_recursive() {
    local cmd="$1"
    local depth="${2:-2}"
    local parallel="${3:-false}"

    local blue green red normal
    blue=$(tput setaf 4)
    green=$(tput setaf 2)
    red=$(tput setaf 1)
    normal=$(tput sgr0)

    echo "${blue}depth: $depth ${normal}"
    if [[ $depth -eq 1 ]]; then
        printf "${blue}Executing \"%s\" in %s ${normal}\n" "$cmd" "$(pwd)"
        eval "$cmd"
        return
    fi

    local dirs=()
    while IFS= read -r -d $'\0' dir; do
        dirs+=("${dir%.git}")
    done < <(find . -maxdepth "$depth" -type d -name .git -print0 2>/dev/null)

    if [[ ${#dirs[@]} -eq 0 ]]; then
        echo "${red}No git repositories found${normal}"
        return
    fi

    if [[ "$parallel" == true ]]; then
        local tmpdir
        tmpdir=$(mktemp -d)
        local pids=()

        for dir in "${dirs[@]}"; do
            (
                cd "$dir" 2>/dev/null || exit 1
                eval "$cmd" > "$tmpdir/$(echo "$dir" | tr '/' '_').out" 2>&1
            ) &
            pids+=($!)
        done

        local failures=0
        for i in "${!pids[@]}"; do
            local pid=${pids[$i]}
            local dir=${dirs[$i]}
            local outfile="$tmpdir/$(echo "$dir" | tr '/' '_').out"
            if wait "$pid"; then
                printf "${green}✓ %s${normal}\n" "$dir"
            else
                printf "${red}✗ %s${normal}\n" "$dir"
                ((failures++)) || true
            fi
            cat "$outfile" 2>/dev/null
        done

        rm -rf "$tmpdir"
        if ((failures > 0)); then
            printf "\n${red}%d repo(s) failed${normal}\n" "$failures"
        fi
    else
        for dir in "${dirs[@]}"; do
            pushd "$dir" > /dev/null || continue
            printf "${blue}Executing \"%s\" in %s ${normal}\n" "$cmd" "$dir"
            eval "$cmd"
            popd > /dev/null || continue
        done
    fi
}

usage() {
    echo "Usage: $0 [-k] [-p] [-d <depth>] [-c <cmd>]"
    echo "  -k              Add ssh key"
    echo "  -p              Run in parallel (all repos at once)"
    echo "  -d <depth>      Specify the depth to search for git repositories (default: $DEFAULT_DEPTH)"
    echo "  -c <cmd>        Command to execute in each Git repository found"
}

function exit_abnormal() {
    usage
    exit 1
}

flag_key=false
flag_parallel=false
depth=$DEFAULT_DEPTH

while getopts "hprc:kd:" options; do
    case "${options}" in
    h)
        usage
        exit 0
        ;;
    k)
        flag_key=true
        ;;
    p)
        flag_parallel=true
        ;;
    d)
        depth="${OPTARG}"
        ;;
    c)
        cmd="${OPTARG}"
        ;;
    :)
        echo "Error: -${OPTARG} requires an argument."
        exit_abnormal
        ;;
    *)
        exit_abnormal
        ;;
    esac
done

if $flag_key; then
    mac_key
fi

echo "$cmd"
if [[ -z "$cmd" ]]; then
    echo "Error: -c flag is mandatory"
    exit 1
fi

git_recursive "$cmd" "$depth" "$flag_parallel"
