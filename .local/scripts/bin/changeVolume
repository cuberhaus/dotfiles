#!/bin/bash
# Description: Set, raise or lower the volume (changeVolume 50, +5 or -5), or just show it, with a desktop notification.
# Group: Desktop & hardware
# changeVolume
# Author: https://github.com/cuberhaus/dotfiles

function Usage() {
    echo "Usage: changeVolume [INT | +INT | -INT]"
    echo "Set, raise or lower the volume and show it in a desktop notification."
    echo "Called without arguments it only shows the current volume"
    echo "Called with an INT it sets the volume to that percent"
    echo "Called with +INT or -INT it raises or lowers the volume by that many percent points"
    echo "Example: changeVolume +5"
}

# Help comes before the dependency check, so it works on a machine that lacks the tools.
case ${1:-} in
    -h | --help)
        Usage
        exit 0
        ;;
esac

# Arbitrary but unique message id
msgId="991049"

for cmd in pactl amixer dunstify; do
    if ! command -v "$cmd" &>/dev/null; then
        echo "error: $cmd is not installed" >&2
        exit 1
    fi
done

# Change the volume using alsa(might differ if you use pulseaudio)
# amixer -c 0 set Master "$@" > /dev/null
# echo "$@"
# echo "$1"
# Check number of arguments

if [ $# != 0 ]; then
	pactl set-sink-volume @DEFAULT_SINK@ "$1"% && pkill -SIGRTMIN+1 i3blocks
fi

# Query amixer for the current volume and whether or not the speaker is muted
# removes last character from string | sed 's/.$//'
#https://linuxhint.com/remove_characters_string_bash/
volume="$(awk -F"[][]" '/Left:/ { print $2 }' <(amixer sget Master) | sed 's/.$//')"
# echo $volume
mute="$(awk -F"[][]" '/Left:/ { print $4 }' <(amixer sget Master))"
# echo $mute
if [[ $volume == 0 || "$mute" == "off" ]]; then
    # Show the sound muted notification
    dunstify -a "changeVolume" -u low -i audio-volume-muted -r "$msgId" "Volume muted" 
else
    # Show the volume notification
    dunstify -a "changeVolume" -u low -i audio-volume-high -r "$msgId" \
    -h int:value:"$volume" "Volume: ${volume}%"
fi

# Play the volume changed sound
# canberra-gtk-play -i audio-volume-change -d "changeVolume"
