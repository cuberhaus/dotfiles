#!/usr/bin/env bash
# Description: View or edit encrypted vault credentials and keep their age key passphrase-protected.
#
# The store is SOPS + age. sops reads the age identity (the private key) from SOPS_AGE_KEY,
# SOPS_AGE_KEY_FILE, SOPS_AGE_KEY_CMD or <config>/sops/age/keys.txt. A plain keys.txt can be
# read by anyone with sudo, so on a shared or work machine keep the identity as keys.txt.gpg
# instead (key-wrap). This helper then points sops at it through SOPS_AGE_KEY_CMD, and
# gpg-agent asks for the passphrase whenever it has forgotten it (logout-all makes it forget).
# The lookup order is shared with the vault's Obsidian plugin and .scripts/secrets_check.py;
# keep the three in step (the vault's Secrets/README.md describes it).

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: vault-secret [list | edit | key-status | key-wrap | <entry>]

  (no argument)  pick a credential from a numbered list
  list           print the credential names; nothing is decrypted
  <entry>        decrypt one credential to the terminal
  edit           edit the whole store in $EDITOR; sops re-encrypts on save
  key-status     show where the age identity comes from and whether it opens the store
  key-wrap       keep the age identity encrypted with a passphrase (read from stdin)
EOF
}

find_vault_root() {
    local candidate
    for candidate in \
        "${VAULT_ROOT:-}" \
        "$HOME/repos/1_personal/obsidian_vault" \
        "$HOME/cuberhaus/obsidian_vault"
    do
        if [ -n "$candidate" ] && [ -f "$candidate/Secrets/credentials.enc.yaml" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    printf 'Vault credential store not found. Set VAULT_ROOT to the vault directory.\n' >&2
    return 1
}

if [ "$#" -gt 1 ]; then
    usage >&2
    exit 2
fi
case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
esac

vault_root=$(find_vault_root)
store="$vault_root/Secrets/credentials.enc.yaml"
sops_command=${VAULT_SECRET_SOPS:-sops}

green='' yellow='' red='' reset=''
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    green=$'\033[32m' yellow=$'\033[33m' red=$'\033[31m' reset=$'\033[0m'
fi

# The folder where sops looks for its default age identity.
age_dir() {
    if [ -n "${XDG_CONFIG_HOME:-}" ]; then
        printf '%s/sops/age\n' "$XDG_CONFIG_HOME"
    elif [ "$(uname -s)" = Darwin ]; then
        printf '%s/Library/Application Support/sops/age\n' "$HOME"
    else
        printf '%s/.config/sops/age\n' "$HOME"
    fi
}

# Where the age identity comes from: env, plain (keys.txt), wrapped (keys.txt.gpg) or none.
# Anything the user configured for sops wins, then sops' own default file, then the wrapped copy.
identity_source() {
    local dir
    dir=$(age_dir)
    if [ -n "${SOPS_AGE_KEY:-}" ] || [ -n "${SOPS_AGE_KEY_FILE:-}" ] || [ -n "${SOPS_AGE_KEY_CMD:-}" ]; then
        printf 'env\n'
    elif [ -f "$dir/keys.txt" ]; then
        printf 'plain\n'
    elif [ -f "$dir/keys.txt.gpg" ]; then
        printf 'wrapped\n'
    else
        printf 'none\n'
    fi
}

# Quote a word the way sops reads SOPS_AGE_KEY_CMD: shell-style words, but no shell runs, so
# $VAR, pipes and globs are not expanded. Single quotes, with ' written as '\'', cover every path.
quote_word() {
    local quote="'"
    printf "'%s'" "${1//$quote/$quote\\$quote$quote}"
}

# --batch keeps gpg from reading a terminal; the passphrase still comes from gpg-agent's pinentry.
wrapped_key_command() {
    printf 'gpg --quiet --batch --decrypt %s' "$(quote_word "$1")"
}

require_sops() {
    command -v "$sops_command" >/dev/null 2>&1 || {
        printf 'sops is not installed or not on PATH.\n' >&2
        exit 127
    }
}

# Make sops able to find the identity, or stop with the way to create one.
prepare_identity() {
    local source dir
    source=$(identity_source)
    dir=$(age_dir)
    case "$source" in
        none)
            printf 'No age identity found, so the store cannot be decrypted on this device.\n' >&2
            printf 'Keep it passphrase-protected:  vault-secret key-wrap\n' >&2
            printf 'or place the plain file at:    %s/keys.txt\n' "$dir" >&2
            exit 1
            ;;
        wrapped)
            command -v gpg >/dev/null 2>&1 || {
                printf 'gpg is not installed or not on PATH; it unlocks %s/keys.txt.gpg.\n' "$dir" >&2
                exit 127
            }
            SOPS_AGE_KEY_CMD=$(wrapped_key_command "$dir/keys.txt.gpg")
            export SOPS_AGE_KEY_CMD
            ;;
    esac
}

# Does the current identity open the store? Whatever sops prints is discarded.
store_opens() {
    "$sops_command" decrypt --extract '["credentials"]' "$store" >/dev/null 2>&1
}

key_status() {
    local dir source
    dir=$(age_dir)
    source=$(identity_source)
    printf 'Store:        %s\n' "$store"
    case "$source" in
        env)
            printf '%sIdentity:     set in the environment (SOPS_AGE_KEY, SOPS_AGE_KEY_FILE or SOPS_AGE_KEY_CMD)%s\n' "$green" "$reset"
            ;;
        plain)
            printf '%sIdentity:     plain file %s%s\n' "$yellow" "$dir/keys.txt" "$reset"
            printf '              anyone who can read your home folder (sudo) can open the store with it;\n'
            printf '              keep it passphrase-protected instead: vault-secret key-wrap < %s\n' "$(quote_word "$dir/keys.txt")"
            ;;
        wrapped)
            printf '%sIdentity:     passphrase-protected, %s%s\n' "$green" "$dir/keys.txt.gpg" "$reset"
            ;;
        none)
            printf '%sIdentity:     none found%s\n' "$yellow" "$reset"
            printf '              store it passphrase-protected with: vault-secret key-wrap\n'
            return 1
            ;;
    esac

    require_sops
    prepare_identity
    if [ "$source" = wrapped ]; then
        printf 'Opens store:  testing (a passphrase prompt may appear)...\n'
    fi
    if store_opens; then
        printf '%sOpens store:  yes%s\n' "$green" "$reset"
    else
        printf '%sOpens store:  no, sops could not decrypt it (wrong or cancelled passphrase, or this key is not a recipient)%s\n' "$red" "$reset"
        return 1
    fi
}

# Directory that the EXIT trap removes: it holds the new keys.txt.gpg until it has been verified.
scratch=''
trap 'if [ -n "$scratch" ]; then rm -rf "$scratch"; fi' EXIT

# Encrypt the age identity from stdin with a passphrase and keep it as keys.txt.gpg. The
# identity lives only in this shell's memory and in pipes: it is never an argument, never in a
# file and never printed. Nothing is saved unless the result opens the store on its own.
key_wrap() {
    local dir target identity=''
    command -v gpg >/dev/null 2>&1 || {
        printf 'gpg is not installed or not on PATH.\n' >&2
        exit 127
    }
    require_sops
    dir=$(age_dir)
    target="$dir/keys.txt.gpg"
    if [ -e "$target" ]; then
        printf '%s already exists.\nMove it away first: it may be your only passphrase-protected copy.\n' "$target" >&2
        exit 1
    fi

    if [ -t 0 ]; then
        printf 'Paste the age secret key (AGE-SECRET-KEY-1..., input is hidden), then press Enter: ' >&2
        IFS= read -rs identity || true
        printf '\n' >&2
    else
        identity=$(cat)
    fi
    if ! printf '%s\n' "$identity" | grep -E '^AGE-SECRET-KEY-1[A-Z0-9]+$' >/dev/null; then
        unset identity
        printf 'No AGE-SECRET-KEY-1... line in the input.\n' >&2
        printf 'Give only that line, or pipe the whole key file in: vault-secret key-wrap < keys.txt\n' >&2
        exit 2
    fi

    scratch=$(mktemp -d)
    if [ -z "${GPG_TTY:-}" ] && [ -t 2 ]; then
        GPG_TTY=$(tty <&2) && export GPG_TTY
    fi
    if ! (
        umask 077
        printf '%s\n' "$identity" | gpg --quiet --symmetric --cipher-algo AES256 --output "$scratch/keys.txt.gpg"
    ); then
        unset identity
        printf 'gpg could not encrypt the key (passphrase cancelled?). Nothing was saved.\n' >&2
        exit 1
    fi
    unset identity

    # Verify with this copy alone: a default keys.txt or an environment key would hide a wrong one.
    mkdir "$scratch/no-keys"
    if ! env -u SOPS_AGE_KEY -u SOPS_AGE_KEY_FILE \
        XDG_CONFIG_HOME="$scratch/no-keys" \
        SOPS_AGE_KEY_CMD="$(wrapped_key_command "$scratch/keys.txt.gpg")" \
        "$sops_command" decrypt --extract '["credentials"]' "$store" >/dev/null 2>&1; then
        printf 'That key does not open %s (it is not a recipient, or the passphrase differed between the two prompts).\n' "$store" >&2
        printf 'Nothing was saved.\n' >&2
        exit 1
    fi

    if [ ! -d "$dir" ]; then
        mkdir -p "$dir"
        chmod 700 "$dir"
    fi
    mv "$scratch/keys.txt.gpg" "$target"
    printf '%sSaved %s (encrypted with your passphrase).%s\n' "$green" "$target" "$reset"
    if [ -f "$dir/keys.txt" ]; then
        printf '%sThe plain file %s is still there and sops keeps using it, so the store stays open to anyone with sudo.%s\n' "$yellow" "$dir/keys.txt" "$reset"
        printf 'Check the result with: vault-secret key-status. Then delete the plain file: shred -u %s\n' "$(quote_word "$dir/keys.txt")"
    fi
    printf 'Keep the original key in your password manager: without it or the passphrase the store cannot be opened.\n'
}

list_entries() {
    awk '
        $0 == "credentials:" { in_credentials=1; next }
        in_credentials && /^[^ ]/ { exit }
        in_credentials && /^    [A-Za-z0-9_]+:$/ {
            name=$1
            sub(/:$/, "", name)
            print name
        }
    ' "$store"
}

if [ "$#" -eq 0 ]; then
    entries=()
    while IFS= read -r entry; do
        entries[${#entries[@]}]="$entry"
    done < <(list_entries)

    printf 'Select a credential:\n'
    index=1
    for entry in "${entries[@]}"; do
        printf '  %d) %s\n' "$index" "$entry"
        index=$((index + 1))
    done
    printf '  q) Cancel\n'
    printf '> '
    IFS= read -r choice

    case "$choice" in
        q|Q) exit 0 ;;
        *[!0-9]*|'') printf 'Invalid selection.\n' >&2; exit 2 ;;
    esac
    if [ "$choice" -lt 1 ] || [ "$choice" -gt "${#entries[@]}" ]; then
        printf 'Invalid selection.\n' >&2
        exit 2
    fi
    set -- "${entries[$((choice - 1))]}"
fi

case "$1" in
    list)
        list_entries
        ;;
    key-status)
        key_status
        ;;
    key-wrap)
        key_wrap
        ;;
    edit)
        require_sops
        prepare_identity
        exec "$sops_command" edit "$store"
        ;;
    *[!A-Za-z0-9_-]*|'')
        printf 'Invalid entry name: %s\n' "$1" >&2
        usage >&2
        exit 2
        ;;
    *)
        require_sops
        prepare_identity
        exec "$sops_command" decrypt --extract "[\"credentials\"][\"$1\"]" "$store"
        ;;
esac
