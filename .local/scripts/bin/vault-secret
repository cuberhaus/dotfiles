#!/usr/bin/env bash
# Description: List, view, or edit encrypted Obsidian vault credentials.

set -euo pipefail

usage() {
    cat >&2 <<'EOF'
Usage: vault-secret [list | edit | <entry>]
EOF
}

find_vault_root() {
    local candidate
    for candidate in \
        "${VAULT_ROOT:-}" \
        "$HOME/repos/1_personal/obsidian_vault" \
        "$HOME/cuberhaus/obsidian_vault"
    do
        if [ -n "$candidate" ] && [ -f "$candidate/Secrets/credentials.enc.yaml" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    printf 'Vault credential store not found. Set VAULT_ROOT to the vault directory.\n' >&2
    return 1
}

if [ "$#" -gt 1 ]; then
    usage
    exit 2
fi

vault_root=$(find_vault_root)
store="$vault_root/Secrets/credentials.enc.yaml"
sops_command=${VAULT_SECRET_SOPS:-sops}

list_entries() {
    awk '
        $0 == "credentials:" { in_credentials=1; next }
        in_credentials && /^[^ ]/ { exit }
        in_credentials && /^    [A-Za-z0-9_]+:$/ {
            name=$1
            sub(/:$/, "", name)
            print name
        }
    ' "$store"
}

if [ "$#" -eq 0 ]; then
    entries=()
    while IFS= read -r entry; do
        entries[${#entries[@]}]="$entry"
    done < <(list_entries)

    printf 'Select a credential:\n'
    index=1
    for entry in "${entries[@]}"; do
        printf '  %d) %s\n' "$index" "$entry"
        index=$((index + 1))
    done
    printf '  q) Cancel\n'
    printf '> '
    IFS= read -r choice

    case "$choice" in
        q|Q) exit 0 ;;
        *[!0-9]*|'') printf 'Invalid selection.\n' >&2; exit 2 ;;
    esac
    if [ "$choice" -lt 1 ] || [ "$choice" -gt "${#entries[@]}" ]; then
        printf 'Invalid selection.\n' >&2
        exit 2
    fi
    set -- "${entries[$((choice - 1))]}"
fi

case "$1" in
    list)
        list_entries
        ;;
    edit)
        command -v "$sops_command" >/dev/null 2>&1 || {
            printf 'sops is not installed or not on PATH.\n' >&2
            exit 127
        }
        exec "$sops_command" edit "$store"
        ;;
    *[!A-Za-z0-9_-]*|'')
        printf 'Invalid entry name: %s\n' "$1" >&2
        usage
        exit 2
        ;;
    *)
        command -v "$sops_command" >/dev/null 2>&1 || {
            printf 'sops is not installed or not on PATH.\n' >&2
            exit 127
        }
        exec "$sops_command" decrypt --extract "[\"credentials\"][\"$1\"]" "$store"
        ;;
esac