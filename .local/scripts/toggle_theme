#!/usr/bin/env bash
# Author: https://github.com/cuberhaus

# PATHS
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
GTK_CONFIG="$HOME/.gtkrc-2.0.mine"
GTK3_CONFIG="$XDG_CONFIG_HOME/gtk-3.0/settings.ini"

### Themes
# GTK
LIGHT_GTK_THEME="Adwaita"
DARK_GTK_THEME="Arc-Dark"
ICON_THEME_LIGHT="Adwaita"
ICON_THEME_DARK="Adwaita"

function update_wallpaper {
    if ! command -v feh &>/dev/null; then return; fi
    if [ "$1" == "light" ] && [ -n "${WALLPAPER_LIGHT:-}" ]; then
        feh --bg-scale "$WALLPAPER_LIGHT" &
    elif [ "$1" == "dark" ] && [ -n "${WALLPAPER_DARK:-}" ]; then
        feh --bg-scale "$WALLPAPER_DARK" &
    fi
}

# Pre: $GTK_CONFIG and $GTK3_CONFIG exist with gtk-theme-name and gtk-icon-theme-name lines
function update_gtk_theme {
    local gtk_theme icon_theme
    if [ "$1" == "light" ]; then
        gtk_theme="$LIGHT_GTK_THEME"
        icon_theme="$ICON_THEME_LIGHT"
    elif [ "$1" == "dark" ]; then
        gtk_theme="$DARK_GTK_THEME"
        icon_theme="$ICON_THEME_DARK"
    else
        return
    fi

    # GTK 3
    sed -i "s/gtk-theme-name=.*/gtk-theme-name=$gtk_theme/" "$GTK3_CONFIG"
    sed -i "s/gtk-icon-theme-name=.*/gtk-icon-theme-name=$icon_theme/" "$GTK3_CONFIG"

    # GTK 2
    sed -i "s/gtk-theme-name=\"[^\"]*\"/gtk-theme-name=\"$gtk_theme\"/" "$GTK_CONFIG"
    sed -i "s/gtk-icon-theme-name=\"[^\"]*\"/gtk-icon-theme-name=\"$icon_theme\"/" "$GTK_CONFIG"
}

function change_theme {
    if [ ! -f "$GTK_CONFIG" ]; then
        printf 'gtk-theme-name=""\ngtk-icon-theme-name=""\n' > "$GTK_CONFIG"
    fi
    if [ ! -f "$GTK3_CONFIG" ]; then
        mkdir -p "$(dirname "$GTK3_CONFIG")"
        printf '[Settings]\ngtk-theme-name=\ngtk-icon-theme-name=\n' > "$GTK3_CONFIG"
    fi
    update_gtk_theme "$1"
    update_wallpaper "$1"
    wait
}

function Usage {
    echo "Usage: toggle_theme [OPTION]"
    echo "Options: light | dark"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    Usage
    exit 0
fi

if [[ "$#" -ne 1 ]]; then
    Usage
    exit 1
fi

# Switch
case "$1" in
    light)
        change_theme light
        ;;
    dark)
        change_theme dark
        ;;
    *)
        Usage
        exit 1
        ;;
esac
