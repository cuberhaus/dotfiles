#!/usr/bin/env bash
# Fast-forward every git repository under the workspace (default ~/cuberhaus).
#
# Usage: workspace-pull [--root DIR] [--depth N] [--if-due-seconds N] [--notify] [--fix-failed]
#
#   --root DIR           the workspace folder (default: ~/cuberhaus)
#   --depth N            how deep to look for repositories (default: 3)
#   --if-due-seconds N   skip when the last successful run was less than N seconds ago
#   --notify             show a desktop notification: a progress bar once the run has lasted ten
#                        seconds, and a summary when something was updated or went wrong. A run with
#                        nothing to update stays silent. Off by default, so a run from a terminal
#                        is silent; the systemd service passes it. When repositories failed, the
#                        summary is clickable ("Fix in terminal") where the desktop supports it.
#   --fix-failed         for running inside a terminal: list the repositories the last run could
#                        not pull, show git status in the first one and open a shell there. This
#                        is what clicking "Fix in terminal" on the failure summary runs.
set -euo pipefail

root="${HOME}/cuberhaus"
depth=3
minimum_age_seconds=0
notify=false
fix_failed=false

while (($# > 0)); do
    case "$1" in
        -h|--help)
            awk 'NR > 1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"
            exit 0
            ;;
        --root)
            root="${2:?missing path for --root}"
            shift 2
            ;;
        --depth)
            depth="${2:?missing value for --depth}"
            shift 2
            ;;
        --if-due-seconds)
            minimum_age_seconds="${2:?missing seconds for --if-due-seconds}"
            shift 2
            ;;
        --notify)
            notify=true
            shift
            ;;
        --fix-failed)
            fix_failed=true
            shift
            ;;
        *)
            printf 'Unknown argument: %s\n' "$1" >&2
            exit 2
            ;;
    esac
done

# The notification library sits next to the scripts (a deployed copy) or in ../lib (the repository).
# Without it the run is the same, only silent.
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
progress_library=
for candidate in "$script_dir/cuberhaus-progress.sh" "$script_dir/../lib/cuberhaus-progress.sh"; do
    if [[ -r $candidate ]]; then
        progress_library=$candidate
        break
    fi
done
if [[ -n $progress_library ]]; then
    # shellcheck source=../lib/cuberhaus-progress.sh
    source "$progress_library"
else
    progress_start() { :; }
    progress_update() { :; }
    progress_finish() { :; }
    progress_abort() { :; }
    [[ $notify == false ]] || printf 'Notification not shown: cuberhaus-progress.sh was not found.\n'
fi

self_path="$script_dir/${BASH_SOURCE[0]##*/}"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/cuberhaus-automations"
state_file="$state_dir/workspace-pull.last-success"
failures_file="$state_dir/workspace-pull.last-failures"
mkdir -p "$state_dir"

# fix_failed_repositories: the terminal half of the failure notification's click. It reads the
# paths the last run saved (one per line; shortcut: a path containing a newline cannot be saved,
# upgrade to NUL separation if a repository ever gets one), shows why the first one would not
# pull, and leaves an interactive shell in it.
fix_failed_repositories() {
    local failed=() repository first=''
    if [[ -r $failures_file ]]; then
        while IFS= read -r repository || [[ -n $repository ]]; do
            [[ -n $repository ]] && failed+=("$repository")
        done <"$failures_file"
    fi
    if ((${#failed[@]} == 0)); then
        printf 'No failed repositories from the last workspace pull.\n'
    else
        printf 'These repositories could not be pulled:\n'
        printf '  %s\n' "${failed[@]}"
        first=${failed[0]}
        if [[ -d $first ]]; then
            cd "$first" || printf 'Could not enter %s\n' "$first"
            printf '\n%s\n' "$first"
            if command -v git >/dev/null 2>&1; then
                git status --short --branch || true
            fi
            printf '\nFix the problem above, then retry with: git pull --ff-only\n'
        else
            printf '\n%s no longer exists.\n' "$first"
        fi
    fi
    # CUBERHAUS_FIX_SHELL is a test seam; normally the user's own shell opens in the repository.
    exec "${CUBERHAUS_FIX_SHELL:-${SHELL:-/bin/bash}}"
}

if [[ $fix_failed == true ]]; then
    fix_failed_repositories
    exit $?
fi

if [[ -f "$state_file" && $minimum_age_seconds -gt 0 ]]; then
    last_success=$(<"$state_file")
    now=$(date +%s)
    if [[ $last_success =~ ^[0-9]+$ ]] && ((now - last_success < minimum_age_seconds)); then
        printf 'Workspace pull completed recently. Skipping.\n'
        exit 0
    fi
fi

lock_dir="${TMPDIR:-/tmp}/cuberhaus-workspace-pull.lock"
if ! mkdir "$lock_dir" 2>/dev/null; then
    printf 'Another workspace pull is running. Skipping.\n'
    exit 0
fi
# A run that dies (a failed command, systemd's timeout) still ends its notification as a failure.
cleanup() {
    local status=$?
    progress_abort "$status"
    rmdir "$lock_dir" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

if [[ $notify == true ]]; then
    progress_start workspace-pull 'Workspace pull' Pulling repository 10
    progress_update 'current=Looking for repositories'
fi

# fail MESSAGE: end the run with a message the notification can show.
fail() {
    printf '%s\n' "$1" >&2
    progress_finish failure --message "$1"
    exit 1
}

if [[ ! -d "$root" ]]; then
    fail "Workspace directory does not exist: $root"
fi
if ! command -v git >/dev/null 2>&1; then
    fail 'Git is not available on PATH.'
fi

export GIT_TERMINAL_PROMPT=0

repository_list=()
while IFS= read -r -d '' git_dir; do
    repository_list+=("${git_dir%/.git}")
done < <(find "$root" -maxdepth "$depth" -type d -name .git -print0 2>/dev/null)
repositories=${#repository_list[@]}

updated=0
up_to_date=0
skipped=0
failures=0
failed_names=
failed_paths=()
progress_update 'current=Pulling repositories' "total=$repositories"

for ((index = 0; index < repositories; index++)); do
    repository=${repository_list[index]}
    name=${repository##*/}
    progress_update "current=Pulling $name" "index=$((index + 1))" "done=$index"

    if ! upstream=$(git -C "$repository" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
        printf '[SKIP] %s (no upstream)\n' "$repository"
        skipped=$((skipped + 1))
        continue
    fi

    printf '[PULL] %s (%s)\n' "$repository" "$upstream"
    # A moved HEAD is how an update is told from an up-to-date repository; git's own wording changes
    # with the locale.
    before=$(git -C "$repository" rev-parse HEAD 2>/dev/null || true)
    if git -C "$repository" -c credential.interactive=never pull --ff-only --no-edit; then
        after=$(git -C "$repository" rev-parse HEAD 2>/dev/null || true)
        if [[ $before != "$after" ]]; then
            updated=$((updated + 1))
        else
            up_to_date=$((up_to_date + 1))
        fi
    else
        printf '[FAIL] %s\n' "$repository" >&2
        failures=$((failures + 1))
        failed_names+="${failed_names:+, }$name"
        failed_paths+=("$repository")
    fi
done

printf 'Workspace pull checked %d repositories with %d failure(s).\n' "$repositories" "$failures"

summary="$updated updated, $up_to_date already up to date."
skipped_line=
if ((skipped > 0)); then
    skipped_line="$skipped skipped (no upstream)."
fi

if ((failures > 0)); then
    # The click on the failure summary reopens these in a terminal (--fix-failed), so it needs
    # the paths, not just the names the summary shows.
    printf '%s\n' "${failed_paths[@]}" >"$failures_file"
    if [[ $notify == true ]] && command -v xdg-terminal-exec >/dev/null 2>&1; then
        # Through /bin/bash, as the service runs it: the script itself is not executable.
        printf -v fix_command '%q %q %q %q' "$(command -v xdg-terminal-exec)" /bin/bash "$self_path" '--fix-failed'
        progress_finish warning --message "Failed: $failed_names." \
            --action-label 'Fix in terminal' --action-command "$fix_command" "$summary" "$skipped_line"
    else
        progress_finish warning --message "Failed: $failed_names." "$summary" "$skipped_line"
    fi
    exit 1
fi
rm -f "$failures_file"

date +%s > "$state_file"
if ((updated == 0)); then
    progress_finish success --quiet "$summary" "$skipped_line"
else
    progress_finish success "$summary" "$skipped_line"
fi
