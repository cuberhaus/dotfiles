#!/usr/bin/env bash
set -euo pipefail

dry_run=false
if [[ ${1:-} == "--dry-run" ]]; then
    dry_run=true
elif (($# > 0)); then
    printf 'Usage: %s [--dry-run]\n' "$0" >&2
    exit 2
fi

show() {
    printf '[dry-run]'
    printf ' %q' "$@"
    printf '\n'
}

uninstall_linux() {
    if grep -qi microsoft /proc/version 2>/dev/null; then
        printf 'WSL detected: no Unix automation schedules were installed.\n'
        return
    fi
    if ! command -v systemctl >/dev/null 2>&1; then
        printf 'systemd is unavailable; nothing to disable.\n'
        return
    fi

    local user_timers=(
        cuberhaus-workspace-pull.timer
        cuberhaus-desktop-shortcut-cleanup.timer
    )

    if [[ $dry_run == true ]]; then
        show systemctl --user disable --now "${user_timers[@]}"
        return
    fi

    systemctl --user disable --now "${user_timers[@]}" 2>/dev/null || true
    systemctl --user daemon-reload
}

uninstall_macos() {
    local label=com.cuberhaus.workspace-pull target uid
    target="$HOME/Library/LaunchAgents/$label.plist"
    uid=$(id -u)

    if [[ $dry_run == true ]]; then
        show launchctl bootout "gui/$uid/$label"
        show rm -f "$target"
        return
    fi
    launchctl bootout "gui/$uid/$label" 2>/dev/null || true
    rm -f "$target"
}

case "$(uname -s)" in
    Linux) uninstall_linux ;;
    Darwin) uninstall_macos ;;
    *)
        printf 'Unsupported platform: %s\n' "$(uname -s)" >&2
        exit 1
        ;;
esac

printf 'Cuberhaus automation schedules are disabled and removed. Logs and state were preserved.\n'