#!/usr/bin/env bash
# Upgrade the packages a normal user owns: Homebrew, and yay's AUR packages on Linux.
#
# Usage: user-package-maintenance [--if-due-seconds N] [--notify]
#
#   --if-due-seconds N   skip when the last successful run was less than N seconds ago
#   --notify             show a desktop notification: a progress bar once the run has lasted ten
#                        seconds, and a summary when something was upgraded or went wrong. A run
#                        with nothing to upgrade stays silent. Off by default, so a run from a
#                        terminal is silent; the systemd service passes it.
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:$HOME/.linuxbrew/bin:$PATH"

minimum_age_seconds=0
notify=false
while (($# > 0)); do
    case "$1" in
        -h|--help)
            awk 'NR > 1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"
            exit 0
            ;;
        --if-due-seconds)
            minimum_age_seconds="${2:?missing seconds for --if-due-seconds}"
            shift 2
            ;;
        --notify)
            notify=true
            shift
            ;;
        *)
            printf 'Unknown argument: %s\n' "$1" >&2
            exit 2
            ;;
    esac
done

# The notification library sits next to the scripts (a deployed copy) or in ../lib (the repository).
# Without it the run is the same, only silent.
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
progress_library=
for candidate in "$script_dir/cuberhaus-progress.sh" "$script_dir/../lib/cuberhaus-progress.sh"; do
    if [[ -r $candidate ]]; then
        progress_library=$candidate
        break
    fi
done
if [[ -n $progress_library ]]; then
    # shellcheck source=../lib/cuberhaus-progress.sh
    source "$progress_library"
else
    progress_start() { :; }
    progress_update() { :; }
    progress_finish() { :; }
    progress_abort() { :; }
    [[ $notify == false ]] || printf 'Notification not shown: cuberhaus-progress.sh was not found.\n'
fi

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/cuberhaus-automations"
state_file="$state_dir/user-package-maintenance.last-success"
mkdir -p "$state_dir"

if [[ -f "$state_file" && $minimum_age_seconds -gt 0 ]]; then
    last_success=$(<"$state_file")
    now=$(date +%s)
    if [[ $last_success =~ ^[0-9]+$ ]] && ((now - last_success < minimum_age_seconds)); then
        printf 'User package maintenance completed recently. Skipping.\n'
        exit 0
    fi
fi

lock_dir="${TMPDIR:-/tmp}/cuberhaus-user-package-maintenance.lock"
if ! mkdir "$lock_dir" 2>/dev/null; then
    printf 'Another user package maintenance process is running.\n'
    exit 0
fi
# A run that dies (a failed command, systemd's timeout) still ends its notification as a failure.
cleanup() {
    local status=$?
    progress_abort "$status"
    rmdir "$lock_dir" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

if [[ $notify == true ]]; then
    progress_start user-package-maintenance 'User package maintenance' Upgrading package 10
fi

# fail MESSAGE: end the run with a message the notification can show.
fail() {
    printf '%s\n' "$1" >&2
    progress_finish failure --message "$1"
    exit 1
}

# count_lines TEXT: the number of non-empty lines.
count_lines() {
    local count=0 line
    while IFS= read -r line; do
        [[ -z $line ]] || count=$((count + 1))
    done <<<"$1"
    printf '%s\n' "$count"
}

# watch_upgrade PATTERN OFFSET TOTAL VERB: pass the output of an upgrade through unchanged and move the
# bar each time a line matches PATTERN (a regular expression whose first group is the package name).
# OFFSET is how many packages an earlier manager already did, so one bar spans both.
watch_upgrade() {
    local pattern=$1 offset=$2 total=$3 line index=0
    while IFS= read -r line; do
        printf '%s\n' "$line"
        if [[ $line =~ $pattern ]]; then
            index=$((index + 1))
            progress_update "current=Upgrading ${BASH_REMATCH[1]}" "index=$((offset + index))" \
                "done=$((offset + index - 1))" "total=$total"
        fi
    done
}

have_brew=false
have_yay=false
command -v brew >/dev/null 2>&1 && have_brew=true
if [[ "$(uname -s)" == "Linux" ]] && command -v yay >/dev/null 2>&1; then
    have_yay=true
fi

printf '[%s] Starting user package maintenance.\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')"

brew_total=0
yay_total=0
if [[ $have_brew == true ]]; then
    progress_update 'current=Updating Homebrew'
    brew update || fail 'brew update failed.'
    brew_total=$(count_lines "$(brew outdated --quiet 2>/dev/null || true)")
fi
if [[ $have_yay == true ]]; then
    progress_update 'current=Checking AUR packages'
    yay_total=$(count_lines "$(yay -Qua 2>/dev/null || true)")
fi
total=$((brew_total + yay_total))
progress_update "total=$total"

if [[ $have_brew == true ]]; then
    # Homebrew names each package on its own "==> Upgrading <name>" line, after a header that
    # says how many it will upgrade ("==> Upgrading 3 outdated packages:").
    brew upgrade 2>&1 | watch_upgrade '^==> Upgrading ([^[:space:]]+)$' 0 "$total" || fail 'brew upgrade failed.'
fi
if [[ $have_yay == true ]]; then
    # makepkg announces each AUR build as "==> Making package: <name> <version>".
    yay -Sua --noconfirm --needed 2>&1 |
        watch_upgrade '^==> Making package: ([^[:space:]]+)' "$brew_total" "$total" || fail 'yay -Sua failed.'
fi

if [[ $have_brew == false && $have_yay == false ]]; then
    printf 'No supported user package manager found (Homebrew or yay). Nothing to do.\n'
fi

date +%s > "$state_file"
printf '[%s] User package maintenance completed. A reboot was not requested.\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')"

if ((total == 0)); then
    if [[ $have_brew == true || $have_yay == true ]]; then
        progress_finish success --quiet 'Everything was already up to date.'
    else
        progress_finish success --quiet 'No supported user package manager found.'
    fi
else
    noun=packages
    ((total != 1)) || noun=package
    progress_finish success "Upgraded $total $noun."
fi
