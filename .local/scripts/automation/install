#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
dotfiles_root=$(cd -P "$script_dir/../../.." && pwd)
platform=$(uname -s)

for required_script in \
    workspace-pull desktop-shortcut-cleanup \
    ../lib/cuberhaus-progress.sh ../lib/xdg-dirs.sh; do
    if [[ ! -r "$script_dir/$required_script" ]]; then
        printf 'Required automation script is missing or unreadable: %s\n' "$script_dir/$required_script" >&2
        exit 1
    fi
done

# Package upgrades are run by hand. Older versions of this script installed weekly jobs that ran
# them (a root timer for apt or pacman, a user timer for Homebrew or yay); remove what is left.
retire_package_maintenance_linux() {
    systemctl --user stop cuberhaus-user-package-maintenance.timer 2>/dev/null || true
    rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/timers.target.wants/cuberhaus-user-package-maintenance.timer"
    if systemctl list-unit-files --no-legend cuberhaus-system-maintenance.timer >/dev/null 2>&1; then
        sudo systemctl disable --now cuberhaus-system-maintenance.timer
        sudo rm -f \
            /etc/systemd/system/cuberhaus-system-maintenance.service \
            /etc/systemd/system/cuberhaus-system-maintenance.timer \
            /usr/local/libexec/cuberhaus-system-maintenance \
            /usr/local/libexec/cuberhaus-progress.sh
        sudo systemctl daemon-reload
    fi
}

install_linux() {
    if grep -qi microsoft /proc/version 2>/dev/null; then
        printf 'WSL detected: Windows Task Scheduler owns these automations; skipping.\n'
        return
    fi
    if ! command -v systemctl >/dev/null 2>&1; then
        printf 'systemd is unavailable; automation installation was skipped.\n' >&2
        return 1
    fi

    for deployed_file in \
        "$HOME/.local/scripts/automation/workspace-pull" \
        "$HOME/.local/scripts/automation/desktop-shortcut-cleanup" \
        "$HOME/.local/scripts/lib/cuberhaus-progress.sh" \
        "$HOME/.local/scripts/lib/xdg-dirs.sh" \
        "$HOME/.config/systemd/user/cuberhaus-workspace-pull.service" \
        "$HOME/.config/systemd/user/cuberhaus-workspace-pull.timer" \
        "$HOME/.config/systemd/user/cuberhaus-desktop-shortcut-cleanup.service" \
        "$HOME/.config/systemd/user/cuberhaus-desktop-shortcut-cleanup.timer"; do
        if [[ ! -r "$deployed_file" ]]; then
            printf 'Required Stow deployment is missing: %s\nRun make restow first.\n' "$deployed_file" >&2
            exit 1
        fi
    done

    retire_package_maintenance_linux
    systemctl --user daemon-reload
    systemctl --user enable --now \
        cuberhaus-workspace-pull.timer \
        cuberhaus-desktop-shortcut-cleanup.timer
}

install_macos() {
    local source_dir target_dir log_dir state_dir uid now
    source_dir="$dotfiles_root/.local/share/cuberhaus-automations/launchd"
    target_dir="$HOME/Library/LaunchAgents"
    log_dir="$HOME/Library/Logs/Cuberhaus"
    state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/cuberhaus-automations"
    uid=$(id -u)
    now=$(date +%s)

    if [[ ! -r "$HOME/.local/scripts/automation/workspace-pull" ]]; then
        printf 'Required Stow deployment is missing: %s\nRun make restow first.\n' "$HOME/.local/scripts/automation/workspace-pull" >&2
        exit 1
    fi

    # Package upgrades are run by hand: remove the weekly Homebrew agent older versions installed.
    launchctl bootout "gui/$uid/com.cuberhaus.user-package-maintenance" 2>/dev/null || true
    rm -f "$target_dir/com.cuberhaus.user-package-maintenance.plist"

    mkdir -p "$target_dir" "$log_dir" "$state_dir"
    [[ -f "$state_dir/workspace-pull.last-success" ]] || printf '%s\n' "$now" > "$state_dir/workspace-pull.last-success"
    for source in "$source_dir"/*.plist; do
        target="$target_dir/$(basename "$source")"
        cp "$source" "$target"
        plutil -lint "$target" >/dev/null
        launchctl bootout "gui/$uid" "$target" 2>/dev/null || true
        launchctl bootstrap "gui/$uid" "$target"
    done
}

case "$platform" in
    Linux) install_linux ;;
    Darwin) install_macos ;;
    *)
        printf 'Unsupported platform: %s\n' "$platform" >&2
        exit 1
        ;;
esac

printf 'Cuberhaus automation schedules are installed.\n'