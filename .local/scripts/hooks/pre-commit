#!/usr/bin/env bash
# Pre-commit hook: lint staged shell scripts with shellcheck.
# Install with: make hooks

set -euo pipefail

if ! command -v shellcheck &>/dev/null; then
    echo "shellcheck not found — skipping pre-commit lint."
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"

# shellcheck source=../lint_helpers.sh
source "$REPO_ROOT/.local/scripts/lint_helpers.sh"

# Intersect staged files with the lintable set
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

lintable=$(lint_get_scripts)

scripts=()
while IFS= read -r f; do
    # Only lint if the staged file is in the lintable set
    if echo "$lintable" | grep -qxF "$f"; then
        scripts+=("$f")
    fi
done <<< "$staged"

if [ ${#scripts[@]} -eq 0 ]; then
    exit 0
fi

if ! shellcheck "${scripts[@]}"; then
    echo ""
    echo "shellcheck failed. Fix the issues or commit with --no-verify to skip."
    exit 1
fi
